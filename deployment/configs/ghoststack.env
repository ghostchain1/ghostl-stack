# ============================================================
# GhostStack Master Deployment Blueprint — Environment Config
# ============================================================
# Copy this file or source it before running deploy.sh.
# All secrets default to empty — fill in before production use.
# ============================================================

# ── Paths ────────────────────────────────────────────────────
GHOSTSTACK_ROOT=/home/ghost/ghostl-stack
GHOSTSTACK_SERVICES=/home/ghost/ghostl-stack/services
GHOSTBRAIN_SRC=/home/ghost/hyperghost-tooling/hyper-ghost-ai/services

# ── General ──────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ── Chain IDs ────────────────────────────────────────────────
GHOSTCHAIN_L1_CHAIN_ID=1337
GHOSTCHAIN_L2_CHAIN_ID=1338
GHOSTCHAIN_L3_CHAIN_ID=1339

# ── Chain RPC URLs ───────────────────────────────────────────
GHOSTCHAIN_RPC=http://ghostchain-validator-1:8545
GHOSTCHAIN_WS=ws://ghostchain-validator-1:8546
GHOSTL2_RPC=http://localhost:9545
GHOSTL3_RPC=http://localhost:9645

# ── GhostBrain Ports ─────────────────────────────────────────
GHOSTBRAIN_SWARM_PORT=9000
GHOSTBRAIN_NS_PORT=9100
GHOSTBRAIN_MS_PORT=9200
GHOSTBRAIN_KERNEL_PORT=9300
GHOSTBRAIN_IPC_PORT=9400
GHOSTBRAIN_CP_PORT=9500
GHOSTBRAIN_DIAG_PORT=9600
GHOSTBRAIN_VF_PORT=9700
GHOSTBRAIN_EE_PORT=9800
GHOSTBRAIN_GDM_PORT=9900

# ── AI Engine Ports ──────────────────────────────────────────
AIMS_PORT=9970
VGE_PORT=9971
AAE_PORT=9972
GEE_PORT=9973
AEE_PORT=9974
AIE_PORT=9975
ASE_PORT=9976
GIE_PORT=9977
AGE_PORT=9978
GIEX_PORT=9979
GAAN_PORT=9980
ADE_PORT=9982
SEE_PORT=9983
PNE_PORT=9984
INE_PORT=9985

# ── Monitoring Ports ─────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100

# ── Control Center ───────────────────────────────────────────
CONTROL_CENTER_PORT=3000

# ── GhostBrain Internal URLs (used by AI engines) ────────────
GHOST_ECONOMY_URL=http://ghostbrain-economy-engine:9800
GIN_URL=http://ghostbrain-intelligence:9980

# ── Database ─────────────────────────────────────────────────
POSTGRES_DB=ghoststack
POSTGRES_USER=ghost
POSTGRES_PASSWORD=ghoststack_db_password
POSTGRES_PORT=5432

REDIS_PORT=6379
ELASTICSEARCH_PORT=9200

# ── Monitoring Security ──────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ghoststack_grafana_password
PROMETHEUS_RETENTION=15d

# ── AI / LLM Keys ────────────────────────────────────────────
OPENAI_API_KEY=

# ── Social API Keys ──────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
YOUTUBE_API_KEY=
TIKTOK_ACCESS_TOKEN=
GITHUB_TOKEN=

# ── AI Infrastructure Feature Flags ──────────────────────────
AIE_DOCKER_REPAIR=false
AIE_REPAIR_ENABLED=false
AIE_SCALING_ENABLED=false
AIE_ENABLE_VIRSH=false
ASE_ENABLE_IPTABLES=false

# ── Health-wait tuning ───────────────────────────────────────
# How long (seconds) to wait for each layer to become healthy
WAIT_DATA_MESH=20
WAIT_GHOSTBRAIN=30
WAIT_VALIDATORS=20
WAIT_MONITORING=15
WAIT_AI_ENGINES=30

{
  "name": "ghostl-stack-monorepo",
  "private": true,
  "version": "0.0.1",
  "workspaces": ["apps/api", "apps/web", "apps/worker", "packages/*"],
  "scripts": {
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "lint": "eslint apps packages --ext .ts,.tsx",
    "preflight:opstack": "bash infra/scripts/opstack/preflight-3layer.sh infra/opstack/.env infra/opstack/.env.l3",
    "env:sync:opstack": "bash infra/scripts/opstack/sync-env-from-l1-deployments.sh infra/opstack/.env",
    "env:sync:opstack:l3": "bash infra/scripts/opstack/sync-env-from-l2-deployments.sh infra/opstack/.env.l3",
    "opstack:check": "npm run env:sync:opstack && npm run env:sync:opstack:l3 && npm run preflight:opstack"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.3",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}

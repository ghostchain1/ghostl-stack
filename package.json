{
  "name": "ghostl-stack-monorepo",
  "private": true,
  "version": "0.0.1",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/worker",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/node-check.mjs && node scripts/package-manager-check.mjs",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "start:api:prod": "npm run start:prod -w apps/api",
    "start:worker:prod": "npm run start:prod -w apps/worker",
    "start:apps:prod": "bash scripts/start-apps-prod.sh",
    "start:stack:prod": "bash scripts/start-stack-prod.sh",
    "smoke:stack:prod": "bash scripts/smoke-stack-prod.sh",
    "verify:prod": "bash scripts/verify-prod.sh",
    "compile:docker": "npm --prefix contracts run compile:docker",
    "compile:docker:verbose": "npm --prefix contracts run compile:docker:verbose",
    "compile:docker:clean": "npm --prefix contracts run compile:docker:clean",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build:services": "./scripts/build-services-sequential.sh services/docker-compose.yml",
    "configure:build:ready": "bash infra/scripts/production/configure-build-ready.sh --mode=production --secrets=vault",
    "configure:build:ready:op-only": "bash infra/scripts/production/configure-build-ready.sh --mode=production --secrets=vault --allow-finality-fallback",
    "configure:build:staging": "bash infra/scripts/production/configure-build-ready.sh --mode=staging --secrets=vault",
    "configure:build:dev": "bash infra/scripts/production/configure-build-ready.sh --mode=dev --secrets=dev",
    "security:production:preflight": "bash scripts/security/secure-production-build.sh",
    "security:production:build": "bash scripts/security/secure-production-build.sh --execute",
    "security:vault:prepare": "bash scripts/security/prepare-vault-auth.sh --write-example",
    "security:vault:check": "bash scripts/security/check-vault-auth.sh",
    "security:compose:audit": "bash scripts/security/compose-hardening-audit.sh",
    "security:secret:scan": "bash scripts/security/secret-scan.sh",
    "security:deps": "node scripts/check-deprecations.mjs",
    "deprecations:check": "node scripts/check-deprecations.mjs",
    "lint": "eslint apps packages --ext .ts,.tsx",
    "tooling:check": "npm run node:check && node scripts/package-manager-check.mjs",
    "node:check": "node scripts/node-check.mjs",
    "gst:leakage": "bash scripts/gst-leakage-gate.sh",
    "gst:symbol": "bash scripts/gst-symbol-gate.sh",
    "bots:smoke": "bash scripts/ghost-bots-smoke.sh",
    "preflight:opstack": "bash infra/scripts/opstack/preflight-3layer.sh infra/opstack/.env infra/opstack/.env.l3",
    "env:sync:opstack": "bash infra/scripts/opstack/sync-env-from-l1-deployments.sh infra/opstack/.env",
    "env:sync:opstack:l3": "bash infra/scripts/opstack/sync-env-from-l2-deployments.sh infra/opstack/.env.l3",
    "env:sync:l2": "bash infra/scripts/env-sync-l2.sh",
    "env:sync:l1": "bash infra/scripts/env-sync-l1.sh",
    "opstack:check": "npm run env:sync:opstack && npm run env:sync:opstack:l3 && npm run preflight:opstack",
    "phase2:formal": "npm --prefix contracts run formal:slither && npm --prefix contracts run formal:scribble && npm --prefix contracts run formal:echidna && npm --prefix contracts run test:invariant",
    "phase2:preflight": "DEPRECATIONS_CMD_TIMEOUT_MS=60000 DEPRECATIONS_SKIP_FILE_SCAN=1 npm run deprecations:check && NODE_OPTIONS=--max_old_space_size=4096 HARDHAT_VIA_IR=true HARDHAT_USE_DOCKER_SOLC=1 npm --prefix contracts run build && bash scripts/pil/smoke-phase2.sh",
    "ghostdns:smoke": "bash scripts/smoke/ghostdns.sh",
    "smoke:kong:auth": "bash scripts/smoke/kong-realm-auth.sh",
    "smoke:web:realm-login": "bash scripts/smoke/web-realm-login.sh",
    "e2e:smoke": "bash scripts/e2e/sso-gateway-smoke.sh",
    "e2e": "npm run e2e:smoke",
    "compose:validate:bundles": "bash scripts/validate/compose-bundles.sh",
    "test:routing-law": "npm --prefix packages/routing-law test",
    "ghostload:test": "npm --prefix packages/ghostload-policy test && npm --prefix services/ghostload-ai test && npm --prefix services/ghostload-controller test && npm --prefix tools/ghostload-sim test",
    "ghostload:sim": "node tools/ghostload-sim/src/cli.js --scenario=l1-fee-spike",
    "ghostload:sim:spam": "node tools/ghostload-sim/src/cli.js --scenario=spam-attack",
    "sovereign:test": "npm --prefix services/l3-fee-collector test && npm --prefix services/l2-revenue-aggregator test && npm --prefix services/treasury-engine test && npm --prefix services/reward-distributor test && npm --prefix services/hyper-ghost-governor test && npm --prefix contracts run test:sovereign",
    "governor:test": "npm --prefix services/hyper-ghost-governor test",
    "sovereign:audit": "npm --prefix contracts run slither:sovereign && npm --prefix contracts run gas:sovereign",
    "sovereign:smoke": "bash scripts/smoke/sovereign-economy.sh",
    "release:manifest": "bash scripts/release/build-release-manifest.sh",
    "release:sign": "bash scripts/release/sign-release-manifest.sh",
    "release:verify-attestation": "bash scripts/release/verify-release-attestation.sh",
    "release:push:ghostdns:ghcr": "bash scripts/release/push-ghcr-ghostdns.sh",
    "verify:routing": "bash scripts/verify-routing.sh",
    "verify:governance": "bash scripts/verify-governance.sh --proposal-id EXAMPLE-0001",
    "verify:release-gate": "bash scripts/verify-release-gate.sh --proposal-id EXAMPLE-0001",
    "econ:test:contracts": "cd contracts && forge test --match-path test/foundry/GhostEconomicRouting.t.sol && forge test --match-path test/foundry/GhostEconomicGovernanceRisk.t.sol && forge test --match-path test/foundry/GhostEconomicFlywheel.t.sol",
    "econ:simulate": "bash scripts/simulate-flywheel.sh",
    "econ:routing-law": "bash scripts/econ/verify-routing-law.sh",
    "econ:governance-gate": "bash scripts/econ/verify-governance-gate.sh",
    "econ:no-secrets": "bash scripts/econ/no-secrets-scan.sh",
    "econ:up:devnet": "docker compose -f docker-compose.econ.devnet.yml up -d --build",
    "econ:up:testnet": "docker compose -f docker-compose.econ.testnet.yml up -d --build",
    "governance:constitution-proposal": "node --experimental-strip-types tools/governance/create-constitution-proposal.ts --proposal-id EXAMPLE-0001 --release-id local-release --release-gate 0x0000000000000000000000000000000000000001",
    "ghostctl": "bash tools/ghostctl",
    "test:sovereign-policy": "node --test tests/security/sovereign-regression.test.mjs",
    "security:policy-gate": "npm run test:sovereign-policy && bash scripts/security/compose-hardening-audit.sh && bash scripts/verify-routing.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "hardhat": "^3.1.10",
    "next": "16.1.6",
    "prettier": "^3.8.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "ghost": "*",
    "nodemailer": "8.0.1"
  },
  "engines": {
    "node": ">=22.21.0 <23"
  },
  "overrides": {
    "@auth/core": "^0.41.1",
    "ajv": "6.14.0",
    "bn.js": "4.12.3",
    "cookie": "0.7.2",
    "minimatch": "10.2.3",
    "qs": "6.15.0",
    "systeminformation": "5.30.8",
    "basic-ftp": "5.2.0",
    "diff": "^8.0.3",
    "fast-xml-parser": "^5.3.4",
    "@aws-sdk/xml-builder": {
      "fast-xml-parser": "5.3.4"
    },
    "ts-node": {
      "diff": "^8.0.3"
    }
  }
}

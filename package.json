{
  "name": "ghostl-stack",
  "version": "1.0.0",
  "description": "GhostStack monorepo — GhostChain protocol services, contracts, and AI infrastructure",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/ghost-api",
    "services/ghost-explorer",
    "services/ghost-indexer",
    "services/ghost-runtime",
    "services/ghost-compliance",
    "services/ghostbrain-core",
    "services/ghostbrain-agents",
    "services/ghostbrain-economy",
    "services/ghostbrain-evolution",
    "services/ghostbrain-memory",
    "services/ghostbrain-network",
    "services/ghostbrain-simulator",
    "services/ghostcode-ai",
    "services/governance-event-bridge"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "find . -name 'dist' -not -path '*/node_modules/*' -exec rm -rf {} + 2>/dev/null; true"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "hardhat": "^2.22.5",
    "mocha": "^11.7.5",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "undici": "^6.24.0",
    "hardhat": {
      "undici": "^6.24.0"
    },
    "serialize-javascript": "^7.0.3",
    "mocha": {
      "serialize-javascript": "^7.0.3"
    },
    "cookie": "^0.7.0"
  }
}

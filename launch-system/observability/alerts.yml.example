groups:
  - name: ghoststack-basic
    rules:
      - alert: NodeDown
        expr: up == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Target down"
          description: "Prometheus target is down for >2m"

      - alert: DiskSpaceLow
        expr: (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}) < 0.10
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Disk space low"
          description: "Less than 10% disk available"

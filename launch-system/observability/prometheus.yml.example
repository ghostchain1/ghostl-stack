global:
  scrape_interval: 10s

scrape_configs:
  - job_name: "node"
    static_configs:
      - targets: ["127.0.0.1:9100"]
        labels:
          environment: "REPLACE_ENV"
          vm: "REPLACE_VM"

  - job_name: "cadvisor"
    static_configs:
      - targets: ["127.0.0.1:8080"]
        labels:
          environment: "REPLACE_ENV"
          vm: "REPLACE_VM"

  # GhostChain L1 geth metrics (example)
  - job_name: "ghostchain_l1"
    metrics_path: /debug/metrics
    static_configs:
      - targets: ["127.0.0.1:18660"]
        labels:
          environment: "REPLACE_ENV"
          layer: "l1"
          vm: "REPLACE_VM"

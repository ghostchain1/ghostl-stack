ops/zk/build/
ops/zk/Verifier.sol
ops/quorum/quorum-attestation.json
ops/quorum/regions/*.json
*.swp
*.swo
*.tmp
*.bak
*~

# local shell env
.envrc
.direnv/

# package manager caches
.pnpm-store/


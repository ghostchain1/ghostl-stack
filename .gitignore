.turbo/
**/.turbo/
.parcel-cache/
**/.parcel-cache/
.vite/
**/.vite/
.eslintcache
.stylelintcache
.cache/
**/.cache/

# common JS tool logs/cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# ops snapshots + attestations (generated by ghostctl)
ops/docker/snapshots/*
!ops/docker/snapshots/.gitkeep
!ops/docker/snapshots/README.md
ops/docker/attestations/*
!ops/docker/attestations/.gitkeep
!ops/docker/attestations/README.md

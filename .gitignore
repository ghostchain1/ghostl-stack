.DS_Store
.vscode/
.idea/

# dependencies
**/node_modules/

# local-only env variants
.env.local
.env.*.local
/.env
**/.env
**/.env.local
**/.env.*.local
.env.*
**/.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
# compliance local env
services/ghost-compliance/.env
services/ghost-compliance-worker/.env
apps/ghost-ui/.env
infra/opstack/.env
infra/opstack/.env.local
infra/opstack/.env.secrets
infra/opstack/.env.*.local
services/stack.env
services/.env

# generated by contracts build/deploy
contracts/artifacts/
contracts/cache/
contracts/typechain-types/

# avoid committing build caches and forge artifacts
cache/
out/

# generated at runtime by deploy script
services/ghost-guard/.env
services/ghost-relayer/.env
services/ghost-rollup-proposer/.env.l2
services/ghost-rollup-proposer/.env.l3
services/ghost-rollup-challenger/.env.l2
services/ghost-rollup-challenger/.env.l3

# local scratch
.tmp/
.gomodcache/

# forge broadcast artifacts
infra/opstack/broadcast/

# polygon-edge chain data (generated)
chains/**/data/

# local infra node data (permission restricted)
infra/opstack/l3/ghostsample/data/
infra/opstack/data/l2-geth/
infra/opstack/data/l1-geth/
infra/opstack/data/l2-geth-new/
infra/opstack/data/l2-geth-new2/
infra/opstack/data/l1-geth-new/
infra/opstack/data/op-node/
infra/opstack/data/op-sequencer/
infra/opstack/data/guard/
infra/opstack/l3/ghostl3/data/
/infra/opstack/optimism/
infra/opstack/infra/opstack/optimism/
apps/api/data/
apps/api/.sessions/
infra/ghostchain/data/
infra/ghostchain/logs/
infra/ghostchain/config/bootnode-enode.txt
infra/ghostchain/ghostl2/data/
infra/ghostchain/**/logs/
infra/ghostchain/**/geth/

# runtime state snapshots
services/data/state.json
services/**/data/

# build artifacts
apps/web/.next/
**/.next/
dist/
**/dist/

.git/gc.log

# logs
*.log
logs/
**/logs/

# coverage
coverage/
**/coverage/
.nyc_output/


  end

  subgraph Services["Control Plane / Services"]
    Guard[AI/Guard/Telemetry services]
    Relayer[Relayers + Compliance services]
    Explorer[GhostScout explorers]
  end

  subgraph Observability["Observability"]
    Prom[Prometheus]
    Grafana[Grafana]
  end


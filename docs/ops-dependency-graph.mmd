    L1Geth[(geth node1)]
  end

  subgraph L2["GhostL2 OP Stack"]
    L2Geth[(op-geth)]
    L2Node[op-node]
    L2Batcher[op-batcher]
    L2Proposer[op-proposer]
    Gate[op-gate JSON-RPC proxy]
  end

  subgraph L3["GhostL3 OP Stack"]
    L3Geth[(l3-op-geth)]
    L3Node[l3-op-node]
    L3Batcher[l3-op-batcher]

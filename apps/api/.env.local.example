PORT=4000

# Core observability (matches infra/opstack/docker-compose.yml ports)
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY= # required only if you list dashboards from the API

# Guard / relayer wiring
GUARD_URL=http://localhost:7070
GUARD_ADMIN_TOKEN=
RELAYER_URL=http://localhost:7171

# RPC exposed by the local op-geth instance
RPC_L2=http://localhost:29545

# Optional upstream microservices (leave as-is to serve mock data)
BRIDGE_SERVICE_URL=http://localhost:7604
TRANSFER_SERVICE_URL=http://localhost:7605
LIQUIDITY_SERVICE_URL=http://localhost:7606
CONTRACT_REGISTRY_URL=http://localhost:7608
CONTRACT_RISK_URL=http://localhost:7609
SUPPLY_SERVICE_URL=http://localhost:7614
FEE_MODEL_SERVICE_URL=http://localhost:7615
TREASURY_SERVICE_URL=http://localhost:7628
PAYOUT_SERVICE_URL=http://localhost:7629
GOVERNANCE_SERVICE_URL=http://localhost:7645
VALIDATOR_SERVICE_URL=http://localhost:7607
DEVOPS_SERVICE_URL=http://localhost:7623
RPC_SERVICE_URL=http://localhost:7650
USAGE_SERVICE_URL=http://localhost:7651
WEBHOOKS_SERVICE_URL=http://localhost:7652
AI_SERVICE_URL=http://localhost:7660
SWAP_SERVICE_URL=http://localhost:7670

# Optional log/alert backends (enabled locally via docker-compose)
LOKI_URL=http://localhost:3100
ALERTMANAGER_URL=http://localhost:9093

    "lint": "next lint"
  },
  "dependencies": {
    "@ghostchain/ui-components": "*",
    "next": "16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "next-mdx-remote": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "typescript": "6.0.3"
  },
  "engines": { "node": ">=22.21.0 <23" }
}

{
  "name": "@ghostchain/web-docs",
  "version": "0.1.0",
  "private": true,
  "description": "GhostChain documentation portal — docs.ghostchain.cloud plus ghostchain.info and ghostchain.online",
  "scripts": {
    "dev": "PORT=${PORT:-3016} next dev",
    "build": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 NEXT_DISABLE_ESLINT=1 next build",
    "start": "next start -p ${PORT:-3016}",
    "lint": "next lint"
  },
  "dependencies": {
    "@ghostchain/ui-components": "*",
    "next": "16.2.1",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=22.21.0 <23"
  }
}

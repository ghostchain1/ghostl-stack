# LitVybzLive — Environment Variables
# Copy to .env.dev / .env.staging / .env.prod and fill in secrets.
#
# Usage:
#   cp devops/.env.example devops/.env.dev
#   bash devops/scripts/deploy.sh dev

# ── Required secrets (no defaults — deploy fails without these) ───────────────
LITVYB_JWT_SECRET=CHANGE_ME_UNIQUE_RANDOM_STRING
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ── GhostChain L3 (chain_id=903, GST gas token) ───────────────────────────────
GHOST_L3_RPC=http://host.docker.internal:7270
GHOST_L3_CHAIN_ID=903
GHOSTBRAIN_URL=http://host.docker.internal:7900

# ── Network / Hosting ─────────────────────────────────────────────────────────
# Public IP of this host — required for WebRTC ICE (mediasoup ANNOUNCED_IP)
PUBLIC_IP=127.0.0.1
EU_WEST_IP=127.0.0.1
ASIA_IP=127.0.0.1

# ── App Configuration ─────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=litvyb

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_MAX_MEMORY=512mb

# ── Registry (for K8s deployments) ────────────────────────────────────────────
REGISTRY=ghcr.io/ghostchain
IMAGE_TAG=latest

# ── Feature Flags ─────────────────────────────────────────────────────────────
RECORD_ALL=false

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_URL=http://localhost:3100

# ── Streaming ─────────────────────────────────────────────────────────────────
MEDIASOUP_NODE_ID=ms-core-1
REGION=default

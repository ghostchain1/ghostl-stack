# LitVybzLive — Streaming Service Dockerfile
# Used for: mediasoup-server, webrtc-gateway, stream-controller,
#           edge-nodes, ffmpeg-transcoder, redis-bus
#
# mediasoup requires native C++ build (python3, make, g++, linux-headers)
# ffmpeg-transcoder requires ffmpeg binary
#
# Build context: apps/litvyblive/streaming/{service-name}/
# Example:
#   docker build -f devops/docker/Dockerfile.stream \
#     --build-arg PORT=3000 \
#     --build-arg INSTALL_FFMPEG=false \
#     apps/litvyblive/streaming/mediasoup-server

ARG NODE_VERSION=22-alpine
ARG INSTALL_FFMPEG=false

FROM node:${NODE_VERSION} AS builder

# Always install native build tools (needed by mediasoup)
RUN apk add --no-cache python3 make g++ linux-headers

WORKDIR /app

COPY package.json ./
RUN npm install

COPY tsconfig.json ./
COPY src/ ./src/

RUN npm run build

# ── Runtime image ─────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}

ARG INSTALL_FFMPEG=false

# Native deps required at runtime for mediasoup
RUN apk add --no-cache python3 make g++ linux-headers

# Optional ffmpeg for transcoder service
RUN if [ "$INSTALL_FFMPEG" = "true" ]; then apk add --no-cache ffmpeg; fi

WORKDIR /app

COPY package.json ./
RUN npm install --omit=dev

COPY --from=builder /app/dist ./dist

# Storage directories
RUN mkdir -p /data /recordings /hls

ARG PORT=3000
ENV PORT=${PORT}

EXPOSE ${PORT}

# Note: WebRTC edge/core services need host networking for UDP RTP ports
# This is set in docker-compose / Kubernetes — not in Dockerfile

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:${PORT}/health || exit 1

CMD ["node", "dist/index.js"]

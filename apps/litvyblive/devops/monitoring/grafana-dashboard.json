{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "LitVybzLive Prometheus datasource",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "10.0.0" },
    { "type": "panel",      "id": "gauge",      "name": "Gauge",      "version": "" },
    { "type": "panel",      "id": "graph",      "name": "Graph",      "version": "" },
    { "type": "panel",      "id": "stat",       "name": "Stat",       "version": "" },
    { "type": "panel",      "id": "table",      "name": "Table",      "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "LitVybzLive Platform — streaming, backend, blockchain, and infrastructure metrics",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Live Streaming",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1000 },
            { "color": "red",    "value": 5000 }
          ]}
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["last"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "pluginVersion": "10.4.2",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(litvyblive_active_viewers_total)",
        "legendFormat": "Active Viewers"
      }],
      "title": "Active Viewers",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null },
        { "color": "yellow", "value": 100 },
        { "color": "red",    "value": 500 }
      ]}}, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["last"] }, "colorMode": "background", "orientation": "auto", "textMode": "auto" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(litvyblive_active_streams_total)",
        "legendFormat": "Live Streams"
      }],
      "title": "Live Streams",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 1 },
      "id": 4,
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(litvyblive_messages_total{job=\"litvyblive-streaming\"}[5m])",
          "legendFormat": "{{instance}} messages/s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(litvyblive_webrtc_connections_total[5m])",
          "legendFormat": "WebRTC connections/s"
        }
      ],
      "title": "Streaming Traffic",
      "type": "graph"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 6 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["last"] }, "colorMode": "background", "orientation": "auto" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(rate(litvyblive_gifts_sent_total[5m])) * 60",
        "legendFormat": "Gifts/min"
      }],
      "title": "Gifts per Minute",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "currencyGST" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 6 },
      "id": 6,
      "options": { "reduceOptions": { "calcs": ["last"] }, "colorMode": "value", "orientation": "auto" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(litvyblive_gst_volume_total)",
        "legendFormat": "Total GST Volume"
      }],
      "title": "GST Volume (Total)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 10,
      "title": "Backend Service Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 11,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_ms_bucket{job=\"litvyblive-backend\"}[5m])) by (le, instance))",
        "legendFormat": "{{instance}} p95"
      }],
      "title": "HTTP Latency p95 — Backend Services",
      "type": "graph"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 12,
      "options": { "legend": { "calcs": ["last"], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(rate(http_requests_total{job=\"litvyblive-backend\"}[5m])) by (instance)",
        "legendFormat": "{{instance}} req/s"
      }],
      "title": "HTTP Request Rate — Backend Services",
      "type": "graph"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 20,
      "title": "GhostChain L3 — Blockchain",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [
        { "color": "red",    "value": null },
        { "color": "green",  "value": 1 }
      ]}}, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 19 },
      "id": 21,
      "options": { "reduceOptions": { "calcs": ["last"] }, "colorMode": "background" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "up{job=\"ghostchain-l3\"}",
        "legendFormat": "L3 RPC"
      }],
      "title": "GhostL3 Node Up",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 19 },
      "id": 22,
      "options": { "reduceOptions": { "calcs": ["last"] }, "colorMode": "value" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "litvyblive_l3_transactions_total",
        "legendFormat": "L3 Txns"
      }],
      "title": "GhostL3 Transactions",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 19 },
      "id": 23,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "rate(litvyblive_wallet_transactions_total[5m])",
        "legendFormat": "Wallet Txns/s"
      }],
      "title": "Wallet Transaction Throughput",
      "type": "graph"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 30,
      "title": "Infrastructure — CPU / Memory / Redis",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green",  "value": null },
        { "color": "yellow", "value": 0.7 },
        { "color": "red",    "value": 0.9 }
      ]}}, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 28 },
      "id": 31,
      "options": { "reduceOptions": { "calcs": ["last"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
        "legendFormat": "CPU Usage"
      }],
      "title": "Host CPU Usage",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green",  "value": null },
        { "color": "yellow", "value": 0.75 },
        { "color": "red",    "value": 0.9 }
      ]}}, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 28 },
      "id": 32,
      "options": { "reduceOptions": { "calcs": ["last"] }, "orientation": "auto" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
        "legendFormat": "Memory Usage"
      }],
      "title": "Host Memory Usage",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 28 },
      "id": 33,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "redis_connected_clients",
          "legendFormat": "Connected Clients"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(redis_commands_processed_total[5m])",
          "legendFormat": "Commands/s"
        }
      ],
      "title": "Redis — Clients & Commands",
      "type": "graph"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 40,
      "title": "Fraud & Compliance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green",  "value": null },
        { "color": "yellow", "value": 10 },
        { "color": "red",    "value": 50 }
      ]}}, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 35 },
      "id": 41,
      "options": { "reduceOptions": { "calcs": ["last"] }, "colorMode": "background" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "increase(litvyblive_fraud_flags_total[5m])",
        "legendFormat": "Fraud Flags/5m"
      }],
      "title": "Fraud Flags (5 min)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 35 },
      "id": 42,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(litvyblive_fraud_flags_total[5m])",
          "legendFormat": "Fraud rate/s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(litvyblive_bot_detections_total[5m])",
          "legendFormat": "Bot detections/s"
        }
      ],
      "title": "Fraud & Bot Detection Rates",
      "type": "graph"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["litvyblive", "ghostchain", "l3", "streaming"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "LitVybzLive Platform",
  "uid": "litvyblive-main",
  "version": 1
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*",
    "../payments/**/*",
    "../security/**/*",
    "../infrastructure/**/*",
    "../marketing/**/*",
    "../identity/**/*",
    "../launchpad/**/*",
    "../economy/**/*",
    "../multiverse/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}

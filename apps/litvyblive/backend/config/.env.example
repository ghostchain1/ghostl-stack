# LitVybzLive Backend — Environment Configuration
# Copy this file to .env in the same directory, then populate secrets.
# Usage:  cp backend/config/.env.example backend/config/.env
#
# All platform transactions settle on GhostL3 (chain_id=903, RPC :7270).
# Gas token: GST — never ETH, Ether, or WETH.

# ══════════════════════════════════════════════════════════════════════════════
# GhostChain RPC endpoints
# ══════════════════════════════════════════════════════════════════════════════

# GhostL3 (chain 903) — all user-facing transactions
GHOST_L3_RPC=http://localhost:7270
GHOST_L3_CHAIN_ID=903

# GhostL2 (chain 901) — settlement relay only
GHOST_L2_RPC=http://localhost:7260
GHOST_L2_CHAIN_ID=901

# GhostChain L1 (chain 14000101) — final settlement, GNS resolution
GHOST_L1_RPC=http://localhost:18545
GHOST_L1_CHAIN_ID=14000101

# ══════════════════════════════════════════════════════════════════════════════
# Security
# ══════════════════════════════════════════════════════════════════════════════

# Required — shared JWT secret for all microservices
LITVYB_JWT_SECRET=change-me-in-production-minimum-32-chars

# JWT expiry
JWT_EXPIRES_IN=7d

# CORS — comma-separated allowed origins (* = all, unsafe for prod)
CORS_ORIGIN=*

# ══════════════════════════════════════════════════════════════════════════════
# Data Layer
# ══════════════════════════════════════════════════════════════════════════════

# Redis for real-time caching and pub/sub
REDIS_URL=redis://localhost:6390

# Persistent data directory (mounted as volumes in docker-compose)
DATA_DIR=./data

# ══════════════════════════════════════════════════════════════════════════════
# GhostBrain AI Core (port 7900)
# ══════════════════════════════════════════════════════════════════════════════

GHOSTBRAIN_URL=http://localhost:7900

# ══════════════════════════════════════════════════════════════════════════════
# Service ports
# ══════════════════════════════════════════════════════════════════════════════

# API Gateway — public entrypoint for mobile app
PORT_API_GATEWAY=7001

# Core microservices
PORT_AUTH=7010
PORT_USER=7011
PORT_STREAM=7012
PORT_CHAT=7013
PORT_GIFT=7014
PORT_WALLET=7015
PORT_AGENCY=7016
PORT_MATCHMAKING=7017
PORT_GAMES=7018
PORT_RANKING=7019
PORT_EVENT=7020
PORT_LAUNCHPAD=7021
PORT_TREASURY=7022
PORT_MARKETING=7023
PORT_FRAUD=7024
PORT_ANALYTICS=7025
PORT_NOTIFICATION=7026

# ══════════════════════════════════════════════════════════════════════════════
# Canonical L3 contract addresses (governance-locked — do not change)
# ══════════════════════════════════════════════════════════════════════════════

GIFT_ENGINE_ADDRESS=0x0000000000000000000000000000000000000000
NFT_GIFT_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
CREATOR_TOKEN_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
CREATOR_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
AGENCY_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Canonical bridge / oracle addresses (from GhostChain governance)
L2L3_BRIDGE_ADDRESS=0xDadd1125B8Df98A66Abd5EB302C0d9Ca5A061dC2
L1_ROLLUP_ADDRESS=0xad32D5C2Da9f4159C4cc98686C005852b3905355
L2_ROLLUP_ADDRESS=0x130A46b6E41DB6E1e18fb9c759F223c459190e90
FINALITY_ORACLE_L3_ADDRESS=0x87F850cbC2cFfac086F20d0d7307E12d06fA2127

# ══════════════════════════════════════════════════════════════════════════════
# Push notifications (Firebase)
# ══════════════════════════════════════════════════════════════════════════════

# Firebase service account JSON (base64-encoded) for FCM / GhostBrain alerts
FIREBASE_CREDENTIALS_B64=

# ══════════════════════════════════════════════════════════════════════════════
# Economy service (apps/litvyblive/economy)
# ══════════════════════════════════════════════════════════════════════════════

# Internal URL for the treasury engine when called by economy services
TREASURY_ENGINE_URL=http://localhost:7022

# ══════════════════════════════════════════════════════════════════════════════
# Dashboard (apps/litvyblive/dashboard)
# ══════════════════════════════════════════════════════════════════════════════

# Backend API base URL (used by Next.js dashboard)
NEXT_PUBLIC_API_BASE=http://localhost:7001

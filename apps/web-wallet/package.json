    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3"
  },
  "engines": { "node": ">=22.21.0 <23" }

# Ghost X Web – environment configuration (prefix NEXT_PUBLIC_ for client-side)
NEXT_PUBLIC_GHOSTX_API_URL=http://localhost:4100
NEXT_PUBLIC_GHOSTX_WS_URL=ws://localhost:4100

# Default trading pair token addresses on GhostChain L2
NEXT_PUBLIC_DEFAULT_BASE=0x0000000000000000000000000000000000000001
NEXT_PUBLIC_DEFAULT_QUOTE=0x0000000000000000000000000000000000000002

# Server-side proxy target (used by next.config.js rewrites)
GHOSTX_API_URL=http://ghostx-api:4100

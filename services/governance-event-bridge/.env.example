# ── governance-event-bridge — example environment ──────────────────────────────
# Copy this file to .env and fill in real values before running locally.
# In Docker / docker-compose the variables are injected via the service definition.

# JSON-RPC endpoints for each layer to poll for governance events.
# Leave a GOVERNOR_ADDRESS blank to skip polling that layer.
RPC_L1=http://localhost:18545
RPC_L2=http://localhost:7260

# On-chain GovernorUpgradeable contract addresses (checksummed or lower-case).
# If empty, the corresponding layer is skipped entirely.
GOVERNOR_ADDRESS_L1=
GOVERNOR_ADDRESS_L2=

# GhostBrain Core signal endpoint (must include /api/v1/signals path prefix base).
GHOSTBRAIN_URL=http://localhost:7700

# Shared HMAC-SHA256 secret used to sign signal payloads.
# Must match CONTROL_PLANE_HMAC_SECRET in ghostbrain-core.
CONTROL_PLANE_HMAC_SECRET=change-me-before-deploying

# Polling interval in milliseconds (default: 6 000 ms = 6 s).
POLL_INTERVAL_MS=6000

# Maximum block range requested per eth_getLogs call.
# Reduce if the RPC node imposes stricter limits.
LOG_BLOCK_RANGE=500

# Path where the bridge persists its last-processed-block state (JSON file).
# Must be writable; mount a persistent volume at this path in production.
STATE_FILE=/var/lib/governance-event-bridge/state.json

# Block from which polling starts on first run (0 = chain genesis).
# Set to the block your governor contract was deployed to skip historical noise.
START_BLOCK_L1=0
START_BLOCK_L2=0

# Log verbosity: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

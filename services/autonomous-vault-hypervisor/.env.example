PORT=7720

# ── GhostBrain / NATS ──────────────────────────────────────────────────────
NATS_URL=nats://nats:4222
GHOSTBRAIN_URL=http://ghostbrain-core:7900
GHOSTBRAIN_ENABLED=1

# ── Vault / ai-vault ─────────────────────────────────────────────────────────
# Point to ai-vault proxy (preferred) or direct Vault
AI_VAULT_ADDR=http://ai-vault:7710
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_NAMESPACE=

# ── Secret Rotation ───────────────────────────────────────────────────────────
ROTATE_ENABLED=1
ROTATE_INTERVAL_MS=900000

# ── Hypervisor SSH ────────────────────────────────────────────────────────────
# Leave blank to run virsh commands locally (when libvirt socket is mounted)
HYPERVISOR_HOST=
HYPERVISOR_USER=ghost
HYPERVISOR_SSH_PORT=22
HYPERVISOR_SSH_KEY_PATH=
SSH_ENABLED=1

# ── Docker ────────────────────────────────────────────────────────────────────
DOCKER_ENABLED=1
# Docker socket path (mounted from host). Use DOCKER_HOST for remote/TCP.
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_HOST=

# ── Reconciler ────────────────────────────────────────────────────────────────
RECONCILE_INTERVAL_MS=60000
REMEDIATE_ENABLED=1
MAX_REMEDIATIONS_PER_RUN=3
MAX_CONTAINER_RESTARTS=5
RESTART_COOLDOWN_MS=120000

# ── Policy ────────────────────────────────────────────────────────────────────
POLICY_PATH=/app/policy.json
EXECUTE_ACTIONS=1
EMERGENCY_LOCK=0

# ── Security ─────────────────────────────────────────────────────────────────
HMAC_SECRET=change-me-in-production
REQUIRE_SIGNATURE=0

# ── VM Layer Mapping (JSON) ───────────────────────────────────────────────────
# Maps VM name → GhostStack layer (L1/L2/L3)
# Example: {"ghost-l1-validator":"L1","ghost-l2-node":"L2","ghost-l3-node":"L3"}
VM_LAYER_MAP={}

    "start":     "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "nats":    "^2.28.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node":    "^22.13.10",
    "tsx":            "^4.19.3",
    "typescript":     "^5.6.3"
  },
  "engines": {
    "node": ">=22.21.0 <23"
  }
}

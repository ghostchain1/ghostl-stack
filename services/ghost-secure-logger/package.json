{
  "name": "ghost-secure-logger",
  "version": "1.0.0",
  "private": true,
  "description": "GhostStack AI Secure Logger Service — centralized log aggregation, signing, anomaly detection, and audit chain for all AI systems",
  "type": "module",
  "scripts": {
    "dev":       "tsx watch src/index.ts",

{
  "name": "@ghostchain/ai-vault",
  "version": "1.0.0",
  "description": "GhostStack Autonomous AI Vault — Central Security Authority for the GhostChain Ecosystem",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "start:vault": "tsx core/vault-engine.ts",
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "start:built": "node dist/core/vault-engine.js",
    "cli": "tsx cli/ghost-vault.ts",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "commander": "^12.1.0",
    "express": "^5.2.1",
    "js-yaml": "^4.1.0",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.21.0 <23"
  }
}

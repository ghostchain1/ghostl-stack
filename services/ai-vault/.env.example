PORT=7710
VAULT_ADDR=http://host.docker.internal:8200
VAULT_NAMESPACE=
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
SERVICES_ROOT=/services
HOST_SERVICES_ROOT=..

AI_VAULT_EXECUTE=0
AI_VAULT_DEFAULT_DECISION=deny
AI_VAULT_FORWARD_CLIENT_TOKEN=0
AI_VAULT_POLICY_PATH=/app/policy.generated.json
AI_VAULT_POLICY_WRITE=0

AI_VAULT_RATE_WINDOW_MS=60000
AI_VAULT_RATE_LIMIT=120
AI_VAULT_BURST_LIMIT=40
AI_VAULT_BLOCK_MS=300000
AI_VAULT_ROTATE_INTERVAL_MS=900000

# GhostChain network
GHOSTBRAIN_URL=http://ghostbrain-core:7900
GHOSTBRAIN_CORE_URL=http://ghostbrain-core:7900
GHOSTCHAIN_L1_RPC=http://host.docker.internal:18545
GHOSTCHAIN_L2_RPC=http://host.docker.internal:29547
GHOSTCHAIN_L3_RPC=http://host.docker.internal:39545
L2_RPC_URL=http://host.docker.internal:29547
L3_RPC_URL=http://host.docker.internal:39545

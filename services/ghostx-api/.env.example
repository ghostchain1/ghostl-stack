# Ghost X API – environment configuration
PORT=4100
CORS_ORIGIN=http://localhost:4200

# GhostChain L2 – required to relay orders on-chain
L2_RPC_URL=http://localhost:8547

# Matcher account (must have MATCHER role on GhostXOrderBook)
MATCHER_PRIVATE_KEY=0xdeadbeef…

# Deployed contract addresses (output of DeployGhostX.s.sol)
GHOSTX_ORDER_BOOK=0x0000000000000000000000000000000000000000
GHOSTX_VAULT=0x0000000000000000000000000000000000000000
GHOSTX_FEE_COLLECTOR=0x0000000000000000000000000000000000000000

{
  "name": "@ghostbrain/ai-copilot",
  "version": "1.0.0",
  "description": "GhostStack AI Operations Copilot — natural-language command interface to GhostBrain",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {

  },
  "dependencies": {
    "express": "^4.19.2",
    "pino":    "^9.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node":    "^22.0.0",
    "typescript":     "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}

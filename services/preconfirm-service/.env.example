# preconfirm-service (.env.example)
#
# Provides signed "soft confirmations" (EIP-712) for a submitted raw transaction.
# This does NOT create trustless finality. Economic finality still comes from rollup settlement.
#
# Copy to .env (gitignored) and adjust per environment.

PORT=7691

# Target RPC (usually L2 or L3).
# For local stacks, host.docker.internal resolves to the host's published RPC ports.
# Recommended: route via ghost-rpc-proxy (gst_* -> eth_* translation).
RPC_URL=http://host.docker.internal:8546

# Which method to call for chainId. Default: gst_chainId.
# Set to eth_chainId if you are pointing directly at a vanilla geth/op-geth JSON-RPC endpoint.
CHAIN_ID_METHOD=gst_chainId

# l1|l2|l3 or 1|2|3
LAYER=l2

# Signature TTL for soft confirmations (ms).
PRECONFIRM_TTL_MS=5000

# EIP-712 domain separation.
PRECONFIRM_EIP712_NAME=GhostPreconfirm
PRECONFIRM_EIP712_VERSION=1
PRECONFIRM_EIP712_VERIFYING_CONTRACT=0x0000000000000000000000000000000000000000

# Signer key (store in Vault/KMS in production).
# You can also set *_FILE to point at a Docker secret / bind-mounted file.
PRECONFIRM_SIGNER_PRIVATE_KEY=
PRECONFIRM_SIGNER_PRIVATE_KEY_FILE=
PRECONFIRM_SIGNER_PRIVATE_KEY_L2=
PRECONFIRM_SIGNER_PRIVATE_KEY_L2_FILE=
PRECONFIRM_SIGNER_PRIVATE_KEY_L3=
PRECONFIRM_SIGNER_PRIVATE_KEY_L3_FILE=

# Optional: call Ghost Guard before signing/forwarding.
GUARD_URL=http://host.docker.internal:7070
GUARD_FAIL_OPEN=0

# Timeouts (ms).
RPC_TIMEOUT_MS=12000
GUARD_TIMEOUT_MS=1500

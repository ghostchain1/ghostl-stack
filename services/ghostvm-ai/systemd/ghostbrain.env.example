# /etc/ghostvm-ai/ghostbrain.env
# ─── GhostBrain Core — per-VM environment override ───────────────────────────
#
# Install to: /etc/ghostvm-ai/ghostbrain.env  (mode 0600, owner root)
# Referenced from: /etc/systemd/system/ghostnetsync.service
#
# After editing, reload with:
#   sudo systemctl daemon-reload && sudo systemctl restart ghostnetsync

# URL of the GhostBrain Core HTTP API
# On devnet: the hypervisor host bridge IP (e.g. 192.168.122.1)
# On prod: the internal service address
GHOSTBRAIN_URL=http://192.168.122.1:7900

# Set to false to silence all GhostBrain integration (safe fallback)
GHOSTBRAIN_ENABLED=true

# Heartbeat interval in seconds (how often ghostvm-ai pings GhostBrain)
GHOSTBRAIN_HEARTBEAT_SECONDS=60

# GNS reconcile interval in seconds
GNS_RECONCILE_INTERVAL_SECONDS=60

# Apply changes automatically (keep false for manual governance gate)
GNS_APPLY_ENABLED=false

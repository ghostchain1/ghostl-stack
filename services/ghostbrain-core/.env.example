# ghostbrain-core — environment example
# Copy to .env and set real values before running locally.
# In Docker these are injected by docker-compose; see docker-compose.custom-rollup.yml.

# ── Server ────────────────────────────────────────────────────────────────────
GHOSTBRAIN_PORT=7900
GHOSTBRAIN_BIND=0.0.0.0

# ── Chain IDs ─────────────────────────────────────────────────────────────────
GHOSTAI_L1_CHAIN_ID=14000101
GHOSTAI_L2_CHAIN_ID=901
GHOSTAI_L3_CHAIN_ID=903

# ── Chain RPC — host-reachable (dev) ──────────────────────────────────────────
# Primary env vars (checked first by resolveRpcEndpoint)
L1_RPC_URL=http://host.docker.internal:18545
L2_RPC_URL=http://host.docker.internal:29547
L3_RPC_URL=http://host.docker.internal:39545

# Canonical aliases used by internal modules
GHOSTCHAIN_L1_RPC=http://host.docker.internal:18545
GHOSTCHAIN_L2_RPC=http://host.docker.internal:29547
GHOSTCHAIN_L3_RPC=http://host.docker.internal:39545

# Docker-internal DNS aliases for custom-runtime overlays (optional fallback path)
GHOST_L1_RPC_URLS=http://ghostchain:18545
GHOST_L2_RPC_URLS=http://ghost-exec-l2:7260
GHOST_L3_RPC_URLS=http://ghost-exec-l3:7270

# ── Cross-layer relay gateways ────────────────────────────────────────────────
# Required for HopExecutor / AI SDK cross-layer sends that submit nested relay envelopes.
L3_TO_L2_GATEWAY_ADDRESS=
L2_TO_L1_GATEWAY_ADDRESS=
HOP_EXECUTOR_RELAY_GAS_LIMIT=200000
# Deprecated compatibility aliases still accepted:
# L3_TO_L2_MESSENGER_ADDRESS=
# L2_TO_L1_MESSENGER_ADDRESS=
# Existing repo compat aliases also accepted:
# L3_CROSS_DOMAIN_MESSENGER_ADDRESS=
# L2_CROSS_DOMAIN_MESSENGER_ADDRESS=
# HOP_EXECUTOR_GAS_LIMIT=200000

# ── Ghost Rollup Service URLs (used by AI layer) ──────────────────────────────
GHOST_EXEC_L2_URL=http://ghost-exec-l2:7260
GHOST_EXEC_L3_URL=http://ghost-exec-l3:7270
GHOST_SEQUENCER_L2_URL=http://ghost-sequencer-l2:7261
GHOST_SEQUENCER_L3_URL=http://ghost-sequencer-l3:7271
GHOST_SETTLEMENT_L2_URL=http://ghost-settlement-l2:7263
GHOST_SETTLEMENT_L3_URL=http://ghost-settlement-l3:7273
GHOST_BRIDGE_L2_URL=http://ghost-bridge-l2:7264
GHOST_BRIDGE_L3_URL=http://ghost-bridge-l3:7274
GHOST_OBSERVABILITY_URL=http://ghost-observability:7276

# ── Cosmos L1 (sovereign chain) ───────────────────────────────────────────────
COSMOS_LCD_URL=http://host.docker.internal:1317
COSMOS_COMET_RPC_URL=http://host.docker.internal:26657

# ── GhostBrain Cluster ────────────────────────────────────────────────────────
GHOSTBRAIN_CORE_URL=http://localhost:7900
CLUSTER_URL=
# Comma-separated list of peer URLs for cluster gossip/sync
# CLUSTER_PEERS=http://ghostbrain-peer-1:7900,http://ghostbrain-peer-2:7900

# ── Security & Auth ───────────────────────────────────────────────────────────
# HMAC secret for signal payloads (must match governance-event-bridge)
CONTROL_PLANE_HMAC_SECRET=change-me-before-deploying
AUDIT_HMAC_SECRET=change-me-before-deploying
GHOSTBRAIN_AUDIT_HMAC_KEY=change-me-before-deploying
# Comma-separated API keys for WebSocket connections (leave empty to disable auth)
GHOSTBRAIN_WS_API_KEYS=

# ── Signing Relay (advisory proposal endpoint) ────────────────────────────────
# All AI proposals route here — never executed inline
SIGNING_RELAY_URL=http://localhost:7910

# ── Databases ─────────────────────────────────────────────────────────────────
# PostgreSQL (neural memory long-term store)
GHOSTBRAIN_DB_URL=postgresql://ghostbrain:changeme@localhost:5432/ghostbrain
# Redis (short-term memory / event queue)
GHOSTBRAIN_REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
# Qdrant (vector embeddings)
GHOSTBRAIN_QDRANT_URL=http://localhost:6333
GHOSTBRAIN_QDRANT_KEY=

# ── Persistence paths ─────────────────────────────────────────────────────────
GHOSTBRAIN_DATA_DIR=/var/lib/ghostbrain
GHOSTBRAIN_MEMORY_DIR=/var/lib/ghostbrain/memory

# ── AI / Chain Monitoring ─────────────────────────────────────────────────────
# Block sampling
CHAIN_SAMPLE_INTERVAL_MS=15000
CHAIN_GAS_SPIKE_THRESHOLD=2.0
# RPC health thresholds
RPC_LATENCY_WARN_MS=500
RPC_LATENCY_CRIT_MS=2000
RPC_BLOCK_DRIFT_WARN=10
RPC_MONITOR_SAMPLE_MS=30000

# ── GhostBrain AI Loops ───────────────────────────────────────────────────────
BRAIN_TICK_MS=5000
COGNITIVE_LOOP_MS=10000
COGNITIVE_WARMUP_MS=30000
COGNITIVE_DRY_RUN=false
SWARM_INTERVAL_MS=15000
SWARM_DRY_RUN=false
EVOLUTION_INTERVAL_MS=60000
PREDICTIVE_TICK_MS=30000

# ── Governance / Policy ───────────────────────────────────────────────────────
GHOSTDNS_BASE_URL=http://ghost-dns:8053
ALLOW_AUTONOMOUS_DESTRUCTIVE=false

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
PROMETHEUS_URL=http://host.docker.internal:9090
PROMETHEUS_PUSHGATEWAY_URL=
PROMETHEUS_PUSH_INTERVAL_MS=15000
PROMETHEUS_JOB_NAME=ghostbrain-core
LOKI_URL=
ALERT_WEBHOOK_URL=
AUDIT_WEBHOOK_URL=

# ── Repair / Healing ──────────────────────────────────────────────────────────
REPAIR_DRY_RUN=true
REPAIR_MAX_PER_HOUR=4
SUPERVISOR_AUTO_RESTART=false

# ── Simulation (dev only) ─────────────────────────────────────────────────────
GHOST_DEPLOY_DRY_RUN=true
GHOST_OPTIMIZER_DRY_RUN=true

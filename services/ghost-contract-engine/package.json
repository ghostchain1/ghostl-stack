{
  "name": "@ghostchain/ghost-contract-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Autonomous contract scanner, function auditor, ABI sync, SDK + test generator for GhostStack",
  "main": "dist/index.js",
  "scripts": {

{
  "compilerOptions": {
    "target":            "ES2022",
    "module":            "commonjs",
    "lib":               ["ES2022"],
    "types":             ["node"],
    "outDir":            "./dist",
    "strict":            true,
    "esModuleInterop":   true,
    "skipLibCheck":      true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "agents/**/*"],
  "exclude": ["node_modules", "dist"]
}

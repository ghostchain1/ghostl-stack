{
  "name": "ghost-ai-attestor",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --loader ts-node/esm --no-warnings --experimental-specifier-resolution=node src/server.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --loader ts-node/esm --no-warnings --experimental-specifier-resolution=node --test test/**/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "ghost": "^6.13.4",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=22.21.0 <23"
  }
}

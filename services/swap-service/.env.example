# Swap Service — environment configuration
# Copy to .env and fill in values for your deployment.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=7670

# ── Chain RPC endpoints ──────────────────────────────────────────────────────
L1_RPC_URL=http://localhost:8545
L2_RPC_URL=http://localhost:8547
L3_RPC_URL=http://localhost:8549

# ── Slippage ─────────────────────────────────────────────────────────────────
# Default maximum slippage in basis points (1 bps = 0.01%). 100 = 1%.
MAX_SLIPPAGE_BPS=100

# ── Pair registry ─────────────────────────────────────────────────────────────
# JSON array of AMM pair configs. Each entry has:
#   id       — human-readable pair identifier
#   chainId  — "l1" | "l2" | "l3"
#   tokenIn  — ERC-20 token address (token0 of the AMM)
#   tokenOut — ERC-20 token address (token1 of the AMM)
#   amm      — MinimalAMM contract address (used for reserve reads)
#   adapter  — MinimalAmmDexAdapter contract address (call target for swaps)
#
# Both directions (tokenIn↔tokenOut) are supported for each pair.
#
SWAP_PAIRS=[{"id":"GST/USDC","chainId":"l2","tokenIn":"0x0000000000000000000000000000000000000000","tokenOut":"0x0000000000000000000000000000000000000000","amm":"0x0000000000000000000000000000000000000000","adapter":"0x0000000000000000000000000000000000000000"}]

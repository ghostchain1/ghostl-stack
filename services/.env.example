## services/.env.example
# Local-only environment for the services compose project.
# DO NOT COMMIT real secrets. Copy to services/.env (gitignored) and fill in.

NODE_ENV=dev
SERVICE_NAME=services
NET_ENV=dev

# Observability
PROM_URL=http://host.docker.internal:9090

# RPC endpoints (host-reachable)
RPC_L1=http://host.docker.internal:18545
RPC_L2=http://host.docker.internal:7260
RPC_L3=http://host.docker.internal:7270
L2_CHAIN_ID=901
L3_CHAIN_ID=903
L3_STACK=ghost-custom

# Clock sync
CLOCK_SYNC_RPC_L1=${RPC_L1}
CLOCK_SYNC_RPC_L2=${RPC_L2}
CLOCK_SYNC_RPC_L3=${RPC_L3}
CLOCK_SYNC_INTERVAL_MS=5000
CLOCK_SYNC_DRIFT_THRESHOLD_SEC=2

# Feature flags (comma-separated)
FEATURE_FLAGS=observability,bridge,ai-monitor

# Vault (optional in dev; required in prod)
VAULT_ADDR=http://localhost:8200

# UI
UI_THEME=dark

# Service auth tokens (generate strong random values; store in Vault in prod)
BRIDGE_ADMIN_TOKEN=
EXECUTION_APPROVAL_TOKEN=
GUARD_APPROVAL_TOKEN=

# Contract addresses (populate from deployments)
BRIDGE_ADDRESS=0xDadd1125B8Df98A66Abd5EB302C0d9Ca5A061dC2
BRIDGE_L2L3_ADDRESS=0xDadd1125B8Df98A66Abd5EB302C0d9Ca5A061dC2
L2L3_BRIDGE_ADDRESS=0xDadd1125B8Df98A66Abd5EB302C0d9Ca5A061dC2
GUARD_POLICY_ADDRESS=0x677df0cb865368207999F2862Ece576dC56D8dF6
L1_ROLLUP_L2_ADDRESS=0xad32D5C2Da9f4159C4cc98686C005852b3905355
L1_ROLLUP_PARENT_ORACLE=0x2C001131e99c79e6dDF9f099F2101e9535172Db1
ROLLUP_L2_PARENT_ORACLE_ADDRESS=0x2C001131e99c79e6dDF9f099F2101e9535172Db1
L2_ROLLUP_L3_ADDRESS=0x130A46b6E41DB6E1e18fb9c759F223c459190e90
L1_FINALITY_ORACLE_ADDRESS=0x7B3Be2dDDdDf9A0a3fE1DC57B98980F662C3a422
L2_FINALITY_ORACLE_ADDRESS=0x650aEF4b63095e4EDe581BC79CdeA927e3ba553A
L3_FINALITY_ORACLE_ADDRESS=0x87F850cbC2cFfac086F20d0d7307E12d06fA2127
L3_INBOX_ADDRESS=0x8464135c8F25Da09e49BC8782676a84730C318bC
L3_TOKEN_FACTORY_ADDRESS=0x71C95911E9a5D330f4D621842EC243EE1343292e
L2_TOKEN_ADDRESS=
L3_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Private keys (do not commit; store in Vault/KMS in prod)
RELAYER_PRIVATE_KEY=
L2_RELAYER_PRIVATE_KEY=
PROPOSER_PRIVATE_KEY=
CHALLENGER_PRIVATE_KEY=

# Guard
GUARD_URL=http://host.docker.internal:7070

# RPC proxy / network manager
UPSTREAM_URL=${RPC_L2}
LOG_REQUESTS=0
NETWORK_MANAGER_PORT=7766

# Monitoring
MONITOR_HOST=host.docker.internal
MONITOR_RPC_L1=${RPC_L1}
MONITOR_RPC_L2=${RPC_L2}
MONITOR_RPC_L3=${RPC_L3}
MONITOR_PORTS=7070,7171,18545,7260,7261,7262,7263,7264,7265,7270,7271,7272,7273,7274,7275,7276
MONITOR_HEALTH_ENDPOINTS=http://ghost-relayer:7171/health
MONITOR_INTERVAL_MS=10000

# Local persistence
TREASURY_STATE_FILE=/data/treasury-proposals.json

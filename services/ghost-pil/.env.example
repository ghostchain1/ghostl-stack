NODE_ENV=production
PORT=3220
DATABASE_URL=postgres://ghost:ghostpass@postgres:5432/ghost_pil

PIL_ENABLED=false
PIL_AUTONOMY_MODE=ADVISORY
PIL_WRITE_ENABLED=false
PIL_APPROVAL_REQUIRED=true
PIL_SIM_ENABLED=false

PIL_CHAIN_CONFIG_PATH=/app/config/chains.json
PIL_REGISTRY_URL=
PIL_LEGAL_SIGNALS_PATH=/app/config/legal-signals.json
PIL_JURISDICTIONS_PATH=/app/config/jurisdictions.json
PIL_RPC_NAMESPACE=
PIL_VALIDATOR_CONFIG_PATH=/app/config/validators.json
PIL_VALIDATOR_EVAL_ENABLED=false
PIL_VALIDATOR_EVAL_INTERVAL_SECONDS=300

PIL_INGEST_ENABLED=true
PIL_INGEST_INTERVAL_SECONDS=20
PIL_MAX_BLOCKS_PER_TICK=5
PIL_RECEIPTS_ENABLED=true
PIL_TRACE_ENABLED=false

PIL_LOG_LEVEL=info
PIL_SEED_SAMPLE_DATA=true

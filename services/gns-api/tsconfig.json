{
  "compilerOptions": {
    "target":          "ES2022",
    "module":          "NodeNext",
    "moduleResolution":"NodeNext",
    "outDir":          "./dist",
    "rootDir":         "./src",
    "strict":          true,
    "esModuleInterop": true,
    "skipLibCheck":    true,
    "declaration":     true,
    "sourceMap":       true,
    "baseUrl": ".",
    "paths": {
      "ghost": ["../../node_modules/ethers/lib.esm/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

# ══════════════════════════════════════════════════════════════════════════════
# API + RPC ENDPOINTS
# ══════════════════════════════════════════════════════════════════════════════

api.ghostchain.cloud {
        import ghost_security
        import ghost_cors
        reverse_proxy http://38.247.149.218:4000
}

# GhostChain L1 JSON-RPC proxy
rpc.ghostchain.cloud {
        import ghost_security
        import ghost_cors
        reverse_proxy http://208.110.71.164:18545 {
                header_up Host "208.110.71.164:18545"
        }
}

l2rpc.ghostchain.cloud {
        import ghost_security
        import ghost_cors
        header Content-Type "application/json"
        respond `{"error":"GhostL2 RPC not yet deployed","status":"coming-soon"}` 503
}

l3rpc.ghostchain.cloud {
        import ghost_security
        import ghost_cors
        header Content-Type "application/json"
        respond `{"error":"GhostL3 RPC not yet deployed","status":"coming-soon"}` 503
}


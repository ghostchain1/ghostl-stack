# stack.env
#
# Repo-local env file for the Liquidity Gravity stack. Keep secrets out of git.
# Suggested workflow:
# - put real values in `.env` (already supported by this repo), or
# - copy from `.env.example` and override locally.
#
# This file exists mainly to match the documented folder tree and as an
# optional integration point for scripts that expect `stack.env`.

# Canonical L2<->L3 bridge address (used by deploy/wiring scripts).
L2L3_BRIDGE_ADDRESS=0xDadd1125B8Df98A66Abd5EB302C0d9Ca5A061dC2

# Backward-compatible alias used by older service configs.
BRIDGE_L2L3_ADDRESS=0xDadd1125B8Df98A66Abd5EB302C0d9Ca5A061dC2

# Rollup and finality-oracle wiring addresses.
L1_ROLLUP_L2_ADDRESS=0xad32D5C2Da9f4159C4cc98686C005852b3905355
L1_ROLLUP_PARENT_ORACLE=0x2C001131e99c79e6dDF9f099F2101e9535172Db1
ROLLUP_L2_PARENT_ORACLE_ADDRESS=0x2C001131e99c79e6dDF9f099F2101e9535172Db1
L2_ROLLUP_L3_ADDRESS=0x130A46b6E41DB6E1e18fb9c759F223c459190e90
L1_FINALITY_ORACLE_ADDRESS=0x7B3Be2dDDdDf9A0a3fE1DC57B98980F662C3a422
L2_FINALITY_ORACLE_ADDRESS=0x650aEF4b63095e4EDe581BC79CdeA927e3ba553A
L3_FINALITY_ORACLE_ADDRESS=0x87F850cbC2cFfac086F20d0d7307E12d06fA2127

# Sovereign economy service endpoints and controls.
L3_FEE_COLLECTOR_URL=http://localhost:7681
L2_REVENUE_AGGREGATOR_URL=http://localhost:7682
TREASURY_ENGINE_URL=http://localhost:7683
REWARD_DISTRIBUTOR_URL=http://localhost:7684
HYPER_GHOST_GOVERNOR_URL=http://localhost:7685
HYPER_GHOST_GOVERNOR_ADMIN_TOKEN=
FEDERATION_POLICY_PATH=/governance/federation/policy.json
SOLVENCY_ARTIFACT_SIGNING_KEY=
L3_FEE_FORWARD_HMAC_SECRET=
L2_REVENUE_AGGREGATOR_ADMIN_TOKEN=
TREASURY_ENGINE_ADMIN_TOKEN=
REWARD_DISTRIBUTOR_ADMIN_TOKEN=
L2_REVENUE_BRIDGE_ADDRESS=0x0000000000000000000000000000000000000901
TREASURY_STABLE_ASSET_RATIO=65
TREASURY_YIELD_RATIO=35
TREASURY_RISK_CAP_BPS=7200
RPC_L1=http://localhost:18545
# ── Autonomous RPC pool / GhostBrainAiEngine ─────────────────────────────────
# Comma-separated lists of RPC endpoints per layer (used by AutonomousGhostProvider)
GHOST_L1_RPC_URLS=http://localhost:18545
GHOST_L2_RPC_URLS=http://localhost:29547
GHOST_L3_RPC_URLS=http://localhost:39545
# GhostBrain Core base URL for the remote AI engine (GhostBrainAiEngine)
GHOSTBRAIN_CORE_URL=http://localhost:7900
# GhostBrain Orchestrator (infrastructure + chain health, port 7895)
GHOSTBRAIN_ORCHESTRATOR_URL=http://localhost:7895

# ── GhostBrain Neural Memory Database ────────────────────────────────────────
# Three-layer AI memory system: Redis (real-time) + PostgreSQL (operational) + Qdrant (vector/long-term)
# All three backends are OPTIONAL — GhostBrain degrades gracefully to in-process/file stores.
#
# PostgreSQL — operational memory (system_events, ai_decisions, task_patterns, etc.)
GHOSTBRAIN_DB_URL=postgresql://ghostbrain:ghostbrain@localhost:5432/ghostbrain
#
# Redis — real-time memory (hot state, <5ms latency, 24h TTL per key)
GHOSTBRAIN_REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=                  # leave blank for no-auth Redis
#
# Qdrant — long-term neural/vector memory (permanent semantic embeddings, 512-dim)
GHOSTBRAIN_QDRANT_URL=http://localhost:6333
GHOSTBRAIN_QDRANT_KEY=           # leave blank for local unauthenticated Qdrant
#
# Audit log — HMAC-SHA256 tamper-proof AI decision log
# Must be at least 32 bytes. If unset, entries are stored unsigned.
GHOSTBRAIN_AUDIT_HMAC_KEY=change_me_to_a_32_plus_byte_random_secret
#
# Memory optimizer — background compression + archival
GHOSTBRAIN_COMPRESS_INTERVAL_MS=3600000   # 1 hour (set lower in dev for testing)
GHOSTBRAIN_EVENT_RETENTION_DAYS=90        # archive PostgreSQL events older than this

# ── GhostBrain Cluster Mesh ───────────────────────────────────────────────────
# ghostbrain-agent (port 7901) — per-server resource monitor
GHOSTBRAIN_AGENT_PORT=7901
AGENT_NODE_ID=ghostbrain-agent-0
# ghostbrain-cluster (port 7902) — federated gossip + leader election
GHOSTBRAIN_CLUSTER_PORT=7902
CLUSTER_NODE_ID=cluster-leader-0
CLUSTER_NODE_URL=http://localhost:7902
CLUSTER_PEERS=                   # comma-sep peer URLs for multi-cluster setups
CLUSTER_PRIORITY=100
# ghostbrain-memory (port 7903) — distributed AI memory federation
GHOSTBRAIN_MEMORY_PORT=7903
# ghostbrain-infra (port 7904) — multi-hypervisor infrastructure controller
GHOSTBRAIN_INFRA_PORT=7904
HYPERVISOR_URLS=                 # comma-sep libvirt REST bridge URLs
DOCKER_HOSTS=unix:///var/run/docker.sock
AGENT_URLS=http://localhost:7901
# Shared wiring
CLUSTER_URL=http://localhost:7902
MEMORY_URL=http://localhost:7903
INFRA_URL=http://localhost:7904
LIBVIRT_REST_URL=                # optional: libvirt REST bridge for VM monitoring
REPORT_INTERVAL_MS=15000

# ── GhostStack Autonomous Infrastructure Supervisor (GAIS) ───────────────────
# Controls VM lifecycle, auto-heals nodes, and submits advisory proposals.
# REST API at port 9100.  Required in production.
GAIS_API_TOKEN=                  # REQUIRED — set a strong random secret
GAIS_LISTEN_PORT=9100
GAIS_LOG_LEVEL=INFO
VM_MANAGER_DRY_RUN=0             # set to 1 in staging to prevent real VM actions
VM_MANAGER_COOLDOWN_S=120        # seconds between restarts of the same VM
VM_MANAGER_MAX_RESTARTS_H=4      # circuit-breaker: restarts per VM per hour
VM_SNAPSHOT_ENABLED=1            # snapshot before reboot (requires qemu storage)
SIGNING_RELAY_URL=http://localhost:7910  # advisory proposals target
HEALER_UNHEALTHY_WINDOW_S=60     # seconds a node must be down before healing starts
GOSSIP_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=3000
SYNC_INTERVAL_MS=30000
INFRA_POLL_INTERVAL_MS=60000
MAINNET_LAUNCH_GATE_ADDRESS=0x0000000000000000000000000000000000000000

# ── ghost-noc-ai (Network Operations Centre AI) ───────────────────────────────
NOC_AI_URL=http://localhost:7960          # portal proxies to this
NOC_PORT=7960
NOC_DRY_RUN=0                            # set to 1 to log proposals without submitting
NOC_POLL_INTERVAL_MS=30000               # monitor poll interval
MAINNET_RELEASE_GATE_ADDRESS=0x0000000000000000000000000000000000000000

# ── GhostChain — Cosmos SDK Sovereign Chain ──────────────────────────────────
# ghostchaind: CometBFT consensus, custom modules: x/ghost, x/ghostgov,
# x/gsttoken, x/aiconsensus. Native denom: ugst. Bech32 prefix: ghost.
#
# These vars are consumed by:
#   - governance-event-bridge (CosmosGovPoller → ghostchain/ghostgov/v1/proposals)
#   - hermes-relayer (IBC channel/connection management)
#   - ghostbrain-core (on-chain AI governance signals)
#
# Start the node: docker compose -f docker-compose.ghostchain.yml up -d

# Chain identity
COSMOS_CHAIN_ID=ghostchain-1
GHOSTCHAIN_MONIKER=ghostchain-validator

# LCD / REST endpoint (port 1317 — consumed by governance-event-bridge)
COSMOS_LCD_URL=http://localhost:1317

# CometBFT RPC (port 26657 — consumed by Hermes relayer + status checks)
GHOSTCHAIN_RPC_URL=http://localhost:26657

# gRPC endpoint (port 9090 — consumed by Hermes + SDK clients)
GHOSTCHAIN_GRPC_URL=localhost:9090

# Port bindings (override these to avoid conflicts with existing services)
GHOSTCHAIN_LCD_PORT=1317
GHOSTCHAIN_RPC_PORT=26657
GHOSTCHAIN_GRPC_PORT=9090
GHOSTCHAIN_P2P_PORT=26656

# AI Oracle address (optional — used by x/aiconsensus if set)
GHOST_AI_ORACLE_ADDR=

# IBC Hermes relayer log level (debug|info|warn|error)
HERMES_LOG_LEVEL=info

# Cosmos governance polling interval (ms) for governance-event-bridge
COSMOS_POLL_INTERVAL_MS=12000

# ─────────────────────────────────────────────────────────────
# Ghost Global Network Intelligence (GNI) — port 7970
# ─────────────────────────────────────────────────────────────
# HTTP port the GNI service listens on
GNI_PORT=7970

# Internal URL used by the portal API proxy
GNI_INTERNAL_URL=http://localhost:7970

# Dry-run mode: 1 = log proposals but don't POST to signing relay
GNI_DRY_RUN=0

# Minimum healthy peer count before a node is flagged under-peered
GNI_PEER_MIN=5

# Optimal peer count target per node
GNI_PEER_OPTIMAL=25

# Allow cloud node deployment proposals (0 = on-prem VM proposals only)
GNI_CLOUD_DEPLOY=0

# Cloud provider hint passed in proposals (hetzner|aws|gcp|azure)
GNI_CLOUD_PROVIDER=hetzner

# On-prem VM provider hint passed in proposals
GNI_VM_PROVIDER=local-qemu

# Latency thresholds (ms)
GNI_LATENCY_WARN=2000
GNI_LATENCY_CRIT=5000

# RPC call timeout (ms) when polling L1/L2/L3 chain nodes
GNI_RPC_TIMEOUT=6000

# node-cron expression controlling the analysis cycle (every 60 seconds)
GNI_CRON_EXPR=*/60 * * * * *

# TPS threshold: if forecasted TPS exceeds this, propose expansion
GNI_TPS_EXPAND=500

# Peer drop fraction: if peer count is projected to fall by this fraction, propose expansion
GNI_PEER_DROP_PCT=0.30

# Minimum forecast confidence (0–1) required before triggering an expansion proposal
GNI_FORECAST_MIN_CONFIDENCE=0.50

# Sliding-window sample count for load prediction
GNI_PREDICTION_WINDOW=30

# Minimum active validators on Cosmos LCD; triggers proposal if below this
GNI_VALIDATOR_MIN=4

# Validator load factor threshold (0–1); triggers proposal if aggregate load exceeds this
GNI_VALIDATOR_LOAD_THRESHOLD=0.80

# ─────────────────────────────────────────────────────────────
# Ghost Autonomous Economic Engine (AEE) — port 7980
# ─────────────────────────────────────────────────────────────
# HTTP port the AEE service listens on
AEE_PORT=7980

# Internal URL used by the portal API proxy
AEE_INTERNAL_URL=http://localhost:7980

# Dry-run: 1 = log proposals but never POST to signing relay
AEE_DRY_RUN=0

# RPC call timeout (ms) when polling GhostChain L1
AEE_RPC_TIMEOUT=6000

# node-cron expression for the economic analysis cycle (every 2 minutes)
AEE_CYCLE_CRON=0 */2 * * * *

# Treasury wallet address (EVM, GhostChain L1)
AEE_TREASURY_WALLET=

# Treasury allocation ratios (must sum to 1.0)
AEE_ALLOC_OPS=0.30
AEE_ALLOC_VALIDATORS=0.40
AEE_ALLOC_LIQUIDITY=0.20
AEE_ALLOC_RESERVE=0.10

# Minimum interval between allocation proposals (minutes)
AEE_ALLOC_INTERVAL_MIN=60

# GST burn thresholds
AEE_BURN_TPS_THRESHOLD=300
AEE_BURN_SURPLUS_GST=50000000
AEE_BURN_AMOUNT_GST=10000
AEE_BURN_COOLDOWN_MIN=30

# Validator participation targets (0–1)
AEE_VALIDATOR_MIN_PARTICIPATION=0.80
AEE_VALIDATOR_MAX_PARTICIPATION=0.95

# Cooldown between reward-adjustment proposals (minutes)
AEE_REWARDS_COOLDOWN_MIN=60

# Liquidity pool imbalance threshold (fraction from 50/50, e.g. 0.15 = 35/65 triggers rebalance)
AEE_LIQUIDITY_IMBALANCE_THRESHOLD=0.15

# Cooldown between per-pool liquidity proposals (minutes)
AEE_LIQ_COOLDOWN_MIN=45

# Yield strategy identifiers (comma-separated)
AEE_YIELD_STRATEGIES=ghostchain-staking,ghostxchange-lp

# Minimum acceptable annualised APY (decimal, 0.05 = 5%)
AEE_YIELD_MIN_APY=0.05

# Minimum GST balance to consider a yield deployment
AEE_YIELD_MIN_DEPLOY_GST=100000

# Minimum GST that must remain in treasury after any yield deployment
AEE_YIELD_RESERVE_FLOOR_GST=10000000

# Cooldown between yield proposals (minutes)
AEE_YIELD_COOLDOWN_MIN=120

# Sliding-window size for economic forecast (number of samples)
AEE_FORECAST_WINDOW=20

# ── Ghost Sovereign Security AI (SSA) — port 7990 ─────────────────────────────

# HTTP port for the SSA REST API
SSA_PORT=7990

# Internal URL for portal proxy (points to SSA service)
SSA_INTERNAL_URL=http://localhost:7990

# Set to 1 to log threats and proposals without submitting to relay
SSA_DRY_RUN=0

# Cron expression for scan schedule (default: every 30 seconds)
# Note: expressed as a quoted value. Node-cron 6-part syntax.
SSA_CRON_EXPR=*/30 * * * * *

# GhostChain L1/L2/L3 RPC endpoints for chain monitoring
L1_RPC_URL=http://localhost:18545
L2_RPC_URL=http://localhost:29545
L3_RPC_URL=http://localhost:39545

# Cosmos LCD URL for validator / slashing data
COSMOS_LCD_URL=http://localhost:1317

# Comma-separated additional contract addresses to monitor (canonical bridge
# addresses are always included; this is for bespoke critical contracts)
SSA_WATCHED_CONTRACTS=

# Per-scan TX count spike threshold for watched contracts
SSA_CONTRACT_TX_SPIKE=500

# Balance drain percentage that triggers a drain alert (decimal, 0.20 = 20%)
SSA_CONTRACT_DRAIN_PCT=0.20

# Minimum GST drain (absolute) that triggers an exploit alert
SSA_DRAIN_ABSOLUTE_MIN_GST=10000

# TX burst count + drain combo that indicates reentrancy
SSA_REENTRANCY_TX_BURST=200

# Seconds without new block before a stall alert is raised
SSA_BLOCK_STALL_SEC=120

# Block-time slowdown multiplier before alerting (e.g., 3 = 3x slower than expected)
SSA_BLOCK_SLOW_MULT=3

# Max transactions per block before abuse alert
SSA_RPC_TX_SPIKE_PER_BLOCK=500

# Minimum validator uptime ratio (decimal, 0.90 = 90%)
SSA_VALIDATOR_UPTIME_MIN=0.90

# Number of missed blocks per scan window before slashing alert
SSA_SLASH_MISSED_BLOCKS=100

# Tombstone threshold (1 = alert on first tombstone)
SSA_TOMBSTONE_ALERT=1

# Treasury wallet address to monitor (GhostChain L1 hex address)
SSA_TREASURY_WALLET=

# Treasury drain percentage threshold per scan cycle (decimal, 0.10 = 10%)
SSA_TREASURY_DRAIN_PCT=0.10

# Minimum acceptable treasury balance (GST units — not wei)
SSA_TREASURY_MIN_GST=1000000

# Peer count drop ratio that triggers eclipse attack alert (0.50 = 50% drop)
SSA_PEER_DROP_PCT=0.50

# Maximum acceptable block lag between L2→L1 or L3→L2 (blocks)
SSA_BLOCK_LAG_MAX=50

# Gas price spike multiplier vs rolling median (5 = 5x above median)
SSA_GAS_SPIKE_MULT=5

# Transaction volume spike multiplier vs rolling median
SSA_TX_VOLUME_SPIKE_MULT=10

# Per-mitigation-type cooldown (minutes) to prevent proposal spam
SSA_MITIGATION_COOLDOWN_MIN=15

# ── LitVybzLive Economy Services ─────────────────────────────────────────────
# Required — set before starting the litvyblive economy stack
ECONOMY_DB_PASSWORD=

# Economy microservice URLs (defaults work inside Docker Compose network)
LITVYB_TREASURY_URL=http://creator-treasury:7040
LITVYB_MEMBERSHIPS_URL=http://fan-memberships:7041
LITVYB_TOKENS_URL=http://creator-tokens:7042
LITVYB_GIFTS_URL=http://nft-gifts:7043
LITVYB_STAKING_URL=http://staking-engine:7044
LITVYB_REVENUE_URL=http://revenue-distribution:7045
LITVYB_DAO_URL=http://fan-dao:7046
LITVYB_MARKETPLACE_URL=http://marketplace:7047

# ── LitVybzLive Mobile (Flutter iOS/Android — GitHub Actions vars) ────────────
# Set these as GitHub Actions Repository Variables (Settings → Secrets and variables → Variables)
# Dart-defines injected into flutter build ios / flutter build apk at CI time.
GHOST_L3_RPC=http://localhost:39545       # GhostL3 public RPC for production builds
LITVYB_API_URL=http://localhost:7001      # LitVybzLive backend API URL
LITVYB_SOCKET_URL=http://localhost:7001   # WebSocket/Socket.IO URL
GHOSTBRAIN_URL=http://localhost:7002      # GhostBrain AI (local instance)
MEDIASOUP_URL=http://localhost:2000       # MediaSoup SFU signalling

# GitHub Actions Secrets (Settings → Secrets and variables → Secrets)
# FIREBASE_IOS_GOOGLE_SERVICES_BASE64   — base64-encoded GoogleService-Info.plist
# FIREBASE_ANDROID_GOOGLE_SERVICES_BASE64 — base64-encoded google-services.json
# APPLE_CERTIFICATE_BASE64              — base64-encoded .p12 distribution cert
# APPLE_CERTIFICATE_PASSWORD            — .p12 passphrase
# APPLE_PROVISIONING_PROFILE_BASE64     — base64-encoded .mobileprovision (AdHoc/App Store)
# APPLE_TEAM_ID                         — 10-character Apple Developer Team ID
# ANDROID_KEYSTORE_BASE64               — base64-encoded .jks keystore
# ANDROID_STORE_PASSWORD                — keystore store password
# ANDROID_KEY_PASSWORD                  — keystore key password
# ANDROID_KEY_ALIAS                     — keystore key alias

{
  "name": "ghostl-contracts",
  "private": true,
  "scripts": {
    "build": "hardhat compile",
    "deploy:all": "npm run deploy:edge",
    "deploy:edge": "hardhat run --network ghostl2 scripts/deploy_all.ts",
    "deploy:op": "hardhat run --network ghostl2Op scripts/deploy_all.ts",
    "deploy:futuristic": "hardhat run --network anvil scripts/deploy_futuristic_stack.ts",
    "deploy:ai": "hardhat run --network ghostl2 scripts/deploy_ai_layers.ts",
    "deploy:one-click": "ts-node scripts/deploy_one_click.ts",
    "deploy:testnet": "ts-node scripts/one_click_testnet.ts",
    "docs:diagrams": "ts-node scripts/generate_diagrams.ts",
    "formal:slither": "ts-node scripts/run_slither.ts",
    "formal:scribble": "ts-node scripts/run_scribble.ts",
    "formal:echidna": "ts-node scripts/run_echidna.ts",
    "formal:certora": "ts-node scripts/run_certora.ts",
    "verify:formal": "ts-node scripts/run_formal_verification.ts",
    "test": "hardhat test",
    "test:foundry": "ts-node scripts/run_foundry_tests.ts --mode default",
    "test:fuzz": "ts-node scripts/run_foundry_tests.ts --mode fuzz",
    "test:invariant": "ts-node scripts/run_foundry_tests.ts --mode invariant"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "scribble": "git+https://github.com/ConsenSys/scribble.git#v0.7.10",
    "hardhat": "^2.22.10",
    "surya": "^0.4.3",
    "typescript": "5.6.3",
    "ts-node": "^10.9.2",
    "dotenv": "^17.2.3"
  },
  "engines": {
    "node": ">=22.21.0 <23"
  }
}

{
  "name": "ghostl-contracts",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run pragmas:check",
    "build": "hardhat build --no-tests",
    "compile:docker": "NODE_OPTIONS=--max_old_space_size=4096 HARDHAT_USE_DOCKER_SOLC=1 HARDHAT_VIA_IR=true hardhat compile",
    "compile:docker:verbose": "NODE_OPTIONS=--max_old_space_size=4096 HARDHAT_USE_DOCKER_SOLC=1 HARDHAT_VIA_IR=true HARDHAT_VERBOSE=true hardhat compile",
    "compile:docker:clean": "hardhat clean && node scripts/clean-typechain.mjs && npm run compile:docker",
    "deploy:all": "npm run deploy:edge",
    "deploy:edge": "hardhat run --network ghostl2 scripts/deploy_all.ts",
    "deploy:op": "hardhat run --network ghostl2Op scripts/deploy_all.ts",
    "deploy:futuristic": "hardhat run --network anvil scripts/deploy_futuristic_stack.ts",
    "deploy:governance": "GOVERNANCE_ONLY=1 hardhat run --network anvil scripts/deploy_futuristic_stack.ts",
    "deploy:futuristic:l2": "DEPLOY_LAYER=L2 hardhat run --network ghostl2 scripts/deploy_futuristic_stack.ts",
    "deploy:futuristic:l3": "DEPLOY_LAYER=L3 hardhat run --network ghostl3 scripts/deploy_futuristic_stack.ts",
    "deploy:governance:l2": "DEPLOY_LAYER=L2 GOVERNANCE_ONLY=1 hardhat run --network ghostl2 scripts/deploy_futuristic_stack.ts",
    "deploy:governance:l3": "DEPLOY_LAYER=L3 GOVERNANCE_ONLY=1 hardhat run --network ghostl3 scripts/deploy_futuristic_stack.ts",
    "deploy:ghostload:governance": "hardhat run --network anvil scripts/deploy_ghostload_governance.ts",
    "deploy:cascading-finality": "hardhat run --network ghostl2 scripts/deploy_cascading_finality.ts",
    "deploy:cascading-finality:op": "hardhat run --network ghostl2Op scripts/deploy_cascading_finality.ts",
    "deploy:ai": "hardhat run --network ghostl2 scripts/deploy_ai_layers.ts",
    "deploy:one-click": "ts-node scripts/deploy_one_click.ts",
    "deploy:rollups-manual": "ts-node scripts/deploy_rollups_manual.ts",
    "deploy:testnet": "ts-node scripts/one_click_testnet.ts",
    "docs:diagrams": "ts-node scripts/generate_diagrams.ts",
    "formal:slither": "ts-node scripts/run_slither.ts",
    "formal:scribble": "ts-node scripts/run_scribble.ts",
    "formal:echidna": "ts-node scripts/run_echidna.ts",
    "formal:certora": "ts-node scripts/run_certora.ts",
    "verify:formal": "ts-node scripts/run_formal_verification.ts",
    "proposal:gst-constitution": "ts-node scripts/build-gst-constitution-proposal.ts",
    "proposal:lge-constitution": "ts-node scripts/build-lge-constitution-proposal.ts",
    "pragmas:check": "node -r ts-node/register ../scripts/check_pragmas.ts",
    "test": "hardhat test",
    "test:foundry": "ts-node scripts/run_foundry_tests.ts --mode default",
    "test:fuzz": "ts-node scripts/run_foundry_tests.ts --mode fuzz",
    "test:invariant": "ts-node scripts/run_foundry_tests.ts --mode invariant",
    "test:gst-invariant": "forge test --match-path test/GSTInvariant.t.sol",
    "test:cascading-finality:ci": "bash scripts/run_cascading_finality_ci.sh"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "scribble": "git+https://github.com/ConsenSys/scribble.git#v0.7.10",
    "hardhat": "^3.1.9",
    "surya": "^0.4.3",
    "typescript": "5.9.3",
    "ts-node": "^10.9.2",
    "dotenv": "^17.3.1"
  },
  "engines": {
    "node": ">=22.21.0 <23"
  }
}

# ─── GhostBrain Core ───────────────────────────────────────────
# Shared source (overridable for CI/staging)
GHOSTBRAIN_SRC=/home/ghost/hyperghost-tooling/hyper-ghost-ai/services

# Ports
GHOSTBRAIN_SCP_PORT=9500
GHOSTBRAIN_SWARM_PORT=9000
GHOSTBRAIN_KERNEL_PORT=9300
GHOSTBRAIN_GDM_PORT=9900
GHOSTBRAIN_AEE_PORT=9800
GHOSTBRAIN_GVF_PORT=9700
GHOSTBRAIN_MULTICHAIN_PORT=9350
GHOSTBRAIN_INTERCHAIN_PORT=9450
GHOSTBRAIN_GOVERNANCE_PORT=9550
GHOSTBRAIN_RESEARCH_PORT=9600
GHOSTBRAIN_DEVOPS_PORT=9400
GHOSTBRAIN_SIMLAB_PORT=9200
GHOSTBRAIN_TWIN_PORT=9100
GHOSTBRAIN_CONSCIOUS_PORT=9150
GHOSTBRAIN_EVOLUTION_PORT=9250
GHOSTBRAIN_ECONOMIC_PORT=9050

# Service URLs (used within the Docker network)
GHOSTBRAIN_KERNEL_URL=http://ghostbrain-kernel:9300
GHOSTBRAIN_SWARM_URL=http://ghostbrain-swarm:9000
GHOSTBRAIN_GDM_URL=http://ghostbrain-data-mesh:9900
GHOSTBRAIN_AEE_URL=http://ghostbrain-economy-engine:9800
GHOSTBRAIN_GVF_URL=http://ghostbrain-validator-fabric:9700
GHOSTBRAIN_SCP_URL=http://ghostbrain-control-plane:9500

# SCP Auth (comma-separated key:role pairs — change these!)
SCP_API_KEYS=ghoststack-admin:admin,ghoststack-operator:operator

# Governance API
GOVERNANCE_API_URL=http://ghostbrain-governance:9550

# ─── Hypervisor ────────────────────────────────────────────────
HYPERVISOR_HOST=208.110.71.164
HYPERVISOR_USER=ghost
GHOSTBRAIN_HYPERVISOR_URL=http://208.110.71.164:8787

# ─── GhostChain L1 ─────────────────────────────────────────────
GHOSTCHAIN_L1_RPC=http://ghostchain-devnet:8545
GHOSTCHAIN_L1_WS=ws://ghostchain-devnet:8546
GHOSTCHAIN_L1_CHAIN_ID=1337

# ─── Monitoring ────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ghoststack
PROMETHEUS_RETENTION=15d

# ─── Next.js Dashboard ─────────────────────────────────────────
NEXT_PUBLIC_SCP_URL=http://localhost:9500
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001
NEXT_PUBLIC_CHAIN_RPC=http://localhost:8545

# ─── GhostStack Manager ────────────────────────────────────────
GHOSTSTACK_MANAGER_PORT=8787
GHOSTSTACK_MANAGER_TOKEN=change-me-in-production

# OP Stack devnet sample env
# Copy to infra/opstack/.env and adjust as needed.

# Internal Docker hostnames
L1_RPC=http://l1:8545
L2_RPC=http://l2-geth:9545

# Host-facing RPCs (ports exposed by docker-compose)
HOST_L1_RPC=http://localhost:28545
HOST_L2_RPC=http://localhost:29545
# Placeholder for future L3 OP Stack chain on GhostL2
HOST_L3_RPC=http://localhost:39545

# Keys (keys/init.sh will regenerate these and set addresses)
SEQUENCER_KEY=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
BATCHER_KEY=0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
PROPOSER_KEY=0xcccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
CHALLENGER_KEY=0xdddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd

# Rollup config parameters (defaults are dev-friendly)
L2_CHAIN_ID=901
L1_CHAIN_ID=31337
SEQUENCER_ADDRESS=
BATCH_SENDER_ADDRESS=
PROPOSER_ADDRESS=
CHALLENGER_ADDRESS=

# Hardhat convenience (consumed in contracts/hardhat.config.ts)
OP_L2_RPC=http://localhost:29545
OP_L2_CHAIN_ID=901
OP_L3_RPC=http://localhost:39545
OP_L3_CHAIN_ID=902

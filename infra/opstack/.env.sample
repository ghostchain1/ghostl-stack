# OP Stack devnet sample env
# Copy to infra/opstack/.env and adjust as needed. Put secrets/keys in .env.secrets (ignored by git).

OPSTACK_IMAGE_TAG=devnet

# Internal Docker hostnames
L1_RPC=http://host.docker.internal:18545
L2_RPC=http://l2-geth:8545

# Host-facing RPCs (ports exposed by docker-compose)
HOST_L1_RPC=http://localhost:18545
HOST_L2_RPC=http://localhost:29547
# Placeholder for future L3 OP Stack chain on GhostL2
HOST_L3_RPC=http://localhost:39545
L3_GUARD_FAIL_OPEN=false

# Images (pin to deterministic tags/digests)
FOUNDRY_IMAGE=ghcr.io/foundry-rs/foundry:nightly-2024-09-18
OP_GATE_IMAGE=local/op-gate:0.1.0
OP_STACK_BASE_IMAGE=node:22-alpine3.19
PROMETHEUS_IMAGE=prom/prometheus:v2.53.0
GRAFANA_IMAGE=grafana/grafana:11.2.0

# Gate (Guard-aware JSON-RPC proxy for op-batcher/proposer)
GATE_PORT=8545
GATE_UPSTREAM_RPC=http://l2-geth:8545
GATE_GUARD_URL=http://host.docker.internal:7070
GATE_ADMIN_TOKEN=
GATE_ALLOW_INSECURE_ADMIN=0
GATE_DEFAULT_DELAY_SECONDS=0
GATE_L1_PORT=8545
GATE_L1_UPSTREAM_RPC=http://l1-rpc-proxy:18546
GATE_L1_GUARD_URL=http://host.docker.internal:7070
GATE_L1_ADMIN_TOKEN=
GATE_L1_ALLOW_INSECURE_ADMIN=0
GATE_L1_DEFAULT_DELAY_SECONDS=0

# AI consensus (Ghost Guard)
AI_GUARDIAN_L1_ADDRESS=
AI_GUARDIAN_L2_ADDRESS=
AI_GUARDIAN_L3_ADDRESS=
AI_SIGNER_PRIVATE_KEY=
AI_CONSENSUS_MODE=enforce
AI_CONSENSUS_FAIL_OPEN=0
AI_MODEL_ID=GHOST_AI_CONSENSUS_V1
AI_CONFIDENCE_BPS=9000
AI_ATTEST_TTL_SECONDS=300
AI_RISK_REVIEW_BPS=5000
AI_RISK_BLOCK_BPS=8000
AI_REVIEW_DELAY_SECONDS=60
AI_WAIT_CONFIRMATIONS=0
AI_DEFAULT_LAYER=l2
AI_ROLE_LAYER_MAP=batcher:l1,proposer:l1

# Keys (keys/init.sh will regenerate these and set addresses)
# Leave blank here; populate via .env.secrets (ignored by git) or your secrets manager.
SEQUENCER_KEY=
BATCHER_KEY=
PROPOSER_KEY=
CHALLENGER_KEY=

# Governance addresses (optional, used by telemetry/proposal drafts)
GOVERNOR_ADDRESS_L1=
PAUSE_GUARDIAN_ADDRESS=

# Scaling hooks (bridge + output oracles for telemetry)
BRIDGE_L2L3_ADDRESS=
L2_OUTPUT_ORACLE_ADDRESS=
L3_OUTPUT_ORACLE_ADDRESS=
L2_OUTPUT_ORACLE_RPC=
L3_OUTPUT_ORACLE_RPC=

# Rollup config parameters (defaults are dev-friendly)
L2_CHAIN_ID=901
L1_CHAIN_ID=14000101
SEQUENCER_ADDRESS=
BATCH_SENDER_ADDRESS=
PROPOSER_ADDRESS=
CHALLENGER_ADDRESS=
# Execution config (applied during deploy_futuristic_stack.ts)
BLOCK_GAS_LIMIT=30000000
BASE_FEE_GWEI=1
ELASTICITY_MULTIPLIER=2
BASE_FEE_MAX_CHANGE_DENOMINATOR=8
# Tokenomics / fee model knobs (FeeMarketV2 + Stablecoin system)
FEE_MARKET_BASE_FEE_GWEI=1
FEE_MARKET_PRIORITY_FEE_GWEI=1
FEE_MARKET_TARGET_GAS=15000000
FEE_MARKET_ADJUSTMENT_BPS=100
STABLE_COLLATERAL_RATIO_BPS=15000
PSM_FEE_BPS=30
# Comma-separated precompile addresses (optional).
PRECOMPILES=
# Transfer AccessManaged admin for execution configs to GovernorV2.
TRANSFER_ADMIN_TO_GOVERNOR=true
# L1 confirmation depth for sequencer derivation; bumping reduces temporary receipt races.
SEQUENCER_L1_CONFS=2
L3_SEQUENCER_L1_CONFS=2

# Canonical gas token lock (L1/L2/L3). Deploy scripts refuse non-canonical tokens and will not redeploy.
USE_CUSTOM_GAS_TOKEN=true
CUSTOM_GAS_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
GAS_TOKEN_NAME="Ghost Token (L1)"
GAS_TOKEN_SYMBOL=GHOST
GAS_TOKEN_DECIMALS=18
GAS_TOKEN_INITIAL_SUPPLY=1000000000000000000000000000
GAS_TOKEN_RECIPIENT=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266
GAS_TOKEN_L1=GHOST
GAS_TOKEN_L2=GHOST
GAS_TOKEN_L3=GHOST

# Ghost gas engine (AI economics)
GAS_ENGINE_DB_PASSWORD=ghostpass
GAS_ENGINE_SEED_SAMPLE_DATA=true
GAS_ENGINE_ADMIN_TOKEN=
GAS_ENGINE_SIGNER_PRIVATE_KEY=
GAS_ENGINE_SIGNER_PRIVATE_KEY_L1=
GAS_ENGINE_SIGNER_PRIVATE_KEY_L2=
GAS_ENGINE_SIGNER_PRIVATE_KEY_L3=

# Dispute / challenger (L2 + L3)
L2_GAME_FACTORY_ADDRESS=0xa79c78bcb7c9a77f962638cee8f80f39a91f2dc3
L3_GAME_FACTORY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
L2_CHALLENGER_TRACE_TYPE=cannon
L3_CHALLENGER_TRACE_TYPE=cannon
L2_CHALLENGER_METRICS_HOST_PORT=7303
L3_CHALLENGER_METRICS_HOST_PORT=8303
# Cannon/Kona assets (used by challenger overlay; host paths are mounted to /assets)
OP_CHALLENGER_ASSETS_DIR=./optimism/op-program/bin
OP_CHALLENGER_CANNON_PRESTATE=/assets/op-program/prestate-mt64.bin.gz
OP_CHALLENGER_CANNON_KONA_PRESTATE=/assets/op-program/prestate-mt64.bin.gz
OP_CHALLENGER_CANNON_SERVER=/assets/op-program/op-program
OP_CHALLENGER_CANNON_BIN=/assets/cannon/cannon

# Hardhat convenience (consumed in contracts/hardhat.config.ts)
OP_L2_RPC=http://localhost:29547
OP_L2_CHAIN_ID=901
OP_L3_RPC=http://localhost:39545
OP_L3_CHAIN_ID=903

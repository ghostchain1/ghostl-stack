# OP Stack devnet sample env (copy to .env.local or .env)

# RPCs
L1_RPC=http://host.docker.internal:18545
L2_RPC=http://ghost-exec-l2:7260
HOST_L1_RPC=http://localhost:18545
HOST_L2_RPC=http://localhost:29547
HOST_L3_RPC=http://localhost:39545
OP_NODE_PROXY_HOST_PORT=29546
OP_SEQUENCER_PROXY_HOST_PORT=29646
L3_OP_NODE_DIRECT_RPC_PORT=39646
L3_ROLLUP_RPC_HOST_PORT=39546
L2OO_ADDRESS=0x0E801D84Fa97b50751Dbf25036d067dCf18858bF

# Keys (replace with your own; keep secrets out of VCS)
SEQUENCER_KEY=
BATCHER_KEY=
PROPOSER_KEY=
CHALLENGER_KEY=

# Rollup config parameters
L2_CHAIN_ID=901
L1_CHAIN_ID=14000101
SEQUENCER_ADDRESS=
BATCH_SENDER_ADDRESS=
PROPOSER_ADDRESS=
CHALLENGER_ADDRESS=
GAME_FACTORY_ADDRESS=
# Execution + tokenomics config (deploy_futuristic_stack.ts)
BLOCK_GAS_LIMIT=30000000
BASE_FEE_GWEI=1
ELASTICITY_MULTIPLIER=2
BASE_FEE_MAX_CHANGE_DENOMINATOR=8
FEE_MARKET_BASE_FEE_GWEI=1
FEE_MARKET_PRIORITY_FEE_GWEI=1
FEE_MARKET_TARGET_GAS=15000000
FEE_MARKET_ADJUSTMENT_BPS=100
STABLE_COLLATERAL_RATIO_BPS=15000
PSM_FEE_BPS=30
TRANSFER_ADMIN_TO_GOVERNOR=true
# Governance + telemetry hooks
GOVERNOR_ADDRESS_L1=
PAUSE_GUARDIAN_ADDRESS=
BRIDGE_L2L3_ADDRESS=0xDadd1125B8Df98A66Abd5EB302C0d9Ca5A061dC2
L1_ROLLUP_L2_ADDRESS=0xad32D5C2Da9f4159C4cc98686C005852b3905355
L1_ROLLUP_PARENT_ORACLE=0x2C001131e99c79e6dDF9f099F2101e9535172Db1
L2_ROLLUP_L3_ADDRESS=0x130A46b6E41DB6E1e18fb9c759F223c459190e90
L1_FINALITY_ORACLE_ADDRESS=0x7B3Be2dDDdDf9A0a3fE1DC57B98980F662C3a422
L2_FINALITY_ORACLE_ADDRESS=0x650aEF4b63095e4EDe581BC79CdeA927e3ba553A
L3_FINALITY_ORACLE_ADDRESS=0x87F850cbC2cFfac086F20d0d7307E12d06fA2127
L3_INBOX_ADDRESS=0x8464135c8F25Da09e49BC8782676a84730C318bC
L3_TOKEN_FACTORY_ADDRESS=0x71C95911E9a5D330f4D621842EC243EE1343292e
L2_OUTPUT_ORACLE_ADDRESS=
L3_OUTPUT_ORACLE_ADDRESS=
L2_OUTPUT_ORACLE_RPC=
L3_OUTPUT_ORACLE_RPC=
# L1 confirmation depth for sequencer derivation; bumping reduces temporary receipt races.
SEQUENCER_L1_CONFS=2
L3_SEQUENCER_L1_CONFS=2

# Optional overrides for OP Stack base images
FOUNDRY_IMAGE=ghcr.io/foundry-rs/foundry@sha256:465bdc521c1775b5b720e61f1ddd5946fc51f507ae15cd173650b7e5c9a712d6
OP_STACK_BASE_IMAGE=node:22-alpine3.23
OPSTACK_IMAGE_TAG=devnet
PROMETHEUS_IMAGE=prom/prometheus@sha256:075b1ba2c4ebb04bc3a6ab86c06ec8d8099f8fda1c96ef6d104d9bb1def1d8bc
GRAFANA_IMAGE=grafana/grafana@sha256:408afb9726de5122b00a2576763a8a57a3c86d5b0eff5305bc994ceb3eb96c3f
ALERTMANAGER_SOVEREIGNTY_CRITICAL_WEBHOOK_URL=http://host.docker.internal:19093/alert-hooks/sovereignty-critical
ALERTMANAGER_SOVEREIGNTY_WARNING_WEBHOOK_URL=http://host.docker.internal:19093/alert-hooks/sovereignty-warning

# Gate (Guard-aware JSON-RPC proxy)
OP_GATE_IMAGE=local/op-gate:0.1.0
GATE_PORT=8545
GATE_UPSTREAM_RPC=http://ghost-exec-l2:7260
GATE_GUARD_URL=http://host.docker.internal:7070
GATE_ADMIN_TOKEN=
GATE_ALLOW_INSECURE_ADMIN=0
GATE_DEFAULT_DELAY_SECONDS=0
GATE_L1_PORT=8545
GATE_L1_UPSTREAM_RPC=http://l1-rpc-proxy:18546
GATE_L1_GUARD_URL=http://host.docker.internal:7070
GATE_L1_ADMIN_TOKEN=
GATE_L1_ALLOW_INSECURE_ADMIN=0
GATE_L1_DEFAULT_DELAY_SECONDS=0

# AI consensus (Ghost Guard)
AI_GUARDIAN_L1_ADDRESS=
AI_GUARDIAN_L2_ADDRESS=
AI_GUARDIAN_L3_ADDRESS=
AI_SIGNER_PRIVATE_KEY=
AI_CONSENSUS_MODE=enforce
AI_CONSENSUS_FAIL_OPEN=0
AI_MODEL_ID=GHOST_AI_CONSENSUS_V1
AI_CONFIDENCE_BPS=9000
AI_ATTEST_TTL_SECONDS=300
AI_RISK_REVIEW_BPS=5000
AI_RISK_BLOCK_BPS=8000
AI_REVIEW_DELAY_SECONDS=60
AI_WAIT_CONFIRMATIONS=0
AI_DEFAULT_LAYER=l2
AI_ROLE_LAYER_MAP=batcher:l1,proposer:l1

# OP L2/L3 RPCs for hardhat deployments
OP_L2_RPC=http://localhost:29547
OP_L2_CHAIN_ID=901
OP_L3_RPC=http://localhost:39545
OP_L3_CHAIN_ID=903

# Canonical gas token labels + address
CANONICAL_GAS_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
CUSTOM_GAS_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
GAS_TOKEN_L1=GST
GAS_TOKEN_L2=GST
GAS_TOKEN_L3=GST

# Ghost gas engine (AI economics)
GAS_ENGINE_DB_PASSWORD=ghostpass
GAS_ENGINE_SEED_SAMPLE_DATA=true
GAS_ENGINE_ADMIN_TOKEN=
GAS_ENGINE_SIGNER_PRIVATE_KEY=
GAS_ENGINE_SIGNER_PRIVATE_KEY_L1=
GAS_ENGINE_SIGNER_PRIVATE_KEY_L2=
GAS_ENGINE_SIGNER_PRIVATE_KEY_L3=

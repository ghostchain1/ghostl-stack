L2_ENV=dev
L2_SECRETS_SOURCE=dev
ALLOW_DEV_SECRETS=1
L2_SECRETS_DIR=./secrets
L2_REQUIRE_L2_PROGRESS=0
L2_MAX_L1_DERIVATION_LAG=128
L2_MAX_L2_SAFE_LAG=256
L2_MAX_BATCHER_IDLE_SECONDS=900
L2_MAX_PROPOSER_IDLE_SECONDS=900
# OP Stack devnet sample env
# Copy to infra/opstack/.env and adjust as needed. Put secrets/keys in .env.secrets (ignored by git).

OPSTACK_IMAGE_TAG=local
OPSTACK_UID=1003
OPSTACK_GID=1003

# Internal Docker hostnames
L1_RPC=http://host.docker.internal:28545
L1_RPC_UPSTREAM=http://host.docker.internal:28545
L1_RPC_DOCKER=http://l1-rpc-proxy:18546
L2_RPC=http://l2-geth:8545

# Host-facing RPCs (ports exposed by docker-compose)
HOST_L1_RPC=http://localhost:18545
HOST_L2_RPC=http://localhost:29547
# Placeholder for future L3 OP Stack chain on GhostL2
HOST_L3_RPC=http://localhost:39545
L3_GUARD_FAIL_OPEN=false

# Archive/trace RPCs (op-geth runs with --gcmode=archive and debug enabled)
L2_ARCHIVE_RPC=http://l2-geth:8545
L2_ARCHIVE_WS=ws://l2-geth:8546
L3_ARCHIVE_RPC=http://l3-geth:8545
L3_ARCHIVE_WS=ws://l3-geth:8546
HOST_L2_ARCHIVE_RPC=http://localhost:29547
HOST_L3_ARCHIVE_RPC=http://localhost:39545
L2_HOST_WS=29548

# Images (pin to deterministic tags/digests)
FOUNDRY_IMAGE=ghcr.io/foundry-rs/foundry:nightly-2024-09-18
OP_GATE_IMAGE=local/op-gate:0.1.0
OP_STACK_BASE_IMAGE=node:22-alpine3.19
PROMETHEUS_IMAGE=prom/prometheus:v2.53.0
GRAFANA_IMAGE=grafana/grafana:11.2.0

# Use a non-default deployer to avoid contract address collisions with system predeploys.

# Gate (Guard-aware JSON-RPC proxy for op-batcher/proposer)
GATE_PORT=8545
GATE_UPSTREAM_RPC=http://l2-geth:8545
GATE_GUARD_URL=http://ghost-guard:7070
GATE_ALLOW_INSECURE_ADMIN=0
GATE_DEFAULT_DELAY_SECONDS=0
GATE_L1_PORT=8545
GATE_L1_UPSTREAM_RPC=http://l1-rpc-proxy:18546
GATE_L1_GUARD_URL=http://ghost-guard:7070
GATE_L1_ALLOW_INSECURE_ADMIN=0
GATE_L1_DEFAULT_DELAY_SECONDS=0

# AI consensus (Ghost Guard)
AI_GUARDIAN_L1_ADDRESS=
AI_GUARDIAN_L2_ADDRESS=
AI_GUARDIAN_L3_ADDRESS=
AI_CONSENSUS_MODE=enforce
AI_CONSENSUS_FAIL_OPEN=0
AI_MODEL_ID=GHOST_AI_CONSENSUS_V1
AI_CONFIDENCE_BPS=9000
AI_ATTEST_TTL_SECONDS=300
AI_RISK_REVIEW_BPS=5000
AI_RISK_BLOCK_BPS=8000
AI_REVIEW_DELAY_SECONDS=60
AI_WAIT_CONFIRMATIONS=0
AI_DEFAULT_LAYER=l2
AI_ROLE_LAYER_MAP=batcher:l1,proposer:l1
AI_MONITOR_OBSERVE_ONLY=1
AI_MONITOR_SIMULATION_ENABLED=0
AI_MONITOR_LAYER_L2=L2
AI_MONITOR_ADMIN_TOKEN=
AI_MONITOR_URL=http://localhost:7575/health
AI_MONITOR_REQUIRED=0
AI_MONITOR_L1_HEAD_LAG_THRESHOLD_SEC=120
AI_MONITOR_BATCHER_IDLE_THRESHOLD_SEC=900
AI_MONITOR_PROPOSER_IDLE_THRESHOLD_SEC=900
POLICY_REGISTRY_ADDRESS=
POLICY_REGISTRY_RPC=${HOST_L1_RPC}
POLICY_ROLE=L2_AI_MONITOR
POLICY_ACTION_THROTTLE=L2_AI_THROTTLE
POLICY_ACTION_PAUSE=L2_AI_PAUSE
POLICY_APPROVALS_PROVIDED=0
POLICY_HAS_EVIDENCE=0
POLICY_REQUIRED=1
POLICY_CACHE_MS=10000
CHAIN_POLICY_REGISTRY_ADDRESS=
CHAIN_POLICY_REGISTRY_RPC=${HOST_L1_RPC}
CHAIN_POLICY_REQUIRED=1
CHAIN_POLICY_CACHE_MS=15000

# Keys (keys/init.sh will regenerate these and set addresses)
# Leave blank here; populate via .env.secrets (ignored by git) or your secrets manager.

# Rollup config parameters (defaults are dev-friendly)
L2_CHAIN_ID=901
L1_CHAIN_ID=14000101
SEQUENCER_ADDRESS=0x7964ef0fBD1306461bab9Ad05118DBC4248D0546
BATCH_SENDER_ADDRESS=0xC1815FEE48bBb95Cf6b0D6d8d4FeE8B7cB5E016e
PROPOSER_ADDRESS=0x67392bb63483C52F39b948C645f145E9c88e1B09
CHALLENGER_ADDRESS=0xb13A5FA2E2D56fa89faC31A1430c1e3300694E95
PROPOSAL_INTERVAL=30s
# L1 confirmation depth for sequencer derivation; bumping reduces temporary receipt races.
SEQUENCER_L1_CONFS=0
L3_SEQUENCER_L1_CONFS=0

# Custom gas token (L2/L3). Used by infra/opstack/contracts/script/DeployL1.s.sol.
USE_CUSTOM_GAS_TOKEN=true
CUSTOM_GAS_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
GAS_TOKEN_NAME="Ghost Token (L1)"
GAS_TOKEN_SYMBOL=GHOST
GAS_TOKEN_DECIMALS=18
GAS_TOKEN_INITIAL_SUPPLY=1000000000000000000000000000
GAS_TOKEN_RECIPIENT=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266

# Dispute / challenger (L2 + L3)
# Values sourced from infra/opstack/config/*deployments.json after running deploy tooling.
L2OO_ADDRESS=0x0Cf17D5DcDA9cF25889cEc9ae5610B0FB9725F65
L2_GAME_FACTORY_ADDRESS=0x05Aa229Aec102f78CE0E852A812a388F076Aa555

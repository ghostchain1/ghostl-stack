# OP Stack Sepolia template (no secrets committed)
# Fill RPC keys, private keys, chain IDs, and batch inbox before use.

L1_RPC=https://eth-sepolia.g.alchemy.com/v2/REPLACE_ME
L1_CHAIN_ID=11155111

# GhostL2 / GhostL3 defaults (override with your hosted RPCs)
L2_CHAIN_ID=901
L3_CHAIN_ID=903
L2_RPC=http://localhost:29547
L3_RPC=http://localhost:39545

# Execution keys (store in Vault/KMS in production)
SEQUENCER_KEY=REPLACE_ME
BATCHER_KEY=REPLACE_ME
PROPOSER_KEY=REPLACE_ME
CHALLENGER_KEY=REPLACE_ME
# L1 confirmation depth for sequencer derivation; bumping reduces temporary receipt races.
SEQUENCER_L1_CONFS=2
L3_SEQUENCER_L1_CONFS=2

# L1 contract addresses (Optimism Sepolia)
OP_PORTAL_ADDRESS=0x16Fc5058F25648194471939df75CF27A2fdC48BC
L2OO_ADDRESS=0xFf00000000000000000000000000000000000001
SYSTEM_CONFIG_ADDRESS=0x034edD2a225f7f429a63e0f1d2084b9e0a93b538
DISPUTE_GAME_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# Replace with your batch inbox address from deployment artifacts
BATCH_INBOX_ADDRESS=0x0000000000000000000000000000000000000000

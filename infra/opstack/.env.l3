# OP Stack L3-on-L2 template (no secrets committed)
# Parent (L2) contracts are required. Fill RPC keys, private keys, chain IDs, and batch inbox before use.

# Parent L2 (acts as L1 for this L3)
PARENT_L2_RPC=http://localhost:29547
PARENT_L2_CHAIN_ID=901

# Child L3
L3_RPC=http://localhost:39545
L3_CHAIN_ID=903
# L1 confirmation depth for L3 sequencer derivation; bumping reduces temporary receipt races.
L3_SEQUENCER_L1_CONFS=2

# Execution keys (store in .env.secrets or Vault/KMS in production)
# SEQUENCER_KEY=...
# BATCHER_KEY=...
# PROPOSER_KEY=...
# CHALLENGER_KEY=...

# Parent L2 contract addresses (portal/L2OO/SystemConfig deployed on L2)
L3_PORTAL_ADDRESS=0xbCF26943C0197d2eE0E5D05c716Be60cc2761508
L3_L2OO_ADDRESS=0x1275D096B9DBf2347bD2a131Fb6BDaB0B4882487
L3_SYSTEM_CONFIG_ADDRESS=0x712516e61C8B383dF4A63CFe83d7701Bce54B03e
L3_DISPUTE_GAME_FACTORY_ADDRESS=0x05Aa229Aec102f78CE0E852A812a388F076Aa555

# Replace with your batch inbox address from deployment artifacts (on parent L2)
BATCH_INBOX_ADDRESS=0x21b6ffeecf77ac42acc5b30b515b50be293f5ddb
# Local L2 Output Oracle (Anvil)
L2OO_ADDRESS=0x1275D096B9DBf2347bD2a131Fb6BDaB0B4882487
PROPOSER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
L3_GAME_FACTORY_ADDRESS=0x05Aa229Aec102f78CE0E852A812a388F076Aa555
L3_PARENT_STANDARD_BRIDGE_ADDRESS=0xC6bA8C3233eCF65B761049ef63466945c362EdD2
L3_PARENT_CROSS_DOMAIN_MESSENGER_ADDRESS=0x59F2f1fCfE2474fD5F0b9BA1E73ca90b143Eb8d0

# Governance wiring per layer (optional)
GOVERNOR_ADDRESS_L2=
EXECUTOR_ADDRESS_L2=
UPGRADE_MANAGER_ADDRESS_L2=
GOVERNOR_ADDRESS_L3=
EXECUTOR_ADDRESS_L3=
UPGRADE_MANAGER_ADDRESS_L3=

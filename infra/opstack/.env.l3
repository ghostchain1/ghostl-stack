# OP Stack L3-on-L2 template (no secrets committed)
# Parent (L2) contracts are required. Fill RPC keys, private keys, chain IDs, and batch inbox before use.

# Parent L2 (acts as L1 for this L3)
PARENT_L2_RPC=http://127.0.0.1:40545
PARENT_L2_CHAIN_ID=31337

# Child L3
L3_RPC=http://localhost:10545
L3_CHAIN_ID=7393
# L1 confirmation depth for L3 sequencer derivation; bumping reduces temporary receipt races.
L3_SEQUENCER_L1_CONFS=2

# Execution keys (store in .env.secrets or Vault/KMS in production)
# SEQUENCER_KEY=...
# BATCHER_KEY=...
# PROPOSER_KEY=...
# CHALLENGER_KEY=...

# Parent L2 contract addresses (portal/L2OO/SystemConfig deployed on L2)
L3_PORTAL_ADDRESS=0xC6bA8C3233eCF65B761049ef63466945c362EdD2
L3_L2OO_ADDRESS=0x0b48aF34f4c854F5ae1A3D587da471FeA45bAD52
L3_SYSTEM_CONFIG_ADDRESS=0x59F2f1fCfE2474fD5F0b9BA1E73ca90b143Eb8d0
L3_DISPUTE_GAME_FACTORY_ADDRESS=0x0f5D1ef48f12b6f691401bfe88c2037c690a6afe

# Replace with your batch inbox address from deployment artifacts (on parent L2)
BATCH_INBOX_ADDRESS=0x0000000000000000000000000000000000000000
# Local L2 Output Oracle (Anvil)
L2OO_ADDRESS=0x0b48aF34f4c854F5ae1A3D587da471FeA45bAD52
PROPOSER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
L3_GAME_FACTORY_ADDRESS=0x0f5D1ef48f12b6f691401bfe88c2037c690a6afe
L3_PARENT_STANDARD_BRIDGE_ADDRESS=0x05Aa229Aec102f78CE0E852A812a388F076Aa555
L3_PARENT_CROSS_DOMAIN_MESSENGER_ADDRESS=0x1275D096B9DBf2347bD2a131Fb6BDaB0B4882487

## infra/opstack/l3/ghostsample/.env.example
# Local-only L3 sample env. Copy to infra/opstack/l3/ghostsample/.env (gitignored) and fill in.

NODE_ENV=dev
SERVICE_NAME=ghostsample

L3_NAME=ghostsample
L3_CHAIN_ID=902

# Host-facing ports
L3_HOST_RPC=39545
L3_HOST_WS=39548

# Parent (L2)
L3_L1_CHAIN_ID=901
L3_SEQUENCER_L1_CONFS=2
L3_L1_RPC=http://ghost-exec-l2:7260

# Rollup service ports
L3_ROLLUP_RPC_HOST_PORT=39546
L3_BATCHER_HOST_PORT=39551
L3_PROPOSER_HOST_PORT=39560

# Metrics ports
L3_METRICS_NODE_HOST_PORT=8300
L3_METRICS_BATCHER_HOST_PORT=8301
L3_METRICS_PROPOSER_HOST_PORT=8302

# Keys (do not commit; store in Vault/KMS in prod)
L3_BATCHER_KEY=
L3_PROPOSER_KEY=

# Contracts (populate from deployment artifacts)
L3_L2OO_ADDRESS=0x0000000000000000000000000000000000000000

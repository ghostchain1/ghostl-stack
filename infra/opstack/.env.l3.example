# OP Stack L3-on-L2 template (no secrets committed)
# Parent (L2) contracts are required. Fill RPC keys, private keys, chain IDs, and batch inbox before use.

# Parent L2 (acts as L1 for this L3)
PARENT_L2_RPC=http://localhost:9545
PARENT_L2_CHAIN_ID=7192

# Child L3
L3_RPC=http://localhost:10545
L3_CHAIN_ID=7393

# Execution keys (store in Vault/KMS in production)
SEQUENCER_KEY=REPLACE_ME
BATCHER_KEY=REPLACE_ME
PROPOSER_KEY=REPLACE_ME
CHALLENGER_KEY=REPLACE_ME

# Parent L2 contract addresses (portal/L2OO/SystemConfig deployed on L2)
L3_PORTAL_ADDRESS=0x0000000000000000000000000000000000000000
L3_L2OO_ADDRESS=0x0000000000000000000000000000000000000000
L3_SYSTEM_CONFIG_ADDRESS=0x0000000000000000000000000000000000000000
L3_DISPUTE_GAME_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# Replace with your batch inbox address from deployment artifacts (on parent L2)
BATCH_INBOX_ADDRESS=0x0000000000000000000000000000000000000000
# Local L2 Output Oracle (Anvil)
L2OO_ADDRESS=0x8f86403A4DE0BB5791fa46B8e795C547942fE4Cf
PROPOSER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

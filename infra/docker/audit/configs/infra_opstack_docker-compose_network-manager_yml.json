{
  "name": "opstack",
  "services": {
    "network-manager": {
      "command": [
        "/usr/local/bin/network-manager.sh"
      ],
      "container_name": "opstack-network-manager",
      "entrypoint": [
        "/bin/sh",
        "-c"
      ],
      "image": "alpine:3.19",
      "network_mode": "host",
      "pid": "host",
      "restart": "unless-stopped",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./bin/network-manager.sh",
          "target": "/usr/local/bin/network-manager.sh",
          "type": "bind"
        }
      ]
    }
  }
}
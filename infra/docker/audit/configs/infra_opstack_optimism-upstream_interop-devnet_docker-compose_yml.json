{
  "name": "interop-devnet",
  "networks": {
    "default": {
      "name": "interop-devnet_default"
    }
  },
  "services": {
    "grafana": {
      "env_file": [
        {
          "path": "monitoring/grafana.env",
          "required": true
        }
      ],
      "image": "grafana/grafana:11.1.0",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "3300",
          "target": 3000
        }
      ],
      "restart": "unless-stopped",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./monitoring/grafana/provisioning/",
          "target": "/etc/grafana/provisioning",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "source": "./monitoring/grafana/dashboards",
          "target": "/var/lib/grafana/dashboards",
          "type": "bind"
        }
      ]
    },
    "l1": {
      "build": {
        "context": "../ops-bedrock",
        "dockerfile": "l1-geth.Dockerfile"
      },
      "environment": {
        "GETH_MINER_RECOMMIT": "100ms"
      },
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8545",
          "target": 8545
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8546",
          "target": 8546
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7060",
          "target": 6060
        }
      ],
      "volumes": [
        {
          "source": "l1_data",
          "target": "/db",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../.devnet-interop/genesis/l1/genesis.json",
          "target": "/genesis.json",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../ops-bedrock/test-jwt-secret.txt",
          "target": "/config/jwt-secret.txt",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "l1-bn": {
      "build": {
        "context": "../ops-bedrock",
        "dockerfile": "l1-lighthouse.Dockerfile"
      },
      "depends_on": {
        "l1": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": [
        "/bin/sh",
        "/entrypoint-bn.sh"
      ],
      "environment": {
        "LH_EXECUTION_ENDPOINT": "http://l1:8551"
      },
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "9000",
          "target": 9000
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "5052",
          "target": 5052
        }
      ],
      "volumes": [
        {
          "source": "l1_bn_data",
          "target": "/db",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../ops-bedrock/test-jwt-secret.txt",
          "target": "/config/jwt-secret.txt",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../ops-bedrock/beacon-data/config.yaml",
          "target": "/genesis/config.yaml",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../ops-bedrock/beacon-data/deposit_contract_block.txt",
          "target": "/genesis/deposit_contract_block.txt",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../.devnet-interop/genesis/l1/beaconstate.ssz",
          "target": "/genesis/genesis.ssz",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "l1-vc": {
      "build": {
        "context": "../ops-bedrock",
        "dockerfile": "l1-lighthouse.Dockerfile"
      },
      "depends_on": {
        "l1": {
          "condition": "service_started",
          "required": true
        },
        "l1-bn": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": [
        "/bin/sh",
        "/entrypoint-vc.sh"
      ],
      "environment": {
        "LH_BEACON_NODES": "http://l1-bn:5052/"
      },
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "source": "l1_vc_data",
          "target": "/db",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../ops-bedrock/beacon-data/data/keys",
          "target": "/validator_setup/validators",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../ops-bedrock/beacon-data/data/secrets",
          "target": "/validator_setup/secrets",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../ops-bedrock/beacon-data/config.yaml",
          "target": "/genesis/config.yaml",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../ops-bedrock/beacon-data/deposit_contract_block.txt",
          "target": "/genesis/deposit_contract_block.txt",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../.devnet-interop/genesis/l1/beaconstate.ssz",
          "target": "/genesis/genesis.ssz",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "l2-a": {
      "build": {
        "context": "../ops-bedrock/",
        "dockerfile": "l2-op-geth-interop.Dockerfile"
      },
      "depends_on": {
        "op-supervisor": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": [
        "/bin/sh",
        "/entrypoint.sh"
      ],
      "environment": {
        "GETH_MINER_RECOMMIT": "100ms",
        "GETH_ROLLUP_INTEROPRPC": "ws://op-supervisor:8545"
      },
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "9145",
          "target": 8545
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8160",
          "target": 6060
        }
      ],
      "volumes": [
        {
          "source": "l2_a_data",
          "target": "/db",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../.devnet-interop/genesis/l2/900200/genesis.json",
          "target": "/genesis.json",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../ops-bedrock/test-jwt-secret.txt",
          "target": "/config/jwt-secret.txt",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "l2-b": {
      "build": {
        "context": "../ops-bedrock/",
        "dockerfile": "l2-op-geth-interop.Dockerfile"
      },
      "depends_on": {
        "op-supervisor": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": [
        "/bin/sh",
        "/entrypoint.sh"
      ],
      "environment": {
        "GETH_MINER_RECOMMIT": "100ms",
        "GETH_ROLLUP_INTEROPRPC": "ws://op-supervisor:8545"
      },
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "9245",
          "target": 8545
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8260",
          "target": 6060
        }
      ],
      "volumes": [
        {
          "source": "l2_b_data",
          "target": "/db",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../.devnet-interop/genesis/l2/900201/genesis.json",
          "target": "/genesis.json",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../ops-bedrock/test-jwt-secret.txt",
          "target": "/config/jwt-secret.txt",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "loki": {
      "command": "-config.file=/etc/loki/config.yaml",
      "image": "grafana/loki:3.1.1",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "3200",
          "target": 3200
        }
      ],
      "restart": "unless-stopped",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "source": "./monitoring/loki",
          "target": "/etc/loki",
          "type": "bind"
        }
      ]
    },
    "op-batcher-a": {
      "build": {
        "context": "../",
        "dockerfile": "ops/docker/op-stack-go/Dockerfile",
        "target": "op-batcher-target"
      },
      "depends_on": {
        "l1": {
          "condition": "service_started",
          "required": true
        },
        "l2-a": {
          "condition": "service_started",
          "required": true
        },
        "op-node-a": {
          "condition": "service_started",
          "required": true
        }
      },
      "env_file": [
        {
          "path": "${PWD}/../.devnet-interop/env/l2/900200/op-batcher.env",
          "required": true
        }
      ],
      "environment": {
        "OP_BATCHER_BATCH_TYPE": null,
        "OP_BATCHER_L1_ETH_RPC": "http://l1:8545",
        "OP_BATCHER_L2_ETH_RPC": "http://l2-a:8545",
        "OP_BATCHER_MAX_CHANNEL_DURATION": 2,
        "OP_BATCHER_METRICS_ENABLED": "true",
        "OP_BATCHER_NUM_CONFIRMATIONS": 1,
        "OP_BATCHER_POLL_INTERVAL": "1s",
        "OP_BATCHER_PPROF_ENABLED": "true",
        "OP_BATCHER_ROLLUP_RPC": "http://op-node-a:8545",
        "OP_BATCHER_RPC_ENABLE_ADMIN": "true",
        "OP_BATCHER_SUB_SAFETY_MARGIN": 4
      },
      "image": "us-docker.pkg.dev/oplabs-tools-artifacts/images/op-batcher:devnet",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "6161",
          "target": 6060
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7101",
          "target": 7300
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "6145",
          "target": 8545
        }
      ]
    },
    "op-batcher-b": {
      "build": {
        "context": "../",
        "dockerfile": "ops/docker/op-stack-go/Dockerfile",
        "target": "op-batcher-target"
      },
      "depends_on": {
        "l1": {
          "condition": "service_started",
          "required": true
        },
        "l2-b": {
          "condition": "service_started",
          "required": true
        },
        "op-node-b": {
          "condition": "service_started",
          "required": true
        }
      },
      "env_file": [
        {
          "path": "${PWD}/../.devnet-interop/env/l2/900201/op-batcher.env",
          "required": true
        }
      ],
      "environment": {
        "OP_BATCHER_BATCH_TYPE": null,
        "OP_BATCHER_L1_ETH_RPC": "http://l1:8545",
        "OP_BATCHER_L2_ETH_RPC": "http://l2-b:8545",
        "OP_BATCHER_MAX_CHANNEL_DURATION": 2,
        "OP_BATCHER_METRICS_ENABLED": "true",
        "OP_BATCHER_NUM_CONFIRMATIONS": 1,
        "OP_BATCHER_POLL_INTERVAL": "1s",
        "OP_BATCHER_PPROF_ENABLED": "true",
        "OP_BATCHER_ROLLUP_RPC": "http://op-node-b:8545",
        "OP_BATCHER_RPC_ENABLE_ADMIN": "true",
        "OP_BATCHER_SUB_SAFETY_MARGIN": 4
      },
      "image": "us-docker.pkg.dev/oplabs-tools-artifacts/images/op-batcher:devnet",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "6261",
          "target": 6060
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7201",
          "target": 7300
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "6245",
          "target": 8545
        }
      ]
    },
    "op-node-a": {
      "build": {
        "context": "../",
        "dockerfile": "ops/docker/op-stack-go/Dockerfile",
        "target": "op-node-target"
      },
      "command": "op-node --l1=ws://l1:8546 --l1.beacon=http://l1-bn:5052 --l1.epoch-poll-interval=12s --l1.http-poll-interval=6s --l2=http://l2-a:8551 --l2.jwt-secret=/config/jwt-secret.txt --supervisor=http://op-supervisor:8545 --sequencer.enabled --sequencer.l1-confs=0 --verifier.l1-confs=0 --rollup.config=/rollup.json --rpc.addr=0.0.0.0 --rpc.port=8545 --p2p.listen.ip=0.0.0.0 --p2p.listen.tcp=9003 --p2p.listen.udp=9003 --p2p.scoring.peers=light --p2p.ban.peers=true --metrics.enabled --metrics.addr=0.0.0.0 --metrics.port=7300 --pprof.enabled --rpc.enable-admin --safedb.path=/db\n",
      "depends_on": {
        "l1": {
          "condition": "service_started",
          "required": true
        },
        "l1-bn": {
          "condition": "service_started",
          "required": true
        },
        "l1-vc": {
          "condition": "service_started",
          "required": true
        },
        "l2-a": {
          "condition": "service_started",
          "required": true
        },
        "op-supervisor": {
          "condition": "service_started",
          "required": true
        }
      },
      "env_file": [
        {
          "path": "${PWD}/../.devnet-interop/env/l2/900200/op-node.env",
          "required": true
        }
      ],
      "image": "us-docker.pkg.dev/oplabs-tools-artifacts/images/op-node:devnet",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7145",
          "target": 8545
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "9103",
          "target": 9003
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7100",
          "target": 7300
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "6160",
          "target": 6060
        }
      ],
      "volumes": [
        {
          "source": "safedb_a_data",
          "target": "/db",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../ops-bedrock/test-jwt-secret.txt",
          "target": "/config/jwt-secret.txt",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../.devnet-interop/genesis/l2/900200/rollup.json",
          "target": "/rollup.json",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "op_log_a",
          "target": "/op_log",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "op-node-b": {
      "build": {
        "context": "../",
        "dockerfile": "ops/docker/op-stack-go/Dockerfile",
        "target": "op-node-target"
      },
      "command": "op-node --l1=ws://l1:8546 --l1.beacon=http://l1-bn:5052 --l1.epoch-poll-interval=12s --l1.http-poll-interval=6s --l2=http://l2-b:8551 --l2.jwt-secret=/config/jwt-secret.txt --supervisor=http://op-supervisor:8545 --sequencer.enabled --sequencer.l1-confs=0 --verifier.l1-confs=0 --rollup.config=/rollup.json --rpc.addr=0.0.0.0 --rpc.port=8545 --p2p.listen.ip=0.0.0.0 --p2p.listen.tcp=9003 --p2p.listen.udp=9003 --p2p.scoring.peers=light --p2p.ban.peers=true --metrics.enabled --metrics.addr=0.0.0.0 --metrics.port=7300 --pprof.enabled --rpc.enable-admin --safedb.path=/db\n",
      "depends_on": {
        "l1": {
          "condition": "service_started",
          "required": true
        },
        "l1-bn": {
          "condition": "service_started",
          "required": true
        },
        "l1-vc": {
          "condition": "service_started",
          "required": true
        },
        "l2-b": {
          "condition": "service_started",
          "required": true
        },
        "op-supervisor": {
          "condition": "service_started",
          "required": true
        }
      },
      "env_file": [
        {
          "path": "${PWD}/../.devnet-interop/env/l2/900201/op-node.env",
          "required": true
        }
      ],
      "image": "us-docker.pkg.dev/oplabs-tools-artifacts/images/op-node:devnet",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7245",
          "target": 8545
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "9203",
          "target": 9003
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7200",
          "target": 7300
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "6260",
          "target": 6060
        }
      ],
      "volumes": [
        {
          "source": "safedb_b_data",
          "target": "/db",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../ops-bedrock/test-jwt-secret.txt",
          "target": "/config/jwt-secret.txt",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../.devnet-interop/genesis/l2/900201/rollup.json",
          "target": "/rollup.json",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "op_log_b",
          "target": "/op_log",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "op-proposer-a": {
      "build": {
        "context": "../",
        "dockerfile": "ops/docker/op-stack-go/Dockerfile",
        "target": "op-proposer-target"
      },
      "depends_on": {
        "l1": {
          "condition": "service_started",
          "required": true
        },
        "op-node-a": {
          "condition": "service_started",
          "required": true
        }
      },
      "env_file": [
        {
          "path": "${PWD}/../.devnet-interop/env/l2/900200/op-proposer.env",
          "required": true
        }
      ],
      "environment": {
        "OP_PROPOSER_ALLOW_NON_FINALIZED": "true",
        "OP_PROPOSER_GAME_TYPE": "254",
        "OP_PROPOSER_L1_ETH_RPC": "http://l1:8545",
        "OP_PROPOSER_METRICS_ENABLED": "true",
        "OP_PROPOSER_NUM_CONFIRMATIONS": 1,
        "OP_PROPOSER_POLL_INTERVAL": "1s",
        "OP_PROPOSER_PPROF_ENABLED": "true",
        "OP_PROPOSER_PROPOSAL_INTERVAL": "12s",
        "OP_PROPOSER_ROLLUP_RPC": "http://op-node-a:8545",
        "OP_PROPOSER_RPC_ENABLE_ADMIN": "true"
      },
      "image": "us-docker.pkg.dev/oplabs-tools-artifacts/images/op-proposer:devnet",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "6162",
          "target": 6060
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7102",
          "target": 7300
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "6146",
          "target": 8545
        }
      ]
    },
    "op-proposer-b": {
      "build": {
        "context": "../",
        "dockerfile": "ops/docker/op-stack-go/Dockerfile",
        "target": "op-proposer-target"
      },
      "depends_on": {
        "l1": {
          "condition": "service_started",
          "required": true
        },
        "op-node-b": {
          "condition": "service_started",
          "required": true
        }
      },
      "env_file": [
        {
          "path": "${PWD}/../.devnet-interop/env/l2/900201/op-proposer.env",
          "required": true
        }
      ],
      "environment": {
        "OP_PROPOSER_ALLOW_NON_FINALIZED": "true",
        "OP_PROPOSER_GAME_TYPE": "254",
        "OP_PROPOSER_L1_ETH_RPC": "http://l1:8545",
        "OP_PROPOSER_METRICS_ENABLED": "true",
        "OP_PROPOSER_NUM_CONFIRMATIONS": 1,
        "OP_PROPOSER_POLL_INTERVAL": "1s",
        "OP_PROPOSER_PPROF_ENABLED": "true",
        "OP_PROPOSER_PROPOSAL_INTERVAL": "12s",
        "OP_PROPOSER_ROLLUP_RPC": "http://op-node-b:8545",
        "OP_PROPOSER_RPC_ENABLE_ADMIN": "true"
      },
      "image": "us-docker.pkg.dev/oplabs-tools-artifacts/images/op-proposer:devnet",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "6262",
          "target": 6060
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7202",
          "target": 7300
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "6246",
          "target": 8545
        }
      ]
    },
    "op-supervisor": {
      "build": {
        "context": "../",
        "dockerfile": "ops/docker/op-stack-go/Dockerfile",
        "target": "op-supervisor-target"
      },
      "command": "op-supervisor --datadir=\"/db\" --dependency-set=\"/depset.json\" --l2-rpcs=\"\" --rpc.addr=\"0.0.0.0\" --rpc.port=8545 --rpc.enable-admin --l2-rpcs=\"ws://l2-a:8546,ws://l2-b:8546\"\n",
      "depends_on": {
        "l1": {
          "condition": "service_started",
          "required": true
        }
      },
      "environment": {
        "OP_SUPERVISOR_METRICS_ENABLED": "true"
      },
      "image": "us-docker.pkg.dev/oplabs-tools-artifacts/images/op-supervisor:devnet",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "9045",
          "target": 8545
        }
      ],
      "volumes": [
        {
          "source": "supervisor_data",
          "target": "/db",
          "type": "volume",
          "volume": {}
        },
        {
          "bind": {
            "create_host_path": true
          },
          "source": "./depset.json",
          "target": "/depset.json",
          "type": "bind"
        }
      ]
    },
    "prometheus": {
      "command": "--config.file=/etc/prometheus/prometheus.yml --log.level=debug",
      "image": "prom/prometheus:latest",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "3090",
          "target": 9090
        }
      ],
      "restart": "unless-stopped",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "source": "./monitoring/prometheus",
          "target": "/etc/prometheus",
          "type": "bind"
        }
      ]
    },
    "promtail": {
      "command": "-config.file=/etc/promtail/config.yaml",
      "image": "grafana/promtail:3.1.1",
      "networks": {
        "default": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "source": "./monitoring/promtail",
          "target": "/etc/promtail",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "source": "/var/run/docker.sock",
          "target": "/var/run/docker.sock",
          "type": "bind"
        }
      ]
    }
  },
  "volumes": {
    "l1_bn_data": {
      "name": "interop-devnet_l1_bn_data"

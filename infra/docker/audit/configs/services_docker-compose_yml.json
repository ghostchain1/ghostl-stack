      "env_file": [
        {
          "path": "./stack.env",
          "required": true
        }
      ],
      "environment": [
        "PORT=7171",
        "RPC_L1=${RPC_L1}",
        "RPC_L2=${RPC_L2}",
        "RPC_L3=${RPC_L3}",
        "BRIDGE_L2L3_ADDRESS=${BRIDGE_L2L3_ADDRESS}",
        "L1_ROLLUP_L2_ADDRESS=${L1_ROLLUP_L2_ADDRESS}",
        "L2_ROLLUP_L3_ADDRESS=${L2_ROLLUP_L3_ADDRESS}",
        "L3_INBOX_ADDRESS=${L3_INBOX_ADDRESS}",
        "L3_TOKEN_FACTORY_ADDRESS=${L3_TOKEN_FACTORY_ADDRESS}",
        "RELAYER_PRIVATE_KEY=${RELAYER_PRIVATE_KEY}",
        "L2_RELAYER_PRIVATE_KEY=${L2_RELAYER_PRIVATE_KEY}",
        "STATE_DIR=/state"
      ],
      "extra_hosts": [
        "host.docker.internal:host-gateway"
      ],
      "healthcheck": {
        "interval": "15s",
        "retries": 5,
        "test": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:7171/health').then(r=\u003e{if(!r.ok)process.exit(1);return r.json();}).then(j=\u003e{if(!j.ok)process.exit(1);}).catch(()=\u003eprocess.exit(1));\""
        ],
        "timeout": "5s"
      },
      "image": "ghostl/ghost-relayer:local",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7171",
          "target": 7171
        }
      ],

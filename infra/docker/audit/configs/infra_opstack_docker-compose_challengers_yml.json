{
  "name": "opstack",
  "networks": {
    "default": {
      "name": "opstack_default"
    }
  },
  "services": {
    "l3-op-challenger": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "op-challenger",
        "--l1-eth-rpc=${L3_L1_RPC:-http://l2-geth:8545}",
        "--rollup-rpc=http://l3-op-node:${L3_ROLLUP_RPC_PORT:-19546}",
        "--l2-eth-rpc=http://l3-geth:8545",
        "--game-factory-address=${L3_GAME_FACTORY_ADDRESS:-0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0}",
        "--datadir=/data",
        "--private-key=${L3_CHALLENGER_KEY:-${CHALLENGER_KEY:-}}",
        "--trace-type=${L3_CHALLENGER_TRACE_TYPE:-cannon}",
        "--cannon-rollup-config=/config/rollup.json",
        "--cannon-l2-genesis=/config/genesis.json",
        "--metrics.enabled",
        "--metrics.addr=0.0.0.0",
        "--metrics.port=${L3_CHALLENGER_METRICS_PORT:-8303}"
      ],
      "cpus": "0.75",
      "depends_on": {
        "l3-op-node": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": {
        "OP_CHALLENGER_CANNON_BIN": "${OP_CHALLENGER_CANNON_BIN:-/assets/cannon/cannon}",
        "OP_CHALLENGER_CANNON_KONA_PRESTATE": "${OP_CHALLENGER_CANNON_KONA_PRESTATE:-/assets/op-program/prestate-mt64.bin.gz}",
        "OP_CHALLENGER_CANNON_KONA_SERVER": "${OP_CHALLENGER_CANNON_KONA_SERVER:-/usr/local/bin/kona-host}",
        "OP_CHALLENGER_CANNON_L2_GENESIS": "/config/genesis.json",
        "OP_CHALLENGER_CANNON_PRESTATE": "${OP_CHALLENGER_CANNON_PRESTATE:-/assets/op-program/prestate-mt64.bin.gz}",
        "OP_CHALLENGER_CANNON_ROLLUP_CONFIG": "/config/rollup.json",
        "OP_CHALLENGER_CANNON_SERVER": "${OP_CHALLENGER_CANNON_SERVER:-/assets/op-program/op-program}",
        "OP_CHALLENGER_DATADIR": "/data",
        "OP_CHALLENGER_GAME_FACTORY_ADDRESS": "${L3_GAME_FACTORY_ADDRESS:-0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0}",
        "OP_CHALLENGER_L1_BEACON": "${L3_L1_BEACON_RPC:-${L3_L1_RPC:-http://l2-geth:8545}}",
        "OP_CHALLENGER_L1_ETH_RPC": "${L3_L1_RPC:-http://l2-geth:8545}",
        "OP_CHALLENGER_L1_GENESIS": "/config/l1-chain.json",
        "OP_CHALLENGER_L2_ETH_RPC": "http://l3-geth:8545",
        "OP_CHALLENGER_PRIVATE_KEY": "${L3_CHALLENGER_KEY:-${CHALLENGER_KEY:-}}",
        "OP_CHALLENGER_ROLLUP_RPC": "http://l3-op-node:${L3_ROLLUP_RPC_PORT:-19546}",
        "OP_CHALLENGER_TRACE_TYPE": "${L3_CHALLENGER_TRACE_TYPE:-cannon}"
      },
      "image": "${OP_CHALLENGER_IMAGE:-local/op-challenger:${OPSTACK_IMAGE_TAG:-devnet}}",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "1g",
      "networks": {
        "default": null
      },
      "ports": [
        "${L3_CHALLENGER_METRICS_HOST_PORT:-8303}:${L3_CHALLENGER_METRICS_PORT:-8303}"
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "user": "1000:1000",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "source": "./l3/${L3_NAME:-ghostl3}/data/challenger",
          "target": "/data",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./l3/${L3_NAME:-ghostl3}/config/rollup.json",
          "target": "/config/rollup.json",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./l3/${L3_NAME:-ghostl3}/config/genesis.json",
          "target": "/config/genesis.json",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./l3/${L3_NAME:-ghostl3}/config/l1-chain.json",
          "target": "/config/l1-chain.json",
          "type": "bind"
        },
        {
          "read_only": true,
          "source": "${OP_CHALLENGER_ASSETS_DIR:-./optimism/op-program/bin}",
          "target": "/assets/op-program",
          "type": "volume",
          "volume": {}
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./optimism/cannon/bin",
          "target": "/assets/cannon",
          "type": "bind"
        }
      ]
    },
    "op-challenger": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "op-challenger",
        "--l1-eth-rpc=${L1_RPC:-http://l1:8545}",
        "--rollup-rpc=http://op-node:9546",
        "--l2-eth-rpc=http://l2-geth:8545",
        "--game-factory-address=${L2_GAME_FACTORY_ADDRESS:-0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9}",
        "--datadir=/data",
        "--private-key=${CHALLENGER_KEY:-}",
        "--trace-type=${L2_CHALLENGER_TRACE_TYPE:-cannon}",
        "--cannon-rollup-config=/config/rollup.json",
        "--cannon-l2-genesis=/config/genesis-l2.json",
        "--metrics.enabled",
        "--metrics.addr=0.0.0.0",
        "--metrics.port=${L2_CHALLENGER_METRICS_PORT:-7303}"
      ],
      "cpus": "0.75",
      "depends_on": {
        "op-node": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": {
        "OP_CHALLENGER_CANNON_BIN": "${OP_CHALLENGER_CANNON_BIN:-/assets/cannon/cannon}",
        "OP_CHALLENGER_CANNON_KONA_PRESTATE": "${OP_CHALLENGER_CANNON_KONA_PRESTATE:-/assets/op-program/prestate-mt64.bin.gz}",
        "OP_CHALLENGER_CANNON_KONA_SERVER": "${OP_CHALLENGER_CANNON_KONA_SERVER:-/usr/local/bin/kona-host}",
        "OP_CHALLENGER_CANNON_L2_GENESIS": "/config/genesis-l2.json",
        "OP_CHALLENGER_CANNON_PRESTATE": "${OP_CHALLENGER_CANNON_PRESTATE:-/assets/op-program/prestate-mt64.bin.gz}",
        "OP_CHALLENGER_CANNON_ROLLUP_CONFIG": "/config/rollup.json",
        "OP_CHALLENGER_CANNON_SERVER": "${OP_CHALLENGER_CANNON_SERVER:-/assets/op-program/op-program}",
        "OP_CHALLENGER_DATADIR": "/data",
        "OP_CHALLENGER_GAME_FACTORY_ADDRESS": "${L2_GAME_FACTORY_ADDRESS:-0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9}",
        "OP_CHALLENGER_L1_BEACON": "${L1_BEACON_RPC:-${L1_RPC:-http://l1:8545}}",
        "OP_CHALLENGER_L1_ETH_RPC": "${L1_RPC:-http://l1:8545}",
        "OP_CHALLENGER_L1_GENESIS": "/config/l1-chain.json",
        "OP_CHALLENGER_L2_ETH_RPC": "http://l2-geth:8545",
        "OP_CHALLENGER_PRIVATE_KEY": "${CHALLENGER_KEY:-}",
        "OP_CHALLENGER_ROLLUP_RPC": "http://op-node:9546",
        "OP_CHALLENGER_TRACE_TYPE": "${L2_CHALLENGER_TRACE_TYPE:-cannon}"
      },
      "image": "${OP_CHALLENGER_IMAGE:-local/op-challenger:${OPSTACK_IMAGE_TAG:-devnet}}",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "1g",
      "networks": {
        "default": null
      },
      "ports": [
        "${L2_CHALLENGER_METRICS_HOST_PORT:-7303}:${L2_CHALLENGER_METRICS_PORT:-7303}"
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "user": "1000:1000",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "source": "./data/op-challenger",
          "target": "/data",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./config/rollup.json",
          "target": "/config/rollup.json",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./config/genesis-l2.json",
          "target": "/config/genesis-l2.json",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./config/l1-chain.json",
          "target": "/config/l1-chain.json",
          "type": "bind"
        },
        {
          "read_only": true,
          "source": "${OP_CHALLENGER_ASSETS_DIR:-./optimism/op-program/bin}",
          "target": "/assets/op-program",
          "type": "volume",
          "volume": {}
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./optimism/cannon/bin",
          "target": "/assets/cannon",
          "type": "bind"
        }
      ]
    }
  },
  "x-logging": {
    "driver": "json-file",
    "options": {
      "max-file": "3",
      "max-size": "10m"
    }
  },
  "x-security": {
    "cap_drop": [
      "ALL"
    ],
    "security_opt": [
      "no-new-privileges:true"
    ]
  }
}
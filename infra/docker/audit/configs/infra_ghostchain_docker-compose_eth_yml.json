{
  "name": "ghostchain",
  "networks": {
    "ghostchain": {
      "driver": "bridge",
      "ipam": {
        "config": [
          {
            "subnet": "172.28.0.0/16"
          }
        ]
      },
      "name": "ghostchain_ghostchain"
    }
  },
  "services": {
    "ghostchain-bootnode": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "bootnode",
        "--nodekey",
        "/config/boot.key",
        "--addr",
        ":30301"
      ],
      "cpus": "0.5",
      "image": "${GETH_IMAGE:-ethereum/client-go:alltools-v1.13.14}",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "256m",
      "networks": {
        "ghostchain": {
          "ipv4_address": "172.28.0.21"
        }
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "udp",
          "published": "30301",
          "target": 30301
        }
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "source": "./data/bootnode",
          "target": "/config",
          "type": "bind"
        }
      ]
    },
    "ghostchain-node1": {
      "cap_drop": [
        "ALL"
      ],
      "cpus": "1.5",
      "depends_on": {
        "ghostchain-bootnode": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": [
        "/bin/sh",
        "/config/run-node.sh"
      ],
      "environment": [
        "CHAIN_ID=14000101",
        "SIGNER_ADDRESS=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266",
        "HTTP_PORT=8545",
        "WS_PORT=8546",
        "AUTH_PORT=8551",
        "P2P_PORT=30303",
        "METRICS_PORT=6060"
      ],
      "healthcheck": {
        "interval": "20s",
        "retries": 5,
        "start_period": "25s",
        "test": [
          "CMD-SHELL",
          "wget -qO- --post-data='{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_blockNumber\",\"params\":[]}' --header 'Content-Type: application/json' http://localhost:8545 \u003e/dev/null"
        ],
        "timeout": "5s"
      },
      "image": "${GETH_IMAGE:-ethereum/client-go:alltools-v1.13.14}",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "2g",
      "networks": {
        "ghostchain": {
          "ipv4_address": "172.28.0.22"
        }
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "18545",
          "target": 8545
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "18546",
          "target": 8546
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "18552",
          "target": 8551
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "18551",
          "target": 30303
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "18660",
          "target": 6060
        }
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "source": "./data/node1",
          "target": "/data",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./geth",
          "target": "/config",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./config/bootnode-enode.txt",
          "target": "/run/bootnode-enode.txt",
          "type": "bind"
        }
      ]
    },
    "ghostchain-node2": {
      "cap_drop": [
        "ALL"
      ],
      "cpus": "1.5",
      "depends_on": {
        "ghostchain-bootnode": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": [
        "/bin/sh",
        "/config/run-node.sh"
      ],
      "environment": [
        "CHAIN_ID=14000101",
        "SIGNER_ADDRESS=0x70997970c51812dc3a010c7d01b50e0d17dc79c8",
        "HTTP_PORT=8545",
        "WS_PORT=8546",
        "AUTH_PORT=8551",
        "P2P_PORT=30304",
        "METRICS_PORT=6061"
      ],
      "image": "${GETH_IMAGE:-ethereum/client-go:alltools-v1.13.14}",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "2g",
      "networks": {
        "ghostchain": {
          "ipv4_address": "172.28.0.23"
        }
      },
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "source": "./data/node2",
          "target": "/data",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./geth",
          "target": "/config",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./config/bootnode-enode.txt",
          "target": "/run/bootnode-enode.txt",
          "type": "bind"
        }
      ]
    },
    "ghostscout": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "start"
      ],
      "cpus": "1.5",
      "depends_on": {
        "ghostchain-node1": {
          "condition": "service_started",
          "required": true
        },
        "ghostscout-db": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": [
        "/app/bin/blockscout"
      ],
      "environment": {
        "API_ONLY": "true",
        "BLOCKSCOUT_HOST": "0.0.0.0",
        "COIN": "GHOST",
        "DATABASE_URL": "postgres://postgres:postgres@ghostscout-db:5432/blockscout",
        "DISABLE_EVISION": "true",
        "ECTO_USE_SSL": "false",
        "ETHEREUM_JSONRPC_HTTP_URL": "http://ghostchain-node1:8545",
        "ETHEREUM_JSONRPC_TRACE_URL": "http://ghostchain-node1:8545",
        "ETHEREUM_JSONRPC_WS_URL": "ws://ghostchain-node1:8546",
        "LOG_LEVEL": "warn",
        "NETWORK": "Ghostchain",
        "PORT": 4000,
        "SECRET_KEY_BASE": "6d31c6c2b8b7344f5f3d2421f3d8a42d9d27f9b4a7ad0b287f1aa4f8c6efb6d3",
        "SUBNETWORK": "PoA"
      },
      "image": "blockscout/blockscout:latest",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "2g",
      "networks": {
        "ghostchain": {
          "ipv4_address": "172.28.0.31"
        }
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "18644",
          "target": 4000
        }
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ]
    },
    "ghostscout-db": {
      "cap_add": [
        "CHOWN",
        "DAC_OVERRIDE",
        "FOWNER",
        "SETUID",
        "SETGID"
      ],
      "cap_drop": [],
      "command": [
        "postgres",
        "-c",
        "max_connections=200"
      ],
      "cpus": "0.5",
      "environment": {
        "POSTGRES_DB": "blockscout",
        "POSTGRES_PASSWORD": "postgres",
        "POSTGRES_USER": "postgres"
      },
      "image": "postgres:15-alpine",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "1g",
      "networks": {
        "ghostchain": {
          "ipv4_address": "172.28.0.30"
        }
      },
      "restart": "unless-stopped",
      "security_opt": null,
      "volumes": [
        {
          "source": "ghostscout-db-data",
          "target": "/var/lib/postgresql/data",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "ghostscout-frontend": {
      "cap_drop": [
        "ALL"
      ],
      "cpus": "0.8",
      "depends_on": {
        "ghostscout": {
          "condition": "service_started",
          "required": true
        }
      },
      "environment": {
        "HOST": "0.0.0.0",
        "NEXT_PUBLIC_API_HOST": "ghostscout:4000",
        "NEXT_PUBLIC_API_PROTOCOL": "http",
        "NEXT_PUBLIC_APP_HOST": "http://localhost:18640",
        "NEXT_PUBLIC_NETWORK_ICON": "https://raw.githubusercontent.com/blockscout/frontend/main/public/favicon.ico",
        "NEXT_PUBLIC_NETWORK_ID": "14000101",
        "NEXT_PUBLIC_NETWORK_NAME": "Ghostchain",
        "PORT": 3000
      },
      "image": "ghcr.io/blockscout/frontend:latest",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "1g",
      "networks": {
        "ghostchain": {
          "ipv4_address": "172.28.0.32"
        }
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "18640",
          "target": 3000
        }
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ]
    }
  },
  "volumes": {
    "ghostscout-db-data": {
      "name": "ghostchain_ghostscout-db-data"
    }
  },
  "x-logging": {
    "driver": "json-file",
    "options": {
      "max-file": "3",
      "max-size": "10m"
    }
  },
  "x-security": {
    "cap_drop": [
      "ALL"
    ],
    "security_opt": [
      "no-new-privileges:true"
    ]
  }
}
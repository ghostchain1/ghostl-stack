{
  "name": "opstack",
  "networks": {
    "default": {
      "name": "opstack_default"
    }
  },
  "services": {
    "alertmanager": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "--config.file=/etc/alertmanager/alertmanager.yml",
        "--storage.path=/alertmanager"
      ],
      "cpus": "0.25",
      "healthcheck": {
        "interval": "20s",
        "retries": 6,
        "start_period": "15s",
        "test": [
          "CMD-SHELL",
          "wget -qO- http://localhost:9093/api/v2/status \u003e/dev/null"
        ],
        "timeout": "5s"
      },
      "image": "${ALERTMANAGER_IMAGE:-prom/alertmanager@sha256:e13b6ed5cb929eeaee733479dce55e10eb3bc2e9c4586c705a4e8da41e5eacf5}",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "256m",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "9093",
          "target": 9093
        }
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./observability/alertmanager.yml",
          "target": "/etc/alertmanager/alertmanager.yml",
          "type": "bind"
        },
        {
          "source": "alertmanager_data",
          "target": "/alertmanager",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "ghost-guard": {
      "build": {
        "context": "../../services/ghost-guard",
        "dockerfile": "Dockerfile"
      },
      "cap_drop": [
        "ALL"
      ],
      "cpus": "0.5",
      "depends_on": {
        "l2-geth": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": {
        "ADMIN_TOKEN": "${GUARD_ADMIN_TOKEN:-}",
        "ALERT_MIN_RISK": "${GUARD_ALERT_MIN_RISK:-70}",
        "AUTO_ACTION": "${GUARD_AUTO_ACTION:-}",
        "AUTO_PAUSE": "${GUARD_AUTO_PAUSE:-0}",
        "AUTO_PAUSE_THRESHOLD": "${GUARD_AUTO_PAUSE_THRESHOLD:-90}",
        "AUTO_QUARANTINE_THRESHOLD": "${GUARD_AUTO_QUARANTINE_THRESHOLD:-70}",
        "BRIDGE_L2L3_ADDRESS": "${BRIDGE_L2L3_ADDRESS:-0x0000000000000000000000000000000000000000}",
        "GRAPH_WINDOW_SECONDS": "${GUARD_GRAPH_WINDOW_SECONDS:-3600}",
        "GUARD_POLICY_ADDRESS": "${GUARD_POLICY_ADDRESS:-}",
        "PORT": 7070,
        "PRIVATE_KEY": "${GUARD_PRIVATE_KEY:-}",
        "QUARANTINE_DELAY_SECONDS": "${GUARD_QUARANTINE_DELAY_SECONDS:-30}",
        "RATE_LIMIT_MAX": "${GUARD_RATE_LIMIT_MAX:-20}",
        "RATE_LIMIT_WINDOW_MS": "${GUARD_RATE_LIMIT_WINDOW_MS:-1000}",
        "RISK_WINDOW_SECONDS": "${GUARD_RISK_WINDOW_SECONDS:-300}",
        "RPC_L2": "http://l2-geth:8545",
        "STATE_DIR": "/state"
      },
      "healthcheck": {
        "interval": "20s",
        "retries": 6,
        "start_period": "20s",
        "test": [
          "CMD-SHELL",
          "wget -qO- http://localhost:7070/health \u003e/dev/null"
        ],
        "timeout": "10s"
      },
      "image": "local/ghost-guard:${OPSTACK_IMAGE_TAG:-devnet}",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "512m",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7070",
          "target": 7070
        }
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "source": "./data/guard",
          "target": "/state",
          "type": "bind"
        }
      ]
    },
    "grafana": {
      "cap_drop": [
        "ALL"
      ],
      "cpus": "0.5",
      "depends_on": {
        "loki": {
          "condition": "service_healthy",
          "required": true
        },
        "prometheus": {
          "condition": "service_started",
          "required": true
        }
      },
      "environment": {
        "GF_SECURITY_ADMIN_PASSWORD": "${GRAFANA_ADMIN_PASSWORD:-admin}",
        "PROMETHEUS_URL": "${PROMETHEUS_URL:-http://prometheus:9090}"
      },
      "image": "${GRAFANA_IMAGE:-grafana/grafana@sha256:408afb9726de5122b00a2576763a8a57a3c86d5b0eff5305bc994ceb3eb96c3f}",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "512m",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "3000",
          "target": 3000
        }
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        {
          "source": "grafana_data",
          "target": "/var/lib/grafana",
          "type": "volume",
          "volume": {}
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./observability/grafana/provisioning",
          "target": "/etc/grafana/provisioning",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./observability/grafana/dashboards",
          "target": "/var/lib/grafana/dashboards",
          "type": "bind"
        }
      ]
    },
    "l2-geth": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "-c",
        "set -e\nif [ ! -d /data/geth ]; then\n  echo \"[l2-geth] initializing genesis...\"\n  geth init --datadir /data /config/genesis-l2.json\nfi\nexec geth \\\n  --http --http.addr=0.0.0.0 --http.api=eth,net,web3,debug,txpool \\\n  --http.vhosts=\"*\" \\\n  --ws --ws.addr=0.0.0.0 --ws.origins=\"*\" \\\n  --authrpc.addr=0.0.0.0 --authrpc.port=8551 --authrpc.vhosts=\"*\" --authrpc.jwtsecret=/config/jwt.txt\\\n  --datadir=/data \\\n  --networkid=${L2_CHAIN_ID:-901} \\\n  --gcmode=archive \\\n  --rollup.disabletxpoolgossip=true\n"
      ],
      "cpus": "2.0",
      "depends_on": {
        "op-gate": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": [
        "/bin/sh"
      ],
      "healthcheck": {
        "interval": "20s",
        "retries": 6,
        "start_period": "25s",
        "test": [
          "CMD-SHELL",
          "geth attach --datadir /data --exec 'net.version' http://localhost:8545 \u003e/dev/null 2\u003e\u00261"
        ],
        "timeout": "10s"
      },
      "image": "ghcr.io/ethereum-optimism/op-geth@sha256:523b0ef36e26c3e8b99cc83d4bf2cc23ec94774be888d930159b1d9362733bc0",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "4g",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "29547",
          "target": 8545
        }
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "user": "1000:1000",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "source": "./data/l2-geth-new2",
          "target": "/data",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./config",
          "target": "/config",
          "type": "bind"
        }
      ]
    },
    "loki": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "-config.file=/etc/loki/config.yml"
      ],
      "cpus": "0.5",
      "healthcheck": {
        "interval": "20s",
        "retries": 6,
        "start_period": "15s",
        "test": [
          "CMD-SHELL",
          "wget -qO- http://localhost:3100/ready \u003e/dev/null"
        ],
        "timeout": "5s"
      },
      "image": "${LOKI_IMAGE:-grafana/loki@sha256:8b5bd7748d0e4da66cd741ac276e485517514af0bea32167e27c0e1a95bcf8aa}",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "512m",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "3100",
          "target": 3100
        }
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./observability/loki/config.yml",
          "target": "/etc/loki/config.yml",
          "type": "bind"
        },
        {
          "source": "loki_data",
          "target": "/loki",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "op-batcher": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "op-batcher",
        "--l1-eth-rpc=${L1_RPC:-http://host.docker.internal:18545}",
        "--l2-eth-rpc=http://l2-geth:8545",
        "--rollup-rpc=http://op-node:9546",
        "--private-key=${BATCHER_KEY}",
        "--rpc.addr=0.0.0.0",
        "--rpc.port=8551",
        "--throttle.unsafe-da-bytes-lower-threshold=0",
        "--metrics.enabled",
        "--metrics.addr=0.0.0.0",
        "--metrics.port=7301"
      ],
      "cpus": "1.0",
      "depends_on": {
        "op-gate": {
          "condition": "service_healthy",
          "required": true
        },
        "op-node": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": {
        "L2OO_ADDRESS": "${L2OO_ADDRESS:-0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9}",
        "OP_BATCHER_DATA_AVAILABILITY_TYPE": "${OP_BATCHER_DATA_AVAILABILITY_TYPE:-calldata}",
        "OP_BATCHER_MAX_CHANNEL_DURATION": "${OP_BATCHER_MAX_CHANNEL_DURATION:-2}",
        "OP_BATCHER_NUM_CONFIRMATIONS": "${OP_BATCHER_NUM_CONFIRMATIONS:-1}",
        "OP_BATCHER_POLL_INTERVAL": "${OP_BATCHER_POLL_INTERVAL:-1s}",
        "OP_BATCHER_RPC_ENABLE_ADMIN": "${OP_BATCHER_RPC_ENABLE_ADMIN:-true}",
        "OP_BATCHER_SUB_SAFETY_MARGIN": "${OP_BATCHER_SUB_SAFETY_MARGIN:-4}"
      },
      "extra_hosts": [
        "host.docker.internal:host-gateway"
      ],
      "healthcheck": {
        "interval": "20s",
        "retries": 6,
        "start_period": "25s",
        "test": [
          "CMD-SHELL",
          "wget -qO- --header='Content-Type: application/json' --post-data='{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_blockNumber\",\"params\":[]}' http://localhost:8551 \u003e/dev/null"
        ],
        "timeout": "10s"
      },
      "image": "ghcr.io/ethereum-optimism/op-batcher@sha256:21a2426a292a0d1b6c3665c9e07549df97d98e40edda6c880d34e22aefe279d2",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "1g",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8551",
          "target": 8551
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7301",
          "target": 7301
        }
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "user": "1000:1000",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./config",
          "target": "/config",
          "type": "bind"
        }
      ]
    },
    "op-gate": {
      "build": {
        "args": {
          "NODE_IMAGE": "${OP_STACK_BASE_IMAGE:-node@sha256:40dc4b415c17b85bea9be05314b4a753f45a4e1716bb31c01182e6c53d51a654}"
        },
        "context": "./gate",
        "dockerfile": "Dockerfile"
      },
      "cap_drop": [
        "ALL"
      ],
      "cpus": "0.5",
      "environment": {
        "ADMIN_TOKEN": "${GATE_ADMIN_TOKEN:-}",
        "ALLOW_INSECURE_ADMIN": "${GATE_ALLOW_INSECURE_ADMIN:-0}",
        "BATCH_SENDER_ADDRESS": "${BATCH_SENDER_ADDRESS:-}",
        "DEFAULT_DELAY_SECONDS": "${GATE_DEFAULT_DELAY_SECONDS:-0}",
        "GUARD_URL": "${GATE_GUARD_URL:-http://ghost-guard:7070}",
        "NODE_ENV": "production",
        "PORT": "${GATE_PORT:-8545}",
        "PROPOSER_ADDRESS": "${PROPOSER_ADDRESS:-}",
        "STATE_DIR": "/state",
        "UPSTREAM_RPC": "${GATE_UPSTREAM_RPC:-http://l2-geth:8545}"
      },
      "extra_hosts": [
        "host.docker.internal:host-gateway"
      ],
      "healthcheck": {
        "interval": "15s",
        "retries": 5,
        "start_period": "15s",
        "test": [
          "CMD-SHELL",
          "curl -sf http://localhost:8545/gate/status \u003e/dev/null"
        ],
        "timeout": "5s"
      },
      "image": "${OP_GATE_IMAGE:-local/op-gate:0.1.0}",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "512m",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "28546",
          "target": 8545
        }
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "user": "1000:1000",
      "volumes": [
        {
          "source": "op_gate_state",
          "target": "/state",
          "type": "volume",
          "volume": {}
        }
      ],
      "working_dir": "/app"
    },
    "op-node": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "op-node",
        "--l1=${L1_RPC:-http://host.docker.internal:18545}",
        "--l2=http://l2-geth:8551",
        "--l2.jwt-secret=/config/jwt.txt",
        "--rollup.config=/config/rollup.json",
        "--rollup.l1-chain-config=/config/l1-chain.json",
        "--rpc.addr=0.0.0.0",
        "--rpc.port=9546",
        "--l1.rpckind=basic",
        "--l1.trustrpc",
        "--p2p.disable",
        "--l1.beacon.ignore",
        "--sequencer.enabled",
        "--sequencer.l1-confs=${SEQUENCER_L1_CONFS:-2}",
        "--l1.runtime-config-reload-interval=0",
        "--metrics.enabled",
        "--metrics.addr=0.0.0.0",
        "--metrics.port=7300"
      ],
      "cpus": "1.5",
      "depends_on": {
        "l2-geth": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "extra_hosts": [
        "host.docker.internal:host-gateway"
      ],
      "healthcheck": {
        "interval": "20s",
        "retries": 6,
        "start_period": "25s",
        "test": [
          "CMD-SHELL",
          "wget -qO- --header='Content-Type: application/json' --post-data='{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"optimism_syncStatus\",\"params\":[]}' http://localhost:9546 \u003e/dev/null"
        ],
        "timeout": "10s"
      },
      "image": "ghcr.io/ethereum-optimism/op-node@sha256:d0edc8eb74ba826328b351d09b7533a93117348b779416a8f156d7f2363a033b",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "2g",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "9546",
          "target": 9546
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7300",
          "target": 7300
        }
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "user": "1000:1000",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "source": "./data/op-node",
          "target": "/data",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./config",
          "target": "/config",
          "type": "bind"
        }
      ]
    },
    "op-proposer": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "op-proposer",
        "--l1-eth-rpc=${L1_RPC:-http://host.docker.internal:18545}",
        "--rollup-rpc=http://op-node:9546",
        "--game-factory-address=${GAME_FACTORY_ADDRESS:-0x9464a29028c32c33975AC1FB48D6192B6e46DB9e}",
        "--proposal-interval=${PROPOSAL_INTERVAL:-30s}",
        "--private-key=${PROPOSER_KEY:-0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80}",
        "--allow-non-finalized",
        "--txmgr.send-timeout=30s",
        "--txmgr.retry-interval=3s",
        "--rpc.addr=0.0.0.0",
        "--rpc.port=8560",
        "--metrics.enabled",
        "--metrics.addr=0.0.0.0",
        "--metrics.port=7302"
      ],
      "cpus": "1.0",
      "depends_on": {
        "op-gate": {
          "condition": "service_healthy",
          "required": true
        },
        "op-node": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": {
        "GAME_FACTORY_ADDRESS": "${GAME_FACTORY_ADDRESS:-0x9464a29028c32c33975AC1FB48D6192B6e46DB9e}",
        "PROPOSER_KEY": "${PROPOSER_KEY:-0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80}"
      },
      "extra_hosts": [
        "host.docker.internal:host-gateway"
      ],
      "healthcheck": {
        "interval": "20s",
        "retries": 6,
        "start_period": "25s",
        "test": [
          "CMD-SHELL",
          "wget -qO- http://localhost:7302/metrics \u003e/dev/null"
        ],
        "timeout": "10s"
      },
      "image": "ghcr.io/ethereum-optimism/op-proposer@sha256:00590e36e37994eefd8bbc9a6498ad20c62b072b381d0b8cdb7293056e6e5b64",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "1g",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8560",
          "target": 8560
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7302",
          "target": 7302
        }
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "user": "1000:1000",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "./config",
          "target": "/config",
          "type": "bind"
        }
      ]
    },
    "op-sequencer": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "op-node",
        "--l1=${L1_RPC:-http://host.docker.internal:18545}",
        "--l2=http://l2-geth:8551",
        "--l2.jwt-secret=/config/jwt.txt",
        "--rollup.config=/config/rollup.json",
        "--rollup.l1-chain-config=/config/l1-chain.json",
        "--rpc.addr=0.0.0.0",
        "--rpc.port=9646",
        "--l1.rpckind=basic",
        "--l1.trustrpc",
        "--p2p.disable",
        "--l1.beacon.ignore",
        "--sequencer.enabled",
        "--sequencer.l1-confs=${SEQUENCER_L1_CONFS:-2}",
        "--l1.runtime-config-reload-interval=0",
        "--metrics.enabled",
        "--metrics.addr=0.0.0.0",
        "--metrics.port=7303"
      ],
      "cpus": "1.5",
      "depends_on": {
        "l2-geth": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": {
        "OP_NODE_L1_BEACON_IGNORE": "1"
      },
      "extra_hosts": [
        "host.docker.internal:host-gateway"
      ],
      "healthcheck": {
        "interval": "20s",
        "retries": 6,
        "start_period": "25s",
        "test": [
          "CMD-SHELL",

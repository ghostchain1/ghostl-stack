{
  "name": "core-service",
  "networks": {
    "default": {
      "name": "core-service_default"
    }
  },
  "services": {
    "core-service": {
      "build": {
        "context": ".",
        "dockerfile": "Dockerfile"
      },
      "cap_drop": [
        "ALL"
      ],
      "cpus": "0.5",
      "environment": [
        "PORT=8080"
      ],
      "healthcheck": {
        "interval": "30s",
        "retries": 3,
        "start_period": "40s",
        "test": [
          "CMD",
          "wget",
          "--no-verbose",
          "--tries=1",
          "--spider",
          "http://localhost:8080/healthz"
        ],
        "timeout": "10s"
      },
      "mem_limit": "256m",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8080",
          "target": 8080
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ]
    }
  }
}
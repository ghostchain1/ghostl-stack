{
  "name": "ghostchain-compliance",
  "networks": {
    "default": {
      "name": "ghostchain-compliance_default"
    }
  },
  "services": {
    "ghost-compliance": {
      "build": {
        "context": "./services/ghost-compliance",
        "dockerfile": "Dockerfile"
      },
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully",
          "required": true
        },
        "postgres": {
          "condition": "service_healthy",
          "required": true
        },
        "redis": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": {
        "ATTESTATION_EXPIRY_SECONDS": 900,
        "ATTESTATION_PRIVATE_KEY": "${COMPLIANCE_ATTESTATION_PRIVATE_KEY:-0x59c6995e998f97a5a0044966f094538e4b1a8d9d0f0b8a8c64d124b5e5d6fcbf}",
        "CORS_ORIGIN": "http://localhost:3200",
        "DATABASE_URL": "postgresql://ghost:${POSTGRES_PASSWORD:-ghostpass}@postgres:5432/ghost_compliance",
        "JWT_SECRET": "${COMPLIANCE_JWT_SECRET:-change-me}",
        "NODE_ENV": "production",
        "PORT": 8090,
        "REDIS_URL": "redis://redis:6379"
      },
      "healthcheck": {
        "interval": "5s",
        "retries": 20,
        "test": [
          "CMD-SHELL",
          "node -e \"fetch('http://localhost:8090/health').then(r=\u003er.ok?process.exit(0):process.exit(1)).catch(()=\u003eprocess.exit(1))\""
        ],
        "timeout": "3s"
      },
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8090",
          "target": 8090
        }
      ]
    },
    "ghost-compliance-worker": {
      "build": {
        "context": "./services/ghost-compliance-worker",
        "dockerfile": "Dockerfile"
      },
      "depends_on": {
        "ghost-compliance": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": {
        "COMPLIANCE_API_URL": "http://ghost-compliance:8090",
        "DATABASE_URL": "postgresql://ghost:${POSTGRES_PASSWORD:-ghostpass}@postgres:5432/ghost_compliance",
        "NODE_ENV": "production",
        "PREDICT_INTERVAL_SECONDS": 60,
        "REDIS_URL": "redis://redis:6379"
      },
      "networks": {
        "default": null
      },
      "restart": "unless-stopped"
    },
    "ghost-ui": {
      "build": {
        "context": "./apps/ghost-ui",
        "dockerfile": "Dockerfile"
      },
      "depends_on": {
        "ghost-compliance": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": {
        "COMPLIANCE_ANALYST_JWT": "${COMPLIANCE_ANALYST_JWT:-eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJnaG9zdC11aSIsInJvbGUiOiJhbmFseXN0In0.Hry8Kl3wdOufLjxTZ_A9NLSXVk_gReEKNH3gWP2lYdg}",
        "COMPLIANCE_URL": "http://ghost-compliance:8090",
        "NEXT_PUBLIC_COMPLIANCE_URL": "http://localhost:8090",
        "NODE_ENV": "production",
        "PORT": 3200
      },
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "3200",
          "target": 3200
        }
      ]
    },
    "migrate": {
      "command": [
        "sh",
        "-lc",
        "npm install \u0026\u0026 npm run migrate"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy",
          "required": true
        },
        "redis": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": {
        "ATTESTATION_EXPIRY_SECONDS": 900,
        "ATTESTATION_PRIVATE_KEY": "${COMPLIANCE_ATTESTATION_PRIVATE_KEY:-0x59c6995e998f97a5a0044966f094538e4b1a8d9d0f0b8a8c64d124b5e5d6fcbf}",
        "DATABASE_URL": "postgresql://ghost:${POSTGRES_PASSWORD:-ghostpass}@postgres:5432/ghost_compliance",
        "JWT_SECRET": "${COMPLIANCE_JWT_SECRET:-change-me}",
        "REDIS_URL": "redis://redis:6379"
      },
      "image": "node:22-alpine",
      "networks": {
        "default": null
      },
      "restart": "no",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "source": "./services/ghost-compliance",
          "target": "/work",
          "type": "bind"
        }
      ],
      "working_dir": "/work"
    },
    "postgres": {
      "environment": {
        "POSTGRES_DB": "ghost_compliance",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:-ghostpass}",
        "POSTGRES_USER": "ghost"
      },
      "healthcheck": {
        "interval": "5s",
        "retries": 20,
        "test": [
          "CMD-SHELL",
          "pg_isready -U ghost -d ghost_compliance"
        ],
        "timeout": "3s"
      },
      "image": "postgres:16-alpine",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "5432",
          "target": 5432
        }
      ],
      "volumes": [
        {
          "source": "pg_data",
          "target": "/var/lib/postgresql/data",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "redis": {
      "command": [
        "redis-server",
        "--appendonly",
        "yes"
      ],
      "healthcheck": {
        "interval": "5s",
        "retries": 20,
        "test": [
          "CMD",
          "redis-cli",
          "ping"
        ],
        "timeout": "3s"
      },
      "image": "redis:7-alpine",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "6379",
          "target": 6379
        }
      ],
      "volumes": [
        {
          "source": "redis_data",
          "target": "/data",
          "type": "volume",
          "volume": {}
        }
      ]
    }
  },
  "volumes": {
    "pg_data": {
      "name": "ghostchain-compliance_pg_data"
    },
    "redis_data": {
      "name": "ghostchain-compliance_redis_data"
    }
  }
}
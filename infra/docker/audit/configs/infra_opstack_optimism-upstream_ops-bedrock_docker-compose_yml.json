{
  "name": "ops-bedrock",
  "networks": {
    "default": {
      "name": "ops-bedrock_default"
    }
  },
  "services": {
    "artifact-server": {
      "depends_on": {
        "l1": {
          "condition": "service_started",
          "required": true
        }
      },
      "image": "nginx:1.25-alpine",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8080",
          "target": 80
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        {
          "read_only": true,
          "source": "${PWD}/../.devnet/",
          "target": "/usr/share/nginx/html",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "da-server": {
      "build": {
        "context": "../",
        "dockerfile": "ops/docker/op-stack-go/Dockerfile",
        "target": "da-server-target"
      },
      "command": "da-server --file.path=/data --addr=0.0.0.0 --port=3100 --log.level=debug --generic-commitment=\"${ALTDA_GENERIC_DA}\"\n",
      "image": "us-docker.pkg.dev/oplabs-tools-artifacts/images/da-server:devnet",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "3100",
          "target": 3100
        }
      ],
      "volumes": [
        {
          "source": "da_data",
          "target": "/data",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "l1": {
      "build": {
        "context": ".",
        "dockerfile": "l1-geth.Dockerfile"
      },
      "environment": {
        "GETH_MINER_RECOMMIT": "100ms"
      },
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8545",
          "target": 8545
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8546",
          "target": 8546
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7060",
          "target": 6060
        }
      ],
      "volumes": [
        {
          "source": "l1_data",
          "target": "/db",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../.devnet/genesis-l1.json",
          "target": "/genesis.json",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/test-jwt-secret.txt",
          "target": "/config/jwt-secret.txt",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "l1-bn": {
      "build": {
        "context": ".",
        "dockerfile": "l1-lighthouse.Dockerfile"
      },
      "depends_on": {
        "l1": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": [
        "/bin/sh",
        "/entrypoint-bn.sh"
      ],
      "environment": {
        "LH_EXECUTION_ENDPOINT": "http://l1:8551"
      },
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "9000",
          "target": 9000
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "5052",
          "target": 5052
        }
      ],
      "volumes": [
        {
          "source": "l1_bn_data",
          "target": "/db",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/test-jwt-secret.txt",
          "target": "/config/jwt-secret.txt",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/beacon-data/config.yaml",
          "target": "/genesis/config.yaml",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/beacon-data/deposit_contract_block.txt",
          "target": "/genesis/deposit_contract_block.txt",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../.devnet/genesis-l1.ssz",
          "target": "/genesis/genesis.ssz",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "l1-vc": {
      "build": {
        "context": ".",
        "dockerfile": "l1-lighthouse.Dockerfile"
      },
      "depends_on": {
        "l1": {
          "condition": "service_started",
          "required": true
        },
        "l1-bn": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": [
        "/bin/sh",
        "/entrypoint-vc.sh"
      ],
      "environment": {
        "LH_BEACON_NODES": "http://l1-bn:5052/"
      },
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "source": "l1_vc_data",
          "target": "/db",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/beacon-data/data/keys",
          "target": "/validator_setup/validators",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/beacon-data/data/secrets",
          "target": "/validator_setup/secrets",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/beacon-data/config.yaml",
          "target": "/genesis/config.yaml",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/beacon-data/deposit_contract_block.txt",
          "target": "/genesis/deposit_contract_block.txt",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../.devnet/genesis-l1.ssz",
          "target": "/genesis/genesis.ssz",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "l2": {
      "build": {
        "context": ".",
        "dockerfile": "l2-op-geth.Dockerfile"
      },
      "entrypoint": [
        "/bin/sh",
        "/entrypoint.sh"
      ],
      "environment": {
        "GETH_MINER_RECOMMIT": "100ms"
      },
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "9545",
          "target": 8545
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8060",
          "target": 6060
        }
      ],
      "volumes": [
        {
          "source": "l2_data",
          "target": "/db",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../.devnet/genesis-l2.json",
          "target": "/genesis.json",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/test-jwt-secret.txt",
          "target": "/config/jwt-secret.txt",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "op-batcher": {
      "build": {
        "context": "../",
        "dockerfile": "ops/docker/op-stack-go/Dockerfile",
        "target": "op-batcher-target"
      },
      "depends_on": {
        "l1": {
          "condition": "service_started",
          "required": true
        },
        "l2": {
          "condition": "service_started",
          "required": true
        },
        "op-node": {
          "condition": "service_started",
          "required": true
        }
      },
      "environment": {
        "OP_BATCHER_ALTDA_DA_SERVER": "http://da-server:3100",
        "OP_BATCHER_ALTDA_DA_SERVICE": "${ALTDA_SERVICE}",
        "OP_BATCHER_ALTDA_ENABLED": "${ALTDA_ENABLED}",
        "OP_BATCHER_BATCH_TYPE": 1,
        "OP_BATCHER_DATA_AVAILABILITY_TYPE": "${DA_TYPE}",
        "OP_BATCHER_L1_ETH_RPC": "http://l1:8545",
        "OP_BATCHER_L2_ETH_RPC": "http://l2:8545",
        "OP_BATCHER_MAX_CHANNEL_DURATION": 2,
        "OP_BATCHER_METRICS_ENABLED": "true",
        "OP_BATCHER_MNEMONIC": "test test test test test test test test test test test junk",
        "OP_BATCHER_NUM_CONFIRMATIONS": 1,
        "OP_BATCHER_POLL_INTERVAL": "1s",
        "OP_BATCHER_PPROF_ENABLED": "true",
        "OP_BATCHER_ROLLUP_RPC": "http://op-node:8545",
        "OP_BATCHER_RPC_ENABLE_ADMIN": "true",
        "OP_BATCHER_SEQUENCER_HD_PATH": "m/44'/60'/0'/0/2",
        "OP_BATCHER_SUB_SAFETY_MARGIN": 4
      },
      "image": "us-docker.pkg.dev/oplabs-tools-artifacts/images/op-batcher:devnet",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "6061",
          "target": 6060
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7301",
          "target": 7300
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "6545",
          "target": 8545
        }
      ]
    },
    "op-challenger": {
      "build": {
        "context": "../",
        "dockerfile": "ops/docker/op-stack-go/Dockerfile",
        "target": "op-challenger-target"
      },
      "depends_on": {
        "l1": {
          "condition": "service_started",
          "required": true
        },
        "l1-bn": {
          "condition": "service_started",
          "required": true
        },
        "l2": {
          "condition": "service_started",
          "required": true
        },
        "op-node": {
          "condition": "service_started",
          "required": true
        }
      },
      "environment": {
        "OP_CHALLENGER_CANNON_BIN": "./cannon/bin/cannon",
        "OP_CHALLENGER_CANNON_L2_GENESIS": "./.devnet/genesis-l2.json",
        "OP_CHALLENGER_CANNON_PRESTATE": "/op-program/prestate.bin.gz",
        "OP_CHALLENGER_CANNON_ROLLUP_CONFIG": "./.devnet/rollup.json",
        "OP_CHALLENGER_CANNON_SERVER": "/op-program/op-program",
        "OP_CHALLENGER_DATADIR": "/db",
        "OP_CHALLENGER_GAME_FACTORY_ADDRESS": "${DGF_ADDRESS}",
        "OP_CHALLENGER_HD_PATH": "m/44'/60'/0'/0/4",
        "OP_CHALLENGER_L1_BEACON": "http://l1-bn:5052",
        "OP_CHALLENGER_L1_ETH_RPC": "http://l1:8545",
        "OP_CHALLENGER_L2_ETH_RPC": "http://l2:8545",
        "OP_CHALLENGER_MNEMONIC": "test test test test test test test test test test test junk",
        "OP_CHALLENGER_NUM_CONFIRMATIONS": 1,
        "OP_CHALLENGER_ROLLUP_RPC": "http://op-node:8545",
        "OP_CHALLENGER_TRACE_TYPE": "cannon,fast",
        "OP_CHALLENGER_UNSAFE_ALLOW_INVALID_PRESTATE": "true"
      },
      "image": "us-docker.pkg.dev/oplabs-tools-artifacts/images/op-challenger:devnet",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "source": "challenger_data",
          "target": "/db",
          "type": "volume",
          "volume": {}
        },
        {
          "bind": {
            "create_host_path": true
          },
          "source": "../op-program/bin",
          "target": "/op-program",
          "type": "bind"
        }
      ]
    },
    "op-node": {
      "build": {
        "context": "../",
        "dockerfile": "ops/docker/op-stack-go/Dockerfile",
        "target": "op-node-target"
      },
      "command": "op-node --l1=ws://l1:8546 --l1.beacon=http://l1-bn:5052 --l1.epoch-poll-interval=12s --l1.http-poll-interval=6s --l2=http://l2:8551 --l2.jwt-secret=/config/jwt-secret.txt --sequencer.enabled --sequencer.l1-confs=0 --verifier.l1-confs=0 --p2p.sequencer.key=8b3a350cf5c34c9194ca85829a2df0ec3153be0318b5e2d3348e872092edffba --rollup.config=/rollup.json --rpc.addr=0.0.0.0 --rpc.port=8545 --p2p.listen.ip=0.0.0.0 --p2p.listen.tcp=9003 --p2p.listen.udp=9003 --p2p.scoring.peers=light --p2p.ban.peers=true --p2p.priv.path=/config/p2p-node-key.txt --metrics.enabled --metrics.addr=0.0.0.0 --metrics.port=7300 --pprof.enabled --rpc.enable-admin --safedb.path=/db --altda.enabled=${ALTDA_ENABLED} --altda.da-service=${ALTDA_SERVICE} --altda.da-server=http://da-server:3100\n",
      "depends_on": {
        "l1": {
          "condition": "service_started",
          "required": true
        },
        "l1-bn": {
          "condition": "service_started",
          "required": true
        },
        "l1-vc": {
          "condition": "service_started",
          "required": true
        },
        "l2": {
          "condition": "service_started",
          "required": true
        }
      },
      "image": "us-docker.pkg.dev/oplabs-tools-artifacts/images/op-node:devnet",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7545",
          "target": 8545
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "9003",
          "target": 9003
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7300",
          "target": 7300
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "6060",
          "target": 6060
        }
      ],
      "volumes": [
        {
          "source": "safedb_data",
          "target": "/db",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/p2p-sequencer-key.txt",
          "target": "/config/p2p-sequencer-key.txt",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/p2p-node-key.txt",
          "target": "/config/p2p-node-key.txt",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/test-jwt-secret.txt",
          "target": "/config/jwt-secret.txt",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "${PWD}/../.devnet/rollup.json",
          "target": "/rollup.json",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "op_log",
          "target": "/op_log",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "op-proposer": {
      "build": {
        "context": "../",
        "dockerfile": "ops/docker/op-stack-go/Dockerfile",
        "target": "op-proposer-target"
      },
      "depends_on": {
        "l1": {
          "condition": "service_started",
          "required": true
        },
        "l2": {
          "condition": "service_started",
          "required": true
        },
        "op-node": {
          "condition": "service_started",
          "required": true
        }
      },
      "environment": {
        "OP_PROPOSER_ALLOW_NON_FINALIZED": "true",
        "OP_PROPOSER_GAME_FACTORY_ADDRESS": "${DGF_ADDRESS}",
        "OP_PROPOSER_GAME_TYPE": "${DG_TYPE}",
        "OP_PROPOSER_L1_ETH_RPC": "http://l1:8545",
        "OP_PROPOSER_L2OO_ADDRESS": "${L2OO_ADDRESS}",
        "OP_PROPOSER_L2_OUTPUT_HD_PATH": "m/44'/60'/0'/0/1",
        "OP_PROPOSER_METRICS_ENABLED": "true",
        "OP_PROPOSER_MNEMONIC": "test test test test test test test test test test test junk",
        "OP_PROPOSER_NUM_CONFIRMATIONS": 1,
        "OP_PROPOSER_POLL_INTERVAL": "1s",
        "OP_PROPOSER_PPROF_ENABLED": "true",
        "OP_PROPOSER_PROPOSAL_INTERVAL": "${PROPOSAL_INTERVAL}",
        "OP_PROPOSER_ROLLUP_RPC": "http://op-node:8545",
        "OP_PROPOSER_RPC_ENABLE_ADMIN": "true"
      },
      "image": "us-docker.pkg.dev/oplabs-tools-artifacts/images/op-proposer:devnet",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "6062",
          "target": 6060
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "7302",
          "target": 7300
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "6546",
          "target": 8545
        }
      ]
    },
    "sentinel": {
      "command": "sentinel --datadir=data --l1-rpc-http=http://l1:8545 --l1-rpc-ws=ws://l1:8546 --da-storage-uri=http://da-server:3100 --private-key=0x8b3a350cf5c34c9194ca85829a2df0ec3153be0318b5e2d3348e872092edffba --config=/rollup.json\n",
      "image": "quarry/sentinel",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "source": "${PWD}/../.devnet/rollup.json",
          "target": "/rollup.json",
          "type": "volume",
          "volume": {}
        }
      ]
    }
  },
  "volumes": {
    "challenger_data": {
      "name": "ops-bedrock_challenger_data"
    },
    "da_data": {
      "name": "ops-bedrock_da_data"
    },
    "l1_bn_data": {
      "name": "ops-bedrock_l1_bn_data"
    },
    "l1_data": {
      "name": "ops-bedrock_l1_data"
    },
    "l1_vc_data": {
      "name": "ops-bedrock_l1_vc_data"
    },
    "l2_data": {
      "name": "ops-bedrock_l2_data"
    },
    "op_log": {
      "name": "ops-bedrock_op_log"
    },
    "safedb_data": {
      "name": "ops-bedrock_safedb_data"
    }
  }
}
PORT=7373
# Settlement = GhostL2 RPC endpoint
RPC_SETTLEMENT=https://ghostl2.yourdomain.com/rpc
# Child = GhostL3 RPC endpoint
RPC_CHILD=https://ghostl3.yourdomain.com/rpc
# Deployed OptimisticRollup contract on L2
ROLLUP_ADDRESS=0xYourL2RollupAddress
# Proposer key with funds on L2 (store securely; do not commit real keys)
PROPOSER_PRIVATE_KEY=0xyourproposerkey
# Chain IDs for sanity checks
EXPECTED_SETTLEMENT_CHAIN_ID=7192
EXPECTED_CHILD_CHAIN_ID=7393
# Code hash of the deployed rollup contract runtime bytecode (update if you redeploy)
ROLLUP_CODE_HASH=0x5ca856c713c88e28b9d43afe046cef69e33d18a32eb636bc4bbd57e55a988264
# Rollup params (must match on-chain config)
CHALLENGE_PERIOD_SECONDS=30
BATCH_SIZE=20
CONFIRMATIONS=12
STATE_DIR=/state

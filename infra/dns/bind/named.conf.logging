logging {
  channel default_log {
    file "/var/log/named/named.log" versions 10 size 20m;
    severity info;
    print-time yes;
    print-severity yes;
    print-category yes;
  };

  category default { default_log; };
  category queries { default_log; };
  category resolver { default_log; };
  category rate-limit { default_log; };
  category security { default_log; };
};

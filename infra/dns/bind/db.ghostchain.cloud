@                                 IN A     192.168.122.205
hypervisor                        IN A     192.168.122.205
l1                                IN A     192.168.122.205
l2                                IN A     192.168.122.205
l3                                IN A     192.168.122.205
devnet                            IN A     192.168.122.205
testnet                           IN A     192.168.122.205
mainnet                           IN A     192.168.122.205
docker.internal                   IN A     172.17.0.1

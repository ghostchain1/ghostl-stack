{
  "realm": "ghost-users",
  "enabled": true,
  "displayName": "Ghost Users",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "bruteForceProtected": true,
  "failureFactor": 8,
  "roles": {
    "realm": [
      { "name": "user", "description": "Standard user portal access" }
    ]
  },
  "clients": [
    {
      "clientId": "ghost-web",
      "name": "Ghost Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://app.ghostchain.cloud/api/auth/callback/keycloak"],
      "webOrigins": ["https://app.ghostchain.cloud"]
    },
    {
      "clientId": "ghost-e2e-cli",
      "name": "Ghost E2E CLI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "ghost-e2e-secret",
      "attributes": {
        "access.token.lifespan": "5"
      }
    }
  ],
  "attributes": {
    "realm": "users"
  }
}

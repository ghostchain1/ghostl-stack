{
  "realm": "ghost-admins",
  "enabled": true,
  "displayName": "Ghost Admins",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Admin portal access"
      },
      {
        "name": "governance_admin",
        "description": "Create/execute governance proposals"
      },
      {
        "name": "treasury_admin",
        "description": "Treasury controls"
      },
      {
        "name": "compliance_admin",
        "description": "Compliance controls"
      },
      {
        "name": "infra_admin",
        "description": "Infrastructure controls"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ghost-web",
      "name": "Ghost Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://app.ghostchain.cloud/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "https://app.ghostchain.cloud"
      ]
    },
    {
      "clientId": "ghost-e2e-cli",
      "name": "Ghost E2E CLI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "ghost-e2e-secret",
      "attributes": {
        "access.token.lifespan": "5"
      }
    }
  ],
  "attributes": {
    "realm": "admins"
  },
  "browserFlow": "ghost-browser-with-otp",
  "authenticationFlows": [
    {
      "alias": "ghost-browser-with-otp",
      "description": "Ghost browser flow with mandatory TOTP second factor",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "ghost-browser-forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "ghost-browser-forms",
      "description": "Username/password then mandatory OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": true
        }
      ]
    }
  ]
}

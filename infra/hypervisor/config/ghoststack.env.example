# =========================
# GhostStack Hypervisor Env
# =========================
# Copy to ghoststack.env and edit before running the bootstrap.

# Libvirt network names
GS_NET_L1="gs-l1"
GS_NET_L2="gs-l2"
GS_NET_L3="gs-l3"
GS_NET_MGMT="gs-mgmt"

# Subnets (non-overlapping RFC1918)
GS_L1_CIDR="10.50.10.0/24"
GS_L2_CIDR="10.50.20.0/24"
GS_L3_CIDR="10.50.30.0/24"
GS_MGMT_CIDR="10.50.99.0/24"

# Bridges (libvirt creates these)
GS_BR_L1="virbr10"
GS_BR_L2="virbr20"
GS_BR_L3="virbr30"
GS_BR_MGMT="virbr99"

# Gateway IPs for each network
GS_L1_GW="10.50.10.1"
GS_L2_GW="10.50.20.1"
GS_L3_GW="10.50.30.1"
GS_MGMT_GW="10.50.99.1"

# DHCP ranges
GS_L1_DHCP_START="10.50.10.100"
GS_L1_DHCP_END="10.50.10.200"

GS_L2_DHCP_START="10.50.20.100"
GS_L2_DHCP_END="10.50.20.200"

GS_L3_DHCP_START="10.50.30.100"
GS_L3_DHCP_END="10.50.30.200"

GS_MGMT_DHCP_START="10.50.99.100"
GS_MGMT_DHCP_END="10.50.99.200"

# VM names — must match `virsh list --all`
VM_L1_MAINNET="ghostchain-mainnet-l1"
VM_L1_TESTNET="ghostchain-testnet-l1"
VM_L1_VALIDATOR_MAINNET="ghost-mainnet-validator"
VM_L1_VALIDATOR_TESTNET="ghost-testnet-validator"
VM_L1_ARCHIVE="ghost-mainnet-archive-node"

VM_L2_MAINNET="ghostl2-mainnet"
VM_L2_TESTNET="ghostl2-testnet"

VM_L3_MAINNET="ghostl3-mainnet"
VM_L3_TESTNET="ghostl3-testnet"

# JSON-RPC ports inside each VM
RPC_PORT_L1="8545"
RPC_PORT_L2="8545"
RPC_PORT_L3="8545"

# Expose a public L1 RPC on the hypervisor (reverse proxied).
# Keep false unless you've added auth in front of it.
EXPOSE_PUBLIC_L1_RPC="false"
PUBLIC_L1_RPC_LISTEN="0.0.0.0:18545"

# Observability ports (accessible from MGMT subnet only)
PROMETHEUS_PORT="9090"
GRAFANA_PORT="3000"
SUPERVISOR_METRICS_PORT="9108"

# ── Web Frontend VM ──────────────────────────────────────────
# Dedicated VM for the Next.js web app + Traefik TLS termination.
# This VM lives on gs-mgmt (virbr99). Assign a static DHCP lease for
# WEB_VM_IP using: virsh net-update gs-mgmt add ip-dhcp-host ...
VM_WEB="ghost-web"
WEB_VM_IP="10.50.99.10"          # Reserve this via libvirt DHCP before booting
WEB_DOMAIN="ghostchain.cloud"    # Apex domain; all *.ghostchain.cloud route here
WEB_ACME_EMAIL="ops@ghostchain.cloud"

# ── Hypervisor external interface ─────────────────────────────
# Name of the NIC facing the internet (used for DNAT / MASQUERADE).
# Run `ip -br link` on the hypervisor to find the correct name.
GS_EXT_IF="eth0"

# Set true to skip VM start (networks/firewall/observability still configured)
DRY_RUN="false"

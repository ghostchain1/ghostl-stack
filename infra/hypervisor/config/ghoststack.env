# =========================
# GhostStack Hypervisor Env  — PRODUCTION
# /home/ghost/ghostl-stack
# =========================

# ── Repo root path (inside each VM after provisioning) ──────
GHOSTL_STACK_REPO=/opt/ghostl-stack

# ── Libvirt network names ────────────────────────────────────
GS_NET_L1="gs-l1"
GS_NET_L2="gs-l2"
GS_NET_L3="gs-l3"
GS_NET_MGMT="gs-mgmt"

# ── Subnets (non-overlapping RFC1918) ────────────────────────
GS_L1_CIDR="10.50.10.0/24"
GS_L2_CIDR="10.50.20.0/24"
GS_L3_CIDR="10.50.30.0/24"
GS_MGMT_CIDR="10.50.99.0/24"

# ── Bridges ──────────────────────────────────────────────────
GS_BR_L1="virbr10"
GS_BR_L2="virbr20"
GS_BR_L3="virbr30"
GS_BR_MGMT="virbr99"

# ── Gateway IPs ───────────────────────────────────────────────
GS_L1_GW="10.50.10.1"
GS_L2_GW="10.50.20.1"
GS_L3_GW="10.50.30.1"
GS_MGMT_GW="10.50.99.1"

# ── DHCP ranges (dynamic leases 100–200; statics assigned below) ──
GS_L1_DHCP_START="10.50.10.100"
GS_L1_DHCP_END="10.50.10.200"

GS_L2_DHCP_START="10.50.20.100"
GS_L2_DHCP_END="10.50.20.200"

GS_L3_DHCP_START="10.50.30.100"
GS_L3_DHCP_END="10.50.30.200"

GS_MGMT_DHCP_START="10.50.99.100"
GS_MGMT_DHCP_END="10.50.99.200"

# ── VM names  (must match `virsh list --all` exactly) ────────
VM_L1_MAINNET="ghostchain-mainnet-l1"
VM_L1_TESTNET="ghostchain-testnet-l1"
VM_L1_VALIDATOR_MAINNET="ghost-mainnet-validator"
VM_L1_VALIDATOR_TESTNET="ghost-testnet-validator"
VM_L1_ARCHIVE="ghost-mainnet-archive-node"
VM_VHDX_IMPORT="ghostchain-vhdx-import"

VM_L2_MAINNET="ghostl2-mainnet"
VM_L2_TESTNET="ghostl2-testnet"

VM_L3_MAINNET="ghostl3-mainnet"
VM_L3_TESTNET="ghostl3-testnet"

VM_WEB="ghost-web"

# ── Static IPs assigned via virsh net-update (see provision-all-vms.sh) ──
# L1 segment (10.50.10.0/24)
IP_L1_MAINNET="10.50.10.10"
IP_L1_TESTNET="10.50.10.11"
IP_L1_VALIDATOR_MAINNET="10.50.10.12"
IP_L1_VALIDATOR_TESTNET="10.50.10.13"
IP_L1_ARCHIVE="10.50.10.14"
# L2 segment (10.50.20.0/24)
IP_L2_MAINNET="10.50.20.10"
IP_L2_TESTNET="10.50.20.11"
# L3 segment (10.50.30.0/24)
IP_L3_MAINNET="10.50.30.10"
IP_L3_TESTNET="10.50.30.11"
# MGMT segment (10.50.99.0/24)
IP_WEB="10.50.99.10"
IP_VHDX_IMPORT="10.50.99.20"

# ── JSON-RPC ports inside each VM ────────────────────────────
RPC_PORT_L1="8545"
RPC_PORT_L2="8545"
RPC_PORT_L3="8545"

# ── L1 chain IDs ─────────────────────────────────────────────
L1_CHAIN_ID_MAINNET="14000101"
L1_CHAIN_ID_TESTNET="14000102"

# ── OP Stack chain IDs ───────────────────────────────────────
L2_CHAIN_ID_MAINNET="901"
L2_CHAIN_ID_TESTNET="902"
L3_CHAIN_ID_MAINNET="903"
L3_CHAIN_ID_TESTNET="904"

# ── Public L1 RPC (keep false unless auth is in front) ───────
EXPOSE_PUBLIC_L1_RPC="false"
PUBLIC_L1_RPC_LISTEN="0.0.0.0:18545"

# ── Observability ports (MGMT subnet only) ───────────────────
PROMETHEUS_PORT="9090"
GRAFANA_PORT="3000"
SUPERVISOR_METRICS_PORT="9108"

# ── Web Frontend VM ──────────────────────────────────────────
VM_WEB="ghost-web"
WEB_VM_IP="10.50.99.10"
WEB_DOMAIN="ghostchain.cloud"
WEB_ACME_EMAIL="ops@ghostchain.cloud"

# ── Hypervisor external interface ────────────────────────────
# Run `ip -br link` to confirm the correct NIC name.
GS_EXT_IF="eth0"

# ── SSH user inside chain VMs ────────────────────────────────
VM_SSH_USER="ghost"
VM_SSH_KEY="/root/.ssh/id_ed25519"

# ── Production flags ─────────────────────────────────────────
DRY_RUN="false"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GNS Docker Compose environment
# Copy to .env and fill in values before running docker compose up
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── PostgreSQL ────────────────────────────────────────────────────────────────
GNS_POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── L1 RPC (GhostChain L1) ────────────────────────────────────────────────────
L1_RPC_URL=http://10.50.99.21:18545

# ── GNS contract addresses (fill in after deploy) ─────────────────────────────
GNS_REGISTRY_ADDRESS=
GNS_RESOLVER_ADDRESS=
GNS_NAME_WRAPPER_ADDRESS=
GNS_CONSTITUTION_GUARD_ADDRESS=

# ── Internal token (gns-indexer → gns-api) ────────────────────────────────────
# Generate with: openssl rand -hex 24
GNS_INTERNAL_TOKEN=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Docker user (matches host UID/GID for bind-mount ownership) ───────────────
DOCKER_UID=1000
DOCKER_GID=1000

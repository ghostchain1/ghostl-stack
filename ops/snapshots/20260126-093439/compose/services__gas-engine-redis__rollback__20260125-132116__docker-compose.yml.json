{
  "name": "20260125-132116",
  "networks": {
    "ghost_net": {
      "name": "ghost_net",
      "ipam": {},
      "external": true
    }
  },
  "services": {
    "gas-engine-redis": {
      "build": {
        "context": "/home/ghost/ghostl-stack/services/gas-engine-redis/rollback/20260125-132116",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "redis-server",
        "--appendonly",
        "yes"
      ],
      "container_name": "ghost_gas-engine-redis",
      "deploy": {
        "resources": {
          "limits": {
            "cpus": 2,
            "memory": "4294967296"
          },
          "reservations": {
            "cpus": 0.5,
            "memory": "536870912"
          }
        },
        "placement": {}
      },
      "entrypoint": [
        "/bin/bash",
        "/entrypoint.sh"
      ],
      "environment": {
        "HEALTHCHECK_URL": "http://127.0.0.1:6379/"
      },
      "extra_hosts": [
        "host.docker.internal=host-gateway"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/healthcheck.sh"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 10,
        "start_period": "20s"
      },
      "image": "redis:7-alpine",
      "networks": {
        "ghost_net": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 6379,
          "published": "6381",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "stop_grace_period": "30s",
      "volumes": [
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/gas-engine-redis/rollback/20260125-132116/data",
          "target": "/data",
          "bind": {}
        }
      ]
    }
  }
}
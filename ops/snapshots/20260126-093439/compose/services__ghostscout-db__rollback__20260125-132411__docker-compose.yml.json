{
  "name": "20260125-132411",
  "networks": {
    "ghost_net": {
      "name": "ghost_net",
      "ipam": {},
      "external": true
    }
  },
  "services": {
    "ghostscout-db": {
      "build": {
        "context": "/home/ghost/ghostl-stack/services/ghostscout-db/rollback/20260125-132411",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "postgres",
        "-c",
        "max_connections=200"
      ],
      "container_name": "ghost_ghostscout-db",
      "deploy": {
        "resources": {
          "limits": {
            "cpus": 2,
            "memory": "4294967296"
          },
          "reservations": {
            "cpus": 0.5,
            "memory": "536870912"
          }
        },
        "placement": {}
      },
      "entrypoint": [
        "/bin/bash",
        "/entrypoint.sh"
      ],
      "environment": {
        "HEALTHCHECK_CMD": "pg_isready -U ghostscout -d ghostscout_l1",
        "POSTGRES_DB": "ghostscout_l1",
        "POSTGRES_PASSWORD": "ghostpass",
        "POSTGRES_USER": "ghostscout"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/healthcheck.sh"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 10,
        "start_period": "20s"
      },
      "image": "postgres:16-alpine",
      "networks": {
        "ghost_net": null
      },
      "restart": "unless-stopped",
      "stop_grace_period": "30s",
      "volumes": [
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/ghostscout-db/rollback/20260125-132411/data",
          "target": "/var/lib/postgresql/data",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/ghostscout-db/rollback/20260125-132411/data",
          "target": "/docker-entrypoint-initdb.d/create_dbs.sql",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/ghostscout-db/rollback/20260125-132411/data",
          "target": "/data",
          "bind": {}
        }
      ]
    }
  }
}
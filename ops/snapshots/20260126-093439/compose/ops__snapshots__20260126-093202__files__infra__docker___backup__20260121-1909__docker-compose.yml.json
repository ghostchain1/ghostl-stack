        "DATABASE_URL": "postgresql://ghost:ghostpass@postgres:5432/ghost_compliance",
        "NODE_ENV": "production",
        "PREDICT_INTERVAL_SECONDS": "60",
        "REDIS_URL": "redis://redis:6379"
      },
      "networks": {
        "default": null

        "redis": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "ATTESTATION_EXPIRY_SECONDS": "900",
        "ATTESTATION_PRIVATE_KEY": "0x59c6995e998f97a5a0044966f094538e4b1a8d9d0f0b8a8c64d124b5e5d6fcbf",
        "CORS_ORIGIN": "http://localhost:3200",

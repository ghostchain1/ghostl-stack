{
  "name": "ghostchain-compliance",
  "networks": {
    "default": {
      "name": "ghostchain-compliance_default",
      "ipam": {},
      "external": true
    }
  },
  "services": {
    "ghost-compliance": {
      "build": {
        "context": "/home/ghost/ghostl-stack/services/ghost-compliance",
        "dockerfile": "Dockerfile"
      },
      "command": null,
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully",
          "required": true
        },
        "postgres": {
          "condition": "service_healthy",
          "required": true
        },
        "redis": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "ATTESTATION_EXPIRY_SECONDS": "900",
        "ATTESTATION_PRIVATE_KEY": "0x52d0e7f9e60db27179e765f1e02c36bfa6104697bc4defa154e903b4712a651d",
        "CORS_ORIGIN": "http://localhost:3200",
        "DATABASE_URL": "postgresql://ghost:ghostpass@postgres:5432/ghost_compliance",
        "JWT_SECRET": "768057eb4039d5121c591b1b766762b83bbb62a4346795eb684132a29d5d85ee",
        "NODE_ENV": "production",
        "PORT": "8090",
        "REDIS_URL": "redis://redis:6379"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "node -e \"fetch('http://localhost:8090/health').then(r=\u003er.ok?process.exit(0):process.exit(1)).catch(()=\u003eprocess.exit(1))\""
        ],
        "timeout": "3s",
        "interval": "5s",
        "retries": 20
      },
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 8090,
          "published": "8090",
          "protocol": "tcp"
        }
      ]
    },
    "migrate": {
      "command": [
        "sh",
        "-lc",
        "npm install \u0026\u0026 npm run migrate"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy",
          "required": true
        },
        "redis": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "ATTESTATION_EXPIRY_SECONDS": "900",
        "ATTESTATION_PRIVATE_KEY": "0x52d0e7f9e60db27179e765f1e02c36bfa6104697bc4defa154e903b4712a651d",
        "DATABASE_URL": "postgresql://ghost:ghostpass@postgres:5432/ghost_compliance",
        "JWT_SECRET": "768057eb4039d5121c591b1b766762b83bbb62a4346795eb684132a29d5d85ee",
        "REDIS_URL": "redis://redis:6379"
      },
      "image": "node:22-alpine",
      "networks": {
        "default": null
      },
      "restart": "no",
      "volumes": [
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/ghost-compliance",
          "target": "/work",
          "bind": {}
        }
      ],
      "working_dir": "/work"
    },
    "postgres": {
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "ghost_compliance",
        "POSTGRES_PASSWORD": "ghostpass",
        "POSTGRES_USER": "ghost"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U ghost -d ghost_compliance"
        ],
        "timeout": "3s",
        "interval": "5s",
        "retries": 20
      },
      "image": "postgres:16-alpine",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 5432,
          "published": "5432",
          "protocol": "tcp"
        }
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "pg_data",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        }
      ]
    },
    "redis": {
      "command": [
        "redis-server",
        "--appendonly",
        "yes"
      ],
      "entrypoint": null,
      "healthcheck": {
        "test": [
          "CMD",
          "redis-cli",
          "ping"
        ],
        "timeout": "3s",
        "interval": "5s",
        "retries": 20
      },
      "image": "redis:7-alpine",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 6379,
          "published": "6379",
          "protocol": "tcp"
        }
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "redis_data",
          "target": "/data",
          "volume": {}
        }
      ]
    }
  },
  "volumes": {
    "pg_data": {
      "name": "ghostchain-compliance_pg_data"
    },
    "redis_data": {
      "name": "ghostchain-compliance_redis_data"
    }
  }
}
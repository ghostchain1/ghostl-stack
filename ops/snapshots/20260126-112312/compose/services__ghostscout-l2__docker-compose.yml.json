{
  "name": "ghostscout-l2",
  "networks": {
    "ghostchain_ghostchain": {
      "name": "ghostchain_ghostchain",
      "ipam": {},
      "external": true
    },
    "opstack_default": {
      "name": "opstack_default",
      "ipam": {},
      "external": true
    }
  },
  "services": {
    "ghostscout-l2": {
      "build": {
        "context": "/home/ghost/ghostl-stack/services/ghostscout-l2",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "/app/bin/blockscout",
        "start"
      ],
      "container_name": "ghost_ghostscout-l2",
      "deploy": {
        "resources": {
          "limits": {
            "cpus": 2,
            "memory": "4294967296"
          },
          "reservations": {
            "cpus": 0.5,
            "memory": "536870912"
          }
        },
        "placement": {}
      },
      "entrypoint": [
        "/bin/bash",
        "/entrypoint.sh"
      ],
      "environment": {
        "ACCOUNT_POOL_SIZE": "10",
        "BLOCKSCOUT_HOST": "0.0.0.0",
        "CHAIN_ID": "901",
        "COIN": "GHOST",
        "DATABASE_URL": "postgres://ghostscout:ghostpass@ghostscout-postgres:5432/ghostscout_l2",
        "DEPENDENCY_HOSTS": "ghostscout-db:5432 ghostscout-postgres:5432 l2-geth:8545",
        "DEPENDENCY_INTERVAL_SEC": "5",
        "DEPENDENCY_TIMEOUT_SEC": "120",
        "DISABLE_EVISION": "true",
        "ECTO_USE_SSL": "false",
        "ETHEREUM_JSONRPC_HTTP_URL": "http://l2-geth:8545",
        "ETHEREUM_JSONRPC_TRACE_URL": "http://l2-geth:8545",
        "ETHEREUM_JSONRPC_WS_URL": "ws://l2-geth:8546",
        "HEALTHCHECK_CMD": "wget -qO- http://127.0.0.1:4000/api/v2/stats \u003e/dev/null",
        "LOG_LEVEL": "warn",
        "MUD_POOL_SIZE": "10",
        "NETWORK": "GhostL2",
        "POOL_SIZE": "10",
        "POOL_SIZE_API": "10",
        "PORT": "4000",
        "SECRET_KEY_BASE": "1c9f9b0d27d9c76a8c5f4b2e1d0a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a",
        "SUBNETWORK": "L2"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/healthcheck.sh"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 10,
        "start_period": "20s"
      },
      "image": "ghostl/ghostscout-l2:local",
      "networks": {
        "ghostchain_ghostchain": null,
        "opstack_default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 4000,
          "published": "18642",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "stop_grace_period": "30s",
      "volumes": [
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/ghostscout-l2/data",
          "target": "/data",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/ghostscout-l2/entrypoint.sh",
          "target": "/entrypoint.sh",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/ghostscout-l2/healthcheck.sh",
          "target": "/healthcheck.sh",
          "read_only": true,
          "bind": {}
        }
      ]
    }
  }
}
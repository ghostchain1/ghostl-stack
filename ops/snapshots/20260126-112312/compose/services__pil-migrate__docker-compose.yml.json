{
  "name": "pil-migrate",
  "networks": {
    "ghost_net": {
      "name": "ghost_net",
      "ipam": {},
      "external": true
    }
  },
  "services": {
    "pil-migrate": {
      "build": {
        "context": "/home/ghost/ghostl-stack/services/pil-migrate",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "sh",
        "-lc",
        "npm install \u0026\u0026 npm run migrate"
      ],
      "container_name": "ghost_pil-migrate",
      "deploy": {
        "resources": {
          "limits": {
            "cpus": 2,
            "memory": "4294967296"
          },
          "reservations": {
            "cpus": 0.5,
            "memory": "536870912"
          }
        },
        "placement": {}
      },
      "entrypoint": [
        "/bin/bash",
        "/entrypoint.sh"
      ],
      "environment": {
        "DATABASE_URL": "postgresql://ghost:ghostpass@pil-postgres:5432/ghost_pil",
        "DEPENDENCY_HOSTS": "ghost-registry:8088 pil-postgres:5432",
        "DEPENDENCY_INTERVAL_SEC": "5",
        "DEPENDENCY_TIMEOUT_SEC": "120",
        "HEALTHCHECK_CMD": "kill -0 1",
        "PIL_CHAIN_CONFIG_PATH": "/work/config/chains.json",
        "PIL_JURISDICTIONS_PATH": "/work/config/jurisdictions.json",
        "PIL_LEGAL_SIGNALS_PATH": "/work/config/legal-signals.json",
        "PIL_REGISTRY_URL": "http://ghost-registry:8088",
        "PIL_SEED_SAMPLE_DATA": "true"
      },
      "extra_hosts": [
        "host.docker.internal=host-gateway"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/healthcheck.sh"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 10,
        "start_period": "20s"
      },
      "image": "ghostl/pil-migrate:local",
      "networks": {
        "ghost_net": null
      },
      "restart": "no",
      "stop_grace_period": "30s",
      "volumes": [
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/ghost-pil",
          "target": "/work",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/pil-migrate/data",
          "target": "/data",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/pil-migrate/entrypoint.sh",
          "target": "/entrypoint.sh",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/pil-migrate/healthcheck.sh",
          "target": "/healthcheck.sh",
          "read_only": true,
          "bind": {}
        }
      ],
      "working_dir": "/work"
    }
  }
}
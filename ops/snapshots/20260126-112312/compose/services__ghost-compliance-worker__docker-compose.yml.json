{
  "name": "ghost-compliance-worker",
  "networks": {
    "ghostchain-compliance_default": {
      "name": "ghostchain-compliance_default",
      "ipam": {},
      "external": true
    }
  },
  "services": {
    "ghost-compliance-worker": {
      "build": {
        "context": "/home/ghost/ghostl-stack/services/ghost-compliance-worker",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "node",
        "dist/worker.js"
      ],
      "container_name": "ghost_ghost-compliance-worker",
      "deploy": {
        "resources": {
          "limits": {
            "cpus": 2,
            "memory": "4294967296"
          },
          "reservations": {
            "cpus": 0.5,
            "memory": "536870912"
          }
        },
        "placement": {}
      },
      "entrypoint": [
        "/bin/bash",
        "/entrypoint.sh"
      ],
      "environment": {
        "COMPLIANCE_API_URL": "http://ghost-compliance:8090",
        "DATABASE_URL": "postgresql://ghost:ghostpass@postgres:5432/ghost_compliance",
        "DEPENDENCY_HOSTS": "ghost-compliance:8090 postgres:5432 redis:6379",
        "DEPENDENCY_INTERVAL_SEC": "5",
        "DEPENDENCY_TIMEOUT_SEC": "120",
        "HEALTHCHECK_CMD": "kill -0 1",
        "NODE_ENV": "production",
        "PREDICT_INTERVAL_SECONDS": "60",
        "REDIS_URL": "redis://redis:6379"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/healthcheck.sh"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 10,
        "start_period": "20s"
      },
      "image": "ghostl/ghost-compliance-worker:local",
      "networks": {
        "ghostchain-compliance_default": null
      },
      "restart": "unless-stopped",
      "stop_grace_period": "30s",
      "volumes": [
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/ghost-compliance-worker/data",
          "target": "/data",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/ghost-compliance-worker/entrypoint.sh",
          "target": "/entrypoint.sh",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/ghost-compliance-worker/healthcheck.sh",
          "target": "/healthcheck.sh",
          "read_only": true,
          "bind": {}
        }
      ]
    }
  }
}
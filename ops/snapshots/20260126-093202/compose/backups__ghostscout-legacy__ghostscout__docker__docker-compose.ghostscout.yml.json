{
  "name": "docker",
  "networks": {
    "ghostchain": {
      "name": "ghostchain_ghostchain",
      "ipam": {},
      "external": true
    },
    "opstack": {
      "name": "opstack_default",
      "ipam": {},
      "external": true
    }
  },
  "services": {
    "ghostscout-db": {
      "command": [
        "postgres",
        "-c",
        "max_connections=200"
      ],
      "container_name": "ghostscout-postgres",
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "ghostscout_l1",
        "POSTGRES_PASSWORD": "ghostpass",
        "POSTGRES_USER": "ghostscout"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U ghostscout -d ghostscout_l1"
        ],
        "timeout": "3s",
        "interval": "5s",
        "retries": 20
      },
      "image": "postgres:16-alpine",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "networks": {
        "ghostchain": null,
        "opstack": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "volume",
          "source": "ghostscout_db_data",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/backups/ghostscout-legacy/ghostscout/init/create_dbs.sql",
          "target": "/docker-entrypoint-initdb.d/create_dbs.sql",
          "read_only": true,
          "bind": {}
        }
      ]
    },
    "ghostscout-frontend-l1": {
      "command": null,
      "container_name": "ghostscout-frontend-l1",
      "depends_on": {
        "ghostscout-legacy-l1": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "HOST": "0.0.0.0",
        "NEXT_PUBLIC_API_HOST": "ghostscout-legacy-l1:4000",
        "NEXT_PUBLIC_API_PROTOCOL": "http",
        "NEXT_PUBLIC_APP_HOST": "http://localhost:18651",
        "NEXT_PUBLIC_NETWORK_ICON": "https://raw.githubusercontent.com/blockscout/frontend/main/public/favicon.ico",
        "NEXT_PUBLIC_NETWORK_ID": "14000101",
        "NEXT_PUBLIC_NETWORK_NAME": "GhostChain",
        "PORT": "3000"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "for ip in $$(hostname -i); do wget -qO- http://$$ip:3000/ \u003e/dev/null \u0026\u0026 exit 0; done; exit 1"
        ],
        "timeout": "10s",
        "interval": "20s",
        "retries": 10,
        "start_period": "30s"
      },
      "image": "ghcr.io/blockscout/frontend:latest",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "networks": {
        "ghostchain": null,
        "opstack": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 3000,
          "published": "18651",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped"
    },
    "ghostscout-frontend-l2": {
      "command": null,
      "container_name": "ghostscout-frontend-l2",
      "depends_on": {
        "ghostscout-l2": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "HOST": "0.0.0.0",
        "NEXT_PUBLIC_API_HOST": "ghostscout-l2:4000",
        "NEXT_PUBLIC_API_PROTOCOL": "http",
        "NEXT_PUBLIC_APP_HOST": "http://localhost:18652",
        "NEXT_PUBLIC_NETWORK_ICON": "https://raw.githubusercontent.com/blockscout/frontend/main/public/favicon.ico",
        "NEXT_PUBLIC_NETWORK_ID": "901",
        "NEXT_PUBLIC_NETWORK_NAME": "GhostL2",
        "PORT": "3000"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "for ip in $$(hostname -i); do wget -qO- http://$$ip:3000/ \u003e/dev/null \u0026\u0026 exit 0; done; exit 1"
        ],
        "timeout": "10s",
        "interval": "20s",
        "retries": 10,
        "start_period": "30s"
      },
      "image": "ghcr.io/blockscout/frontend:latest",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "networks": {
        "ghostchain": null,
        "opstack": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 3000,
          "published": "18652",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped"
    },
    "ghostscout-frontend-l3": {
      "command": null,
      "container_name": "ghostscout-frontend-l3",
      "depends_on": {
        "ghostscout-legacy-l3": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "HOST": "0.0.0.0",
        "NEXT_PUBLIC_API_HOST": "ghostscout-legacy-l3:4000",
        "NEXT_PUBLIC_API_PROTOCOL": "http",
        "NEXT_PUBLIC_APP_HOST": "http://localhost:18653",
        "NEXT_PUBLIC_NETWORK_ICON": "https://raw.githubusercontent.com/blockscout/frontend/main/public/favicon.ico",
        "NEXT_PUBLIC_NETWORK_ID": "903",
        "NEXT_PUBLIC_NETWORK_NAME": "GhostL3",
        "PORT": "3000"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "for ip in $$(hostname -i); do wget -qO- http://$$ip:3000/ \u003e/dev/null \u0026\u0026 exit 0; done; exit 1"
        ],
        "timeout": "10s",
        "interval": "20s",
        "retries": 10,
        "start_period": "30s"
      },
      "image": "ghcr.io/blockscout/frontend:latest",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "networks": {
        "ghostchain": null,
        "opstack": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 3000,
          "published": "18653",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped"
    },
    "ghostscout-l2": {
      "command": [
        "start"
      ],
      "container_name": "ghostscout-l2",
      "depends_on": {
        "ghostscout-db": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": [
        "/app/bin/blockscout"
      ],
      "environment": {
        "ACCOUNT_POOL_SIZE": "10",
        "BLOCKSCOUT_HOST": "0.0.0.0",
        "CHAIN_ID": "901",
        "COIN": "GL2GAS",
        "DATABASE_URL": "postgres://ghostscout:ghostpass@ghostscout-postgres:5432/ghostscout_l2",
        "DISABLE_EVISION": "true",
        "ECTO_USE_SSL": "false",
        "ETHEREUM_JSONRPC_HTTP_URL": "http://l2-geth:8545",
        "ETHEREUM_JSONRPC_TRACE_URL": "http://l2-geth:8545",
        "ETHEREUM_JSONRPC_WS_URL": "ws://l2-geth:8546",
        "LOG_LEVEL": "warn",
        "MUD_POOL_SIZE": "10",
        "NETWORK": "GhostL2",
        "POOL_SIZE": "10",
        "POOL_SIZE_API": "10",
        "PORT": "4000",
        "SECRET_KEY_BASE": "1c9f9b0d27d9c76a8c5f4b2e1d0a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a",
        "SUBNETWORK": "L2"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:4000/api/v2/stats \u003e/dev/null"
        ],
        "timeout": "10s",
        "interval": "20s",
        "retries": 10,
        "start_period": "40s"
      },
      "image": "blockscout/blockscout:latest",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "networks": {
        "ghostchain": null,
        "opstack": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 4000,
          "published": "18642",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped"
    },
    "ghostscout-legacy-l1": {
      "command": [
        "start"
      ],
      "container_name": "ghostscout-legacy-l1",
      "depends_on": {
        "ghostscout-db": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": [
        "/app/bin/blockscout"
      ],
      "environment": {
        "ACCOUNT_POOL_SIZE": "10",
        "BLOCKSCOUT_HOST": "0.0.0.0",
        "CHAIN_ID": "14000101",
        "COIN": "GHOST",
        "DATABASE_URL": "postgres://ghostscout:ghostpass@ghostscout-postgres:5432/ghostscout_l1",
        "DISABLE_EVISION": "true",
        "ECTO_USE_SSL": "false",
        "ETHEREUM_JSONRPC_HTTP_URL": "http://ghostchain-node1:8545",
        "ETHEREUM_JSONRPC_TRACE_URL": "http://ghostchain-node1:8545",
        "ETHEREUM_JSONRPC_WS_URL": "ws://ghostchain-node1:8546",
        "LOG_LEVEL": "warn",
        "MUD_POOL_SIZE": "10",
        "NETWORK": "GhostChain",
        "POOL_SIZE": "10",
        "POOL_SIZE_API": "10",
        "PORT": "4000",
        "SECRET_KEY_BASE": "6d31c6c2b8b7344f5f3d2421f3d8a42d9d27f9b4a7ad0b287f1aa4f8c6efb6d3",
        "SUBNETWORK": "L1"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:4000/api/v2/stats \u003e/dev/null"
        ],
        "timeout": "10s",
        "interval": "20s",
        "retries": 10,
        "start_period": "40s"
      },
      "image": "blockscout/blockscout:latest",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "networks": {
        "ghostchain": null,
        "opstack": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 4000,
          "published": "18641",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped"
    },
    "ghostscout-legacy-l3": {
      "command": [
        "start"
      ],
      "container_name": "ghostscout-legacy-l3",
      "depends_on": {
        "ghostscout-db": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": [
        "/app/bin/blockscout"
      ],
      "environment": {
        "ACCOUNT_POOL_SIZE": "10",
        "BLOCKSCOUT_HOST": "0.0.0.0",
        "CHAIN_ID": "903",
        "COIN": "GL3GAS",
        "DATABASE_URL": "postgres://ghostscout:ghostpass@ghostscout-postgres:5432/ghostscout_l3",
        "DISABLE_EVISION": "true",
        "ECTO_USE_SSL": "false",
        "ETHEREUM_JSONRPC_HTTP_URL": "http://l3-geth:8545",
        "ETHEREUM_JSONRPC_TRACE_URL": "http://l3-geth:8545",
        "ETHEREUM_JSONRPC_WS_URL": "ws://l3-geth:8546",
        "LOG_LEVEL": "warn",
        "MUD_POOL_SIZE": "10",
        "NETWORK": "GhostL3",
        "POOL_SIZE": "10",
        "POOL_SIZE_API": "10",
        "PORT": "4000",
        "SECRET_KEY_BASE": "7f5d1a3b9e2c6d4f8a1b0c9d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8",
        "SUBNETWORK": "L3"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:4000/api/v2/stats \u003e/dev/null"
        ],
        "timeout": "10s",
        "interval": "20s",
        "retries": 10,
        "start_period": "40s"
      },
      "image": "blockscout/blockscout:latest",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "networks": {
        "ghostchain": null,
        "opstack": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 4000,
          "published": "18643",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped"
    }
  },
  "volumes": {
    "ghostscout_db_data": {
      "name": "docker_ghostscout_db_data"
    }
  },
  "x-logging": {
    "driver": "json-file",
    "options": {
      "max-file": "3",
      "max-size": "10m"
    }
  }
}
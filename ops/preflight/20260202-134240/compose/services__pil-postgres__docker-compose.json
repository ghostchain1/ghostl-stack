{
  "name": "pil-postgres",
  "networks": {
    "ghost_net": {
      "name": "ghost_net",
      "ipam": {},
      "external": true
    }
  },
  "services": {
    "pil-postgres": {
      "build": {
        "context": "/home/ghost/ghostl-stack/services/pil-postgres",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "postgres"
      ],
      "container_name": "ghost_pil-postgres",
      "deploy": {
        "resources": {
          "limits": {
            "cpus": 2,
            "memory": "4294967296"
          },
          "reservations": {
            "cpus": 0.5,
            "memory": "536870912"
          }
        },
        "placement": {}
      },
      "entrypoint": null,
      "environment": {
        "HEALTHCHECK_CMD": "pg_isready -U ghost -d ghost_pil",
        "POSTGRES_DB": "ghost_pil",
        "POSTGRES_PASSWORD": "ghostpass",
        "POSTGRES_USER": "ghost"
      },
      "extra_hosts": [
        "host.docker.internal=host-gateway"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/healthcheck.sh"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 10,
        "start_period": "20s"
      },
      "image": "ghostl/pil-postgres:local",
      "networks": {
        "ghost_net": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 5432,
          "published": "5434",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "stop_grace_period": "30s",
      "volumes": [
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/pil-postgres/data",
          "target": "/var/lib/postgresql/data",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/pil-postgres/data",
          "target": "/data",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/pil-postgres/healthcheck.sh",
          "target": "/healthcheck.sh",
          "read_only": true,
          "bind": {}
        }
      ]
    }
  }
}
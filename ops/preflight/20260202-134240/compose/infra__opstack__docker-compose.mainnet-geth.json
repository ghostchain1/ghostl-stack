{
  "name": "opstack",
  "networks": {
    "default": {
      "name": "opstack_default",
      "ipam": {}
    }
  },
  "services": {
    "l1-mainnet-geth": {
      "cap_drop": [
        "ALL"
      ],
      "cpus": 2,
      "command": [
        "--syncmode",
        "snap",
        "--http",
        "--http.addr=0.0.0.0",
        "--http.port=8545",
        "--http.api=eth,net,web3,txpool",
        "--http.vhosts=*",
        "--http.corsdomain=*",
        "--ws",
        "--ws.addr=0.0.0.0",
        "--ws.port=8546",
        "--ws.api=eth,net,web3",
        "--authrpc.addr=0.0.0.0",
        "--authrpc.port=8551",
        "--authrpc.vhosts=*",
        "--datadir=/data",
        "--cache=4096",
        "--maxpeers=50",
        "--metrics",
        "--metrics.addr=0.0.0.0",
        "--metrics.port=6060"
      ],
      "entrypoint": null,
      "image": "ethereum/client-go:stable",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "8589934592",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 8545,
          "published": "38545",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 8546,
          "published": "38546",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 8551,
          "published": "38551",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 6060,
          "published": "38660",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "user": "0:0",
      "volumes": [
        {
          "type": "volume",
          "source": "l1-mainnet-geth-data",
          "target": "/data",
          "volume": {}
        }
      ]
    }
  },
  "volumes": {
    "l1-mainnet-geth-data": {
      "name": "opstack_l1-mainnet-geth-data"
    }
  },
  "x-logging": {
    "driver": "json-file",
    "options": {
      "max-file": "3",
      "max-size": "10m"
    }
  },
  "x-security": {
    "cap_drop": [
      "ALL"
    ],
    "security_opt": [
      "no-new-privileges:true"
    ]
  }
}
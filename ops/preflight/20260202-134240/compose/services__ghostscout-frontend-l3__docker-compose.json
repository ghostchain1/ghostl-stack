{
  "name": "ghostscout-frontend-l3",
  "networks": {
    "ghostchain_ghostchain": {
      "name": "ghostchain_ghostchain",
      "ipam": {},
      "external": true
    },
    "opstack_default": {
      "name": "opstack_default",
      "ipam": {},
      "external": true
    }
  },
  "services": {
    "ghostscout-frontend-l3": {
      "build": {
        "context": "/home/ghost/ghostl-stack/services/ghostscout-frontend-l3",
        "dockerfile": "Dockerfile"
      },
      "command": null,
      "container_name": "ghost_ghostscout-frontend-l3",
      "deploy": {
        "resources": {
          "limits": {
            "cpus": 2,
            "memory": "4294967296"
          },
          "reservations": {
            "cpus": 0.5,
            "memory": "536870912"
          }
        },
        "placement": {}
      },
      "entrypoint": [
        "/bin/bash",
        "/entrypoint.sh"
      ],
      "environment": {
        "DEPENDENCY_HOSTS": "ghostscout-l3:4000",
        "DEPENDENCY_INTERVAL_SEC": "5",
        "DEPENDENCY_TIMEOUT_SEC": "120",
        "HEALTHCHECK_CMD": "for ip in $$(hostname -i); do wget -qO- http://$$ip:3000/ \u003e/dev/null \u0026\u0026 exit 0; done; exit 1",
        "HOST": "0.0.0.0",
        "NEXT_PUBLIC_API_HOST": "ghostscout-l3:4000",
        "NEXT_PUBLIC_API_PROTOCOL": "http",
        "NEXT_PUBLIC_APP_HOST": "http://localhost:18653",
        "NEXT_PUBLIC_NETWORK_ICON": "https://raw.githubusercontent.com/blockscout/frontend/main/public/favicon.ico",
        "NEXT_PUBLIC_NETWORK_ID": "903",
        "NEXT_PUBLIC_NETWORK_NAME": "GhostL3",
        "PORT": "3000"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/healthcheck.sh"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 10,
        "start_period": "20s"
      },
      "image": "ghostl/ghostscout-frontend-l3:local",
      "networks": {
        "ghostchain_ghostchain": null,
        "opstack_default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 3000,
          "published": "18653",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "stop_grace_period": "30s",
      "volumes": [
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/ghostscout-frontend-l3/data",
          "target": "/data",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/ghostscout-frontend-l3/entrypoint.sh",
          "target": "/entrypoint.sh",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/ghostscout-frontend-l3/healthcheck.sh",
          "target": "/healthcheck.sh",
          "read_only": true,
          "bind": {}
        }
      ]
    }
  }
}
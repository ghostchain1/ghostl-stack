    "alertmanager": {
      "cap_drop": [
        "ALL"
      ],
      "cpus": 0.25,
      "command": [
        "--config.file=/etc/alertmanager/alertmanager.yml",
        "--storage.path=/alertmanager",
        "--cluster.listen-address="
      ],
      "entrypoint": null,
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -qO- http://localhost:9093/api/v2/status \u003e/dev/null"
        ],
        "timeout": "5s",
        "interval": "20s",
        "retries": 6,
        "start_period": "15s"
      },
      "image": "prom/alertmanager@sha256:e13b6ed5cb929eeaee733479dce55e10eb3bc2e9c4586c705a4e8da41e5eacf5",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "268435456",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 9093,
          "published": "9093",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/infra/opstack/observability/alertmanager.yml",
          "target": "/etc/alertmanager/alertmanager.yml",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "volume",
          "source": "alertmanager_data",
          "target": "/alertmanager",
          "volume": {}
        }
      ]
    },

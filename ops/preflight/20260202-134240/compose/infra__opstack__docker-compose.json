    "l2-geth": {
      "cap_drop": [
        "ALL"
      ],
      "cpus": 2,
      "command": [
        "-c",
        "set -e\nif [ ! -d /data/geth ]; then\n  echo \"[l2-geth] initializing genesis...\"\n  geth init --state.scheme=hash --datadir /data /config/genesis-l2.json\nfi\nexec geth \\\n  --http --http.addr=0.0.0.0 --http.api=eth,net,web3,debug,txpool \\\n  --http.vhosts=\"*\" \\\n  --ws --ws.addr=0.0.0.0 --ws.origins=\"*\" \\\n  --authrpc.addr=0.0.0.0 --authrpc.port=8551 --authrpc.vhosts=\"*\" --authrpc.jwtsecret=/config/jwt.txt\\\n  --datadir=/data \\\n  --networkid=901 \\\n  --state.scheme=hash \\\n  --gcmode=archive \\\n  --metrics --metrics.addr=0.0.0.0 --metrics.port=6060 \\\n  --rollup.computependingblock=true \\\n  --rollup.enabletxpooladmission=true \\\n  --rollup.disabletxpoolgossip=false\n"
      ],
      "depends_on": {
        "op-gate": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": [
        "/bin/sh"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "geth attach --datadir /data --exec 'net.version' http://localhost:8545 \u003e/dev/null 2\u003e\u00261"
        ],
        "timeout": "10s",
        "interval": "20s",
        "retries": 6,
        "start_period": "25s"
      },
      "image": "local/op-geth:local",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "4294967296",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 8545,

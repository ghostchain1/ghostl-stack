{
  "name": "ghost-ai-attestor",
  "networks": {
    "ghost_net": {
      "name": "ghost_net",
      "ipam": {},
      "external": true
    }
  },
  "services": {
    "ghost-ai-attestor": {
      "build": {
        "context": "/home/ghost/ghostl-stack/services/ghost-ai-attestor",
        "dockerfile": "Dockerfile"
      },
      "command": null,
      "container_name": "ghost_ai_attestor",
      "entrypoint": [
        "/bin/bash",
        "/entrypoint.sh"
      ],
      "environment": {
        "AI_ATTESTATION_TTL_SECONDS": "3600",
        "AI_LAYER_DEFAULT": "2",
        "AI_MIN_ATTEST_INTERVAL_SECONDS": "15",
        "AI_MODEL_VERSION": "1",
        "AI_NONCE_STORE_PATH": "/data/ai-attestor-nonces.json",
        "PORT": "3310"
      },
      "extra_hosts": [
        "host.docker.internal=host-gateway"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/healthcheck.sh"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 10,
        "start_period": "20s"
      },
      "image": "ghostl/ghost-ai-attestor:local",
      "networks": {
        "ghost_net": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 3310,
          "published": "3310",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "stop_grace_period": "30s",
      "volumes": [
        {
          "type": "volume",
          "source": "ghost_ai_attestor_nonce_store",
          "target": "/data",
          "volume": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/ghost-ai-attestor/entrypoint.sh",
          "target": "/entrypoint.sh",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/ghost-ai-attestor/healthcheck.sh",
          "target": "/healthcheck.sh",
          "read_only": true,
          "bind": {}
        }
      ]
    }
  },
  "volumes": {
    "ghost_ai_attestor_nonce_store": {
      "name": "ghost_ai_attestor_nonce_store"
    }
  }
}
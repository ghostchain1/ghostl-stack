{
  "name": "ghostchain",
  "networks": {
    "ghostchain": {
      "name": "ghostchain_ghostchain",
      "driver": "bridge",
      "ipam": {
        "config": [
          {
            "subnet": "172.28.0.0/16"
          }
        ]
      }
    }
  },
  "services": {
    "ghostchain-bootnode": {
      "cap_drop": [
        "ALL"
      ],
      "cpus": 0.5,
      "command": [
        "/bin/sh",
        "-c",
        "set -e\nif [ ! -f /config/boot.key ]; then\n  echo \"[bootnode] Generating boot.key...\"\n  bootnode -genkey /config/boot.key\nfi\nBOOT_ID=\"$$(bootnode --nodekey /config/boot.key --writeaddress)\"\necho \"enode://$${BOOT_ID}@172.28.0.21:30301\" \u003e /config/bootnode-enode.txt\nexec bootnode --nodekey /config/boot.key --addr :30301\n"
      ],
      "entrypoint": null,
      "environment": {
        "AUTH_JWT_FILE": "/secrets/jwtsecret",
        "BOOTNODE_IP": "172.28.0.21",
        "BOOTNODE_PORT": "30301",
        "CHAIN_ID": "14000101",
        "GETH_IMAGE": "ethereum/client-go:alltools-v1.13.14",
        "L1_AUTHRPC_VHOSTS": "localhost,127.0.0.1",
        "L1_HTTP_APIS": "eth,net,web3,debug,txpool",
        "L1_HTTP_CORS": "http://localhost,http://127.0.0.1",
        "L1_HTTP_VHOSTS": "localhost,127.0.0.1,ghostchain-node1",
        "L1_METRICS_PORT": "18660",
        "L1_P2P_PORT": "18551",
        "L1_RPC_AUTH_PORT": "18552",
        "L1_RPC_AUTH_TOKEN": "",
        "L1_RPC_CORS_ORIGINS": "http://localhost,http://127.0.0.1",
        "L1_RPC_HTTP_PORT": "18545",
        "L1_RPC_PROXY_LOG_REQUESTS": "0",
        "L1_RPC_RATE_LIMIT_ALLOWLIST": "127.0.0.1,::1,172.28.0.1",
        "L1_RPC_RATE_LIMIT_BURST": "40",
        "L1_RPC_RATE_LIMIT_PER_MINUTE": "120",
        "L1_RPC_RATE_WINDOW_MS": "60000",
        "L1_RPC_REQUIRE_AUTH": "0",
        "L1_RPC_SENSITIVE_METHODS": "personal_,debug_,txpool_,admin_",
        "L1_RPC_WS_PORT": "18546",
        "L1_WS_APIS": "eth,net,web3",
        "L1_WS_ORIGINS": "http://localhost,http://127.0.0.1"
      },
      "image": "ethereum/client-go:alltools-v1.13.14",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "268435456",
      "networks": {
        "ghostchain": {
          "ipv4_address": "172.28.0.21"
        }
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 30301,
          "published": "30301",
          "protocol": "udp"
        }
      ],
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "user": "1000:1000",
      "volumes": [
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/infra/ghostchain/data/bootnode",
          "target": "/config",
          "bind": {}
        }
      ]
    },

{
  "name": "ai-vault",
  "networks": {
    "default": {
      "name": "ai-vault_default",
      "ipam": {}
    }
  },
  "services": {
    "ai-vault": {
      "build": {
        "context": "/home/ghost/ghostl-stack/services/ai-vault",
        "dockerfile": "Dockerfile"
      },
      "command": null,
      "container_name": "ghost_ai-vault",
      "entrypoint": null,
      "image": "ghostl/ai-vault:local",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 7710,
          "published": "7710",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped"
    }
  }
}
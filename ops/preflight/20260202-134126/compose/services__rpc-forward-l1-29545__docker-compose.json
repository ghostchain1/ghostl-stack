{
  "name": "rpc-forward-l1-29545",
  "networks": {
    "ghost_net": {
      "name": "ghost_net",
      "ipam": {},
      "external": true
    }
  },
  "services": {
    "rpc-forward-l1-29545": {
      "build": {
        "context": "/home/ghost/ghostl-stack/services/rpc-forward-l1-29545",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "-d",
        "-d",
        "TCP-LISTEN:29545,fork,reuseaddr",
        "TCP:host.docker.internal:18545"
      ],
      "container_name": "ghost_rpc-forward-l1-29545",
      "deploy": {
        "resources": {
          "limits": {
            "cpus": 2,
            "memory": "4294967296"
          },
          "reservations": {
            "cpus": 0.5,
            "memory": "536870912"
          }
        },
        "placement": {}
      },
      "entrypoint": [
        "/bin/bash",
        "/entrypoint.sh"
      ],
      "environment": {
        "HEALTHCHECK_URL": "http://127.0.0.1:29545/"
      },
      "extra_hosts": [
        "host.docker.internal=host-gateway"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/healthcheck.sh"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 10,
        "start_period": "20s"
      },
      "image": "ghostl/rpc-forward-l1-29545:local",
      "networks": {
        "ghost_net": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 29545,
          "published": "29545",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "stop_grace_period": "30s",
      "volumes": [
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/rpc-forward-l1-29545/data",
          "target": "/data",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/rpc-forward-l1-29545/entrypoint.sh",
          "target": "/entrypoint.sh",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/home/ghost/ghostl-stack/services/rpc-forward-l1-29545/healthcheck.sh",
          "target": "/healthcheck.sh",
          "read_only": true,
          "bind": {}
        }
      ]
    }
  }
}
# GhostChain L1 node environment
# Copy to .env and fill in values before running.

# ── Chain ─────────────────────────────────────────────────────────────────────
CHAIN_ID=14000101

# ── Signer (leave blank for RPC-only / read-only nodes) ──────────────────────
SIGNER_ADDRESS=

# ── Networking ────────────────────────────────────────────────────────────────
HTTP_PORT=8545
WS_PORT=8546
AUTH_PORT=8551
P2P_PORT=30303
METRICS_PORT=6060

# ── API exposure ──────────────────────────────────────────────────────────────
HTTP_APIS=eth,net,web3,debug,txpool
WS_APIS=eth,net,web3

# ── CORS / vhosts (comma-separated) ──────────────────────────────────────────
HTTP_CORS=https://rpc.ghostchain.cloud,https://app.ghostchain.cloud,https://ghostchain.cloud,http://localhost
WS_ORIGINS=https://rpc.ghostchain.cloud,https://app.ghostchain.cloud,https://ghostchain.cloud,http://localhost
HTTP_VHOSTS=rpc.ghostchain.cloud,localhost,127.0.0.1

# ── Bootnode ──────────────────────────────────────────────────────────────────
BOOTNODE_ENODE=

# ── Sync / GC ─────────────────────────────────────────────────────────────────
SYNCMODE=full
GCMODE=archive
VERBOSITY=3

# ── Auth RPC (for CL clients — leave blank if PoA only) ──────────────────────
AUTH_JWT_FILE=

# Keep deterministic AI observability modules available for API TypeScript builds.
!observability/
!observability/ai/
!observability/ai/**

# Allow building the Liquidity Gravity Engine router image from repo root context.
!services/liquidity-router
!services/liquidity-router/**
!services/liquidity-prover
!services/liquidity-prover/**

# Allow NPM workspaces to resolve the worker workspace during api/web image builds
# without sending the full worker source in the Docker build context.
!apps/worker/
!apps/worker/package.json

# Allow ghostbrain-core and dependent services to build from repo root context
!services/ghostbrain-core
!services/ghostbrain-core/src
!services/ghostbrain-core/src/**
!services/ghostbrain-core/package.json
!services/ghostbrain-core/tsconfig.json

# Allow stability-mesh services to build from repo root context
!services/ghost-tx-engine
!services/ghost-tx-engine/**
!services/ghost-rpc-aggregator
!services/ghost-rpc-aggregator/**
!services/ghost-memory-guard
!services/ghost-memory-guard/**

# Allow autonomy services with @ghostchain/sdk workspace dep to build from repo root context
!services/network-context-service
!services/network-context-service/**
!services/consensus-telemetry-service
!services/consensus-telemetry-service/**
!services/network-manager-service
!services/network-manager-service/**

# Allow packages/ (workspace packages) for root-context builds
!packages/ghost-sdk-core
!packages/ghost-sdk-core/**
!packages/ghost-sdk
!packages/ghost-sdk/**
!packages/ui
!packages/ui/**


[Unit]
Description=Recover GhostControl Event Watchdog After Healthcheck Failure
After=ghostcontrol-event-watchdog-healthcheck.service

[Service]
Type=oneshot
User=ghost
Group=ghost
WorkingDirectory=/home/ghost/ghostl-stack/tools/ghostcontrol
Environment=GHOSTCONTROL_WATCHDOG_STATUS_PATH=/home/ghost/ghostl-stack/tools/ghostcontrol/evidence/logs/event-watchdog.status.json
Environment=GHOSTCONTROL_WATCHDOG_MAX_STALE_SECONDS=120
Environment=GHOSTCONTROL_WATCHDOG_SERVICE_NAME=ghostcontrol-event-watchdog.service
Environment=GHOSTCONTROL_WATCHDOG_RECOVERY_ARTIFACT_DIR=/home/ghost/ghostl-stack/tools/ghostcontrol/evidence/logs
Environment=GHOSTCONTROL_INCIDENT_DB_PATH=/home/ghost/ghostl-stack/tools/ghostcontrol/incidents/incidents.db
ExecStart=/usr/bin/node --experimental-strip-types /home/ghost/ghostl-stack/tools/ghostcontrol/orchestrator/watchdog_recovery.ts
StandardOutput=append:/home/ghost/ghostl-stack/tools/ghostcontrol/evidence/logs/event-watchdog-recovery.log
StandardError=append:/home/ghost/ghostl-stack/tools/ghostcontrol/evidence/logs/event-watchdog-recovery.log

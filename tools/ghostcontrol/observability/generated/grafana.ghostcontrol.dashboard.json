{
  "uid": "ghostcontrol-main",
  "title": "GhostControl Runtime",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "stat",
      "title": "ghostcontrol-api health",
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=\"ghostcontrol-api\"}",
          "legendFormat": "ghostcontrol-api"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "ghostcontrol-api latency",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"ghostcontrol-api\"}[5m]))",
          "legendFormat": "ghostcontrol-api"
        }
      ]
    },

{
  "$schema": "https://ghostchain.cloud/schemas/sed-engine/forbidden-deps/v1",
  "version": "1.0.0",
  "description": "GhostChain SED-Engine — forbidden npm package list and Ghost sovereign equivalents.",

  "forbidden": [
    "ethers",
    "web3",
    "web3-eth",
    "web3-core",
    "web3-utils",
    "web3-providers-http",
    "web3-providers-ws",
    "@ethersproject/providers",
    "@ethersproject/contracts",
    "@ethersproject/abi",
    "@ethersproject/wallet",
    "@ethersproject/address",
    "@ethersproject/hash",
    "@ethersproject/units",
    "@ethersproject/transactions",
    "@ethersproject/signing-key",
    "@ethersproject/bytes",
    "@ethersproject/bignumber",
    "@ethersproject/keccak256",
    "@ethersproject/logger",
    "@ethersproject/networks",
    "@ethersproject/abstract-provider",
    "@ethersproject/abstract-signer",
    "ethereumjs-util",
    "ethereumjs-tx",
    "ethereumjs-abi",
    "ethereumjs-wallet",
    "ethereumjs-vm",
    "ethereumjs-common",
    "eth-sig-util",
    "eth-block-tracker",
    "eth-json-rpc-middleware",
    "eth-rpc-errors",
    "eth-query",
    "@openzeppelin/contracts"
  ],

  "ghostEquivalents": {
    "ethers":                          "@ghostchain/sdk",
    "web3":                            "@ghostchain/sdk",
    "web3-eth":                        "@ghostchain/sdk",
    "web3-core":                       "@ghostchain/sdk",
    "web3-utils":                      "@ghostchain/sdk",
    "@ethersproject/providers":        "@ghostchain/sdk/provider",
    "@ethersproject/contracts":        "@ghostchain/sdk/contract",
    "@ethersproject/abi":              "@ghostchain/sdk/abi",
    "@ethersproject/wallet":           "@ghostchain/sdk/wallet",
    "@ethersproject/address":          "@ghostchain/sdk/address",
    "@ethersproject/hash":             "@ghostchain/sdk/hash",
    "@ethersproject/units":            "@ghostchain/sdk/units",
    "@ethersproject/transactions":     "@ghostchain/sdk/transaction",
    "@ethersproject/signing-key":      "@ghostchain/sdk/wallet",
    "@ethersproject/bytes":            "@ghostchain/sdk",
    "@ethersproject/bignumber":        "built-in BigInt",
    "@ethersproject/keccak256":        "@ghostchain/sdk",
    "ethereumjs-util":                 "@ghostchain/sdk",
    "ethereumjs-tx":                   "@ghostchain/sdk/transaction",
    "eth-sig-util":                    "@ghostchain/sdk/wallet",
    "@openzeppelin/contracts":         "@ghostchain/contracts"
  },

  "severity": {
    "ethers":                   "CRITICAL",
    "web3":                     "CRITICAL",
    "@ethersproject/providers": "CRITICAL",
    "@ethersproject/contracts": "CRITICAL",
    "@ethersproject/abi":       "HIGH",
    "@openzeppelin/contracts":  "HIGH",
    "ethereumjs-util":          "HIGH",
    "ethereumjs-tx":            "HIGH",
    "eth-sig-util":             "MEDIUM"
  },

  "exemptPaths": [
    "packages/ghost-sdk/src/",
    "packages/ghost-sdk-core/src/",
    "packages/hardhat-ghost/src/",
    "packages/ghost-ai-sdk/src/",
    "packages/ghostwallet/src/",
    "packages/ghost-devkit/src/",
    "packages/ghostchainjs-tx/src/",
    "packages/ghostchainjs-util/src/",
    "packages/sdk/src/",
    "contracts/lib/",
    "node_modules/",
    "dist/",
    ".git/",
    "brand-enforcer-ignore"
  ],

  "note": "Packages in exemptPaths are the canonical Ghost compat/bridge layer and are ALLOWED to import ethers as their implementation engine. ALL other packages must import @ghostchain/sdk instead."
}

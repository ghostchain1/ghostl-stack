{
  "$schema": "https://ghostchain.io/schemas/sed-engine/branding-map/v1",
  "version": "1.0.0",
  "description": "Maps Ethereum code constructs and API surface to Ghost sovereign equivalents for auto-rewrite.",

  "imports": {
    "js": {
      "from \"ethers\"":                     "from \"@ghostchain/sdk\"",
      "from 'ethers'":                       "from '@ghostchain/sdk'",
      "from \"web3\"":                       "from \"@ghostchain/sdk\"",
      "from 'web3'":                         "from '@ghostchain/sdk'",
      "from \"@ethersproject/providers\"":   "from \"@ghostchain/sdk/provider\"",
      "from '@ethersproject/providers'":     "from '@ghostchain/sdk/provider'",
      "from \"@ethersproject/contracts\"":   "from \"@ghostchain/sdk/contract\"",
      "from '@ethersproject/contracts'":     "from '@ghostchain/sdk/contract'",
      "from \"@ethersproject/abi\"":         "from \"@ghostchain/sdk/abi\"",
      "from '@ethersproject/abi'":           "from '@ghostchain/sdk/abi'",
      "from \"@ethersproject/wallet\"":      "from \"@ghostchain/sdk/wallet\"",
      "from '@ethersproject/wallet'":        "from '@ghostchain/sdk/wallet'",
      "from \"@ethersproject/units\"":       "from \"@ghostchain/sdk/units\"",
      "from '@ethersproject/units'":         "from '@ghostchain/sdk/units'",
      "from \"@openzeppelin/contracts":      "from \"@ghostchain/contracts",
      "from '@openzeppelin/contracts":       "from '@ghostchain/contracts",
      "require('ethers')":                   "require('@ghostchain/sdk')",
      "require(\"ethers\")":                 "require(\"@ghostchain/sdk\")",
      "require('web3')":                     "require('@ghostchain/sdk')"
    },
    "solidity": {
      "\"@openzeppelin/contracts/token/ERC20": "\"@ghostchain/contracts/token/GST20",
      "\"@openzeppelin/contracts/token/ERC721": "\"@ghostchain/contracts/token/GST721",
      "\"@openzeppelin/contracts/token/ERC1155": "\"@ghostchain/contracts/token/GST1155",
      "\"@openzeppelin/contracts/token/ERC4626": "\"@ghostchain/contracts/token/GST4626",
      "\"@openzeppelin/contracts": "\"@ghostchain/contracts"
    }
  },

  "ethersApiMap": {
    "ethers.utils.parseEther":          "ghost.parseGst",
    "ethers.utils.formatEther":         "ghost.formatGst",
    "ethers.utils.parseUnits":          "ghost.parseUnits",
    "ethers.utils.formatUnits":         "ghost.formatUnits",
    "ethers.utils.solidityKeccak256":   "ghost.keccak256",
    "ethers.utils.arrayify":            "ghost.toBytes",
    "ethers.utils.hexlify":             "ghost.toHex",
    "ethers.utils.getAddress":          "ghost.getAddress",
    "ethers.utils.isAddress":           "ghost.isAddress",
    "ethers.utils.id":                  "ghost.hashString",
    "ethers.utils.keccak256":           "ghost.keccak256",
    "ethers.utils.defaultAbiCoder":     "ghost.AbiCoder.defaultAbiCoder()",
    "ethers.BigNumber.from":            "BigInt",
    "ethers.constants.AddressZero":     "ghost.ZeroAddress",
    "ethers.constants.MaxUint256":      "ghost.MaxUint256",
    "ethers.constants.Zero":            "0n",
    "ethers.constants.One":             "1n",
    "new ethers.Wallet":                "new GhostWallet",
    "ethers.Wallet.fromMnemonic":       "GhostWallet.fromPhrase",
    "ethers.Wallet.createRandom":       "GhostWallet.createRandom",
    "new ethers.providers.JsonRpcProvider": "new ghostJsonRpcProvider",
    "new ethers.JsonRpcProvider":       "new ghostJsonRpcProvider",
    "new ethers.Contract":              "ghostContractAt",
    "new ethers.Interface":             "new ghost.Interface",
    "new ethers.ContractFactory":       "new ghost.ContractFactory"
  },

  "solidityStandards": {
    "is ERC20":     "is GST20",
    "is IERC20":    "is IGST20",
    "is ERC721":    "is GST721",
    "is IERC721":   "is IGST721",
    "is ERC1155":   "is GST1155",
    "is IERC1155":  "is IGST1155",
    "is ERC4626":   "is GST4626",
    "is ERC2771":   "is GST2771",
    "ERC20 ":       "GST20 ",
    "ERC721 ":      "GST721 ",
    "ERC1155 ":     "GST1155 ",
    "IERC20 ":      "IGST20 ",
    "IERC721 ":     "IGST721 ",
    "IERC1155 ":    "IGST1155 "
  },

  "exemptPatterns": [
    "packages/ghost-sdk/src/",
    "packages/ghost-sdk-core/src/",
    "packages/hardhat-ghost/src/",
    "packages/ghost-ai-sdk/src/",
    "packages/ghostwallet/src/",
    "packages/ghost-devkit/src/",
    "packages/ghostchainjs-tx/src/",
    "packages/ghostchainjs-util/src/",
    "packages/sdk/src/",
    "packages/ghost-nodes/src/",
    "contracts/lib/",
    "node_modules/",
    "dist/",
    "out/",
    "out-codex/",
    "artifacts/",
    "cache/",
    "cache-codex/",
    ".git/",
    "brand-enforcer-ignore"
  ]
}

# GhostBrain Runtime Container
# Node.js 22 LTS — matches ghostl-stack workspace constraint (>=22.21.0 <23)
FROM node:22-alpine AS base

LABEL org.opencontainers.image.title="ghostbrain-runtime"
LABEL org.opencontainers.image.description="GhostBrain Core AI runtime — TypeScript inference engine"
LABEL org.opencontainers.image.vendor="GhostChain"

# ── Build stage ────────────────────────────────────────────────────────────
FROM base AS builder

WORKDIR /build

# Copy package manifests first (layer-cache friendly)
COPY package*.json tsconfig*.json ./
COPY runtime/       runtime/
COPY integration/   integration/
COPY security/encryption/ security/encryption/

# Install all deps (including devDeps for tsc)
RUN npm ci --ignore-scripts

# Compile TypeScript
RUN npx tsc --project tsconfig.json --outDir dist

# ── Production stage ───────────────────────────────────────────────────────
FROM base AS runtime

# Security hardening: non-root user
RUN addgroup -S ghostbrain && adduser -S ghostbrain -G ghostbrain

WORKDIR /app

# Copy compiled output
COPY --from=builder /build/dist ./dist
COPY --from=builder /build/package*.json ./

# Install only production dependencies
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

# Required directories
RUN mkdir -p /var/log/ghostbrain && chown -R ghostbrain:ghostbrain /var/log/ghostbrain /app

USER ghostbrain

# ── Ports ──────────────────────────────────────────────────────────────────
# 7900: GhostBrain API (inference, classify, health)
# 7901: Management sideband (health monitor HTTP, firmware check)
EXPOSE 7900 7901

# ── Health check ───────────────────────────────────────────────────────────
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:7900/health || exit 1

# ── Environment defaults ───────────────────────────────────────────────────
ENV NODE_ENV=production \
    GHOSTCHAIN_L1_RPC=http://ghostchain-l1:18545 \
    GHOSTL2_RPC=http://ghostl2:29545 \
    GHOSTL3_RPC=http://ghostl3:39545 \
    GHOSTBRAIN_URL=http://localhost:7900 \
    GHOSTSCAN_INDEXER_URL=http://ghostscan:8545 \
    GHOSTBRAIN_LOG_DIR=/var/log/ghostbrain \
    NODE_OPTIONS=--max_old_space_size=4096

ENTRYPOINT ["node", "dist/runtime/inference_server.js"]

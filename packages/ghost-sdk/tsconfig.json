{
  "compilerOptions": {
    "target":            "ES2022",
    "module":            "commonjs",
    "lib":               ["ES2022"],
    "types":             ["node"],
    "rootDir":           "./src",
    "outDir":            "./dist",
    "declaration":       true,
    "strict":            true,
    "esModuleInterop":   true,
    "skipLibCheck":      true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

{
  "uid": "ghost-observability-logs",
  "title": "Ghost Observability Logs",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Log Event Rate by Severity",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (severity) (rate(ghost_observability_log_events_total[5m]))",
          "legendFormat": "{{severity}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "table",
      "title": "Top Components by Errors (15m)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "topk(10, sum by (component) (increase(ghost_observability_log_events_total{severity=~\"ERROR|CRITICAL|SLASHING_RISK|SECURITY_EVENT\"}[15m])))",
          "legendFormat": "{{component}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "logs",
      "title": "Loki Logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "{job!=\"\"}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 }
    }
  ],
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": { "refresh_intervals": ["10s", "30s", "1m", "5m", "15m"] }
}
